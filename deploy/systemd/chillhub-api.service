[Unit]
Description=ChillHub Public API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=CONTENT_ROOT=/var/www/launcher
ExecStart=/opt/chillhub/api
Restart=on-failure
RestartSec=3
# Increase file limits for many concurrent downloads
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
