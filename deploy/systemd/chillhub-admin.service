[Unit]
Description=Chill Hub Admin API & UI backend
After=network-online.target
Wants=network-online.target

[Service]
# ADMIN_CORS_ORIGIN — какие Origin допускаются к admin API.
# По умолчанию CORS ОТКЛЮЧЁН: админка отдаётся тем же nginx с того же origin,
# а лаунчер ходит из WPF (HttpClient), где CORS неприменим. Задавайте значение,
# только если появится сторонний браузерный потребитель API:
#   Environment="ADMIN_CORS_ORIGIN=https://example.com"
# Допускается список через запятую; "*" открывает API всему миру — не используйте
# его вместе с cookie-авторизацией.
Type=simple
User=www-data
Group=www-data
Environment=CONTENT_ROOT=/var/www/launcher
# Auth configuration (set real secrets in environment)
# Example: generate bcrypt hash with: htpasswd -nbBC 12 admin 'YourPassword' | cut -d: -f2
Environment=COOKIE_DOMAIN=launcher.samoy.love
#Environment=COOKIE_SECURE=true
#Environment=JWT_SECRET=change_me_to_long_random
#Environment=ADMIN_USERNAME=admin
#Environment=ADMIN_PASSWORD_BCRYPT=$2y$12$examplehash...
# Путь — каталог релиза deploy-kit: ROOT=/opt/chillhub-admin, симлинк current
# указывает на выкаченный релиз, имя бинаря задано BUILD_CMD (.deploy-kit/admin.env).
# Раньше здесь стоял /opt/chillhub/admin — раскладка удалённого скрипта выкатки,
# которую не создаёт никто.
ExecStart=/opt/chillhub-admin/current/chillhub-admin
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# --- Изоляция ---
# Админка принимает загрузку сборок и распаковывает архивы — то есть обрабатывает
# недоверенный ввод и пишет на диск. Ей песочница нужна даже больше, чем
# публичному API.
#
# ProtectSystem=strict делает всё только для чтения; запись разрешена ровно в
# каталог контента, куда складываются сборки, манифесты, новости и метрики.
# Создаваемые файлы не должны быть доступны на чтение всему миру.
# nginx работает под тем же www-data, поэтому раздача не страдает.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/www/launcher
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# Go не генерирует код на лету, поэтому запрет W+X-страниц безопасен.
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
