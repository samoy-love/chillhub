# Цель: публичный API лаунчера (chillhub-api).

APP=chillhub-api
ROOT=/opt/chillhub-api
ARTIFACT_DIR=stage-api
UNIT=chillhub-api.service
OWNER=root:www-data
GOARCH=arm64

# Кавычки ОДИНАРНЫЕ: подстановка должна случиться при сборке, а не при чтении
# этого файла.
BUILD_CMD='rm -rf stage-api && mkdir -p stage-api && cd server && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=${DEPLOY_VERSION:-dev}" -o ../stage-api/chillhub-api ./cmd/api && cd ..'

HEALTH=https://launcher.samoy.love/manifests/launcher/latest.json

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,status.samoy.love

KEEP=5
WRITE_VERSION_FILE=0

# О релизах объявляет БОТ samoy-status, а не CI: агент опрашивает сервисы и сам
# замечает смену версии. Голос должен остаться один — уведомляй ещё и пайплайн,
# на каждую выкатку приходило бы по два сообщения. Отсюда `never`; TELEGRAM_* в
# этом репозитории нет и заводить их не надо.
NOTIFY=never

# Манифесты, контент и новости лежат в /var/www/launcher и редактируются через
# админку. Выкатка их НЕ касается: они не входят в артефакт, а каталог релиза
# отдельный. Синхронизация с --delete стёрла бы всё опубликованное.

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки. BUILD_CMD выше для
# этого не годится: в нём GOOS=linux GOARCH=arm64, и локально он собирает
# бинарь под сервер, который на машине разработчика не запустится.
RUN_DIR=server
RUN_CMD="go run ./cmd/api"
RUN_PORT=55700

# /api/games отвечает без авторизации и читает контент — то есть проверяет
# заодно, что CONTENT_ROOT указан верно. Пустой ответ 200 честнее, чем 200 от
# сервиса, который не нашёл ни одного манифеста.
RUN_HEALTH=/api/games

# CONTENT_ROOT ведёт в ОСНОВНОЕ дерево (%MAIN%), а не в текущее (%DIR%).
#
# Контент — общее состояние, а не часть кода: в git лежат только три .gitkeep,
# а манифесты, новости и сборки живут на диске рядом. Прод устроен так же —
# /var/www/launcher вне каталога релиза, и выкатка его не касается (см.
# комментарий выше). Указывать сюда %DIR% означало бы, что запуск с другой
# ветки видит пустой каталог и API отдаёт «игр нет».
#
# API_LISTEN_ADDR прибит к петле явно: дефолт кода такой же, но локальный
# запуск не должен зависеть от того, не поменяется ли он однажды на ":порт".
RUN_ENV="API_LISTEN_ADDR=127.0.0.1:%PORT%;CONTENT_ROOT=%MAIN%/content"
