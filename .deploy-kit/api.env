# Цель: публичный API лаунчера (chillhub-api).

APP=chillhub-api
ROOT=/opt/chillhub-api
ARTIFACT_DIR=stage-api
UNIT=chillhub-api.service
OWNER=root:www-data
GOARCH=arm64

# Кавычки ОДИНАРНЫЕ: подстановка должна случиться при сборке, а не при чтении
# этого файла.
BUILD_CMD='rm -rf stage-api && mkdir -p stage-api && cd server && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=${DEPLOY_VERSION:-dev}" -o ../stage-api/chillhub-api ./cmd/api && cd ..'

# Адрес обслуживает САМА служба (nginx проксирует /api/ на 127.0.0.1:55700).
# Раньше здесь стоял /manifests/launcher/latest.json — статический файл, который
# nginx отдаёт alias'ом со своего диска. Он возвращал 200 и при мёртвой службе,
# так что health-проверка выкатки не могла провалиться никогда, а вместе с ней
# не мог сработать и автооткат. Тот же адрес стоит ниже в VERSION_URL, то есть
# заведомо отвечает: по нему после каждой выкатки проходит сверка версии.
HEALTH=https://launcher.samoy.love/api/version.json

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,die.samoy.love,status.samoy.love

KEEP=5

# version.json пишется в корень артефакта и уезжает в каталог релиза, а сервис
# отдаёт его сам по /api/version.json (см. cmd/api, handleVersion). По нему
# выкатка сверяет «выкатилось» с «выглядит выкаченным» и считает список
# изменений от того, что РЕАЛЬНО стоит на проде. Раньше здесь стояло
# WRITE_VERSION_FILE=0: бинарю некуда было раздавать файл, цель молчала, и
# каждая выкатка предупреждала, что коммиты отменённых очередью прогонов в
# ленту не попадут.
WRITE_VERSION_FILE=1
VERSION_URL=https://launcher.samoy.love/api/version.json

# О релизе рассказывает сама выкатка, событием и в тот же момент. Прежнее
# молчание держалось на опросе: агент обходил /version.json и узнавал о релизе
# по разнице двух снимков — а разница не знает ни про три выкатки за минуту, ни
# про выкатку с откатом, ни про провал, при котором версия просто осталась
# прежней. Событие знает про всё это, потому что рождается там же, где решается
# исход выкатки. Отсюда `all`.
#
# Дублей это не создаёт: голос в чате по-прежнему один. Событие уезжает БОТУ
# status.samoy.love, а не в Telegram напрямую, — форматирует и отправляет его
# тот же единственный отправитель. Поэтому TELEGRAM_* в этом репозитории нет и заводить
# их не надо.
NOTIFY=all

# Манифесты, контент и новости лежат в /var/www/launcher и редактируются через
# админку. Выкатка их НЕ касается: они не входят в артефакт, а каталог релиза
# отдельный. Синхронизация с --delete стёрла бы всё опубликованное.

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки. BUILD_CMD выше для
# этого не годится: в нём GOOS=linux GOARCH=arm64, и локально он собирает
# бинарь под сервер, который на машине разработчика не запустится.
RUN_DIR=server
RUN_CMD="go run ./cmd/api"
RUN_PORT=55700

# /api/games отвечает без авторизации и читает контент — то есть проверяет
# заодно, что CONTENT_ROOT указан верно. Пустой ответ 200 честнее, чем 200 от
# сервиса, который не нашёл ни одного манифеста.
RUN_HEALTH=/api/games

# CONTENT_ROOT ведёт в ОСНОВНОЕ дерево (%MAIN%), а не в текущее (%DIR%).
#
# Контент — общее состояние, а не часть кода: в git лежат только три .gitkeep,
# а манифесты, новости и сборки живут на диске рядом. Прод устроен так же —
# /var/www/launcher вне каталога релиза, и выкатка его не касается (см.
# комментарий выше). Указывать сюда %DIR% означало бы, что запуск с другой
# ветки видит пустой каталог и API отдаёт «игр нет».
#
# API_LISTEN_ADDR прибит к петле явно: дефолт кода такой же, но локальный
# запуск не должен зависеть от того, не поменяется ли он однажды на ":порт".
RUN_ENV="API_LISTEN_ADDR=127.0.0.1:%PORT%;CONTENT_ROOT=%MAIN%/content"
