# Один контракт для dk deploy и переиспользуемого desktop-artifact workflow.
APP=chillhub-installer
TITLE='Chill Hub · Установщик'

# Полные тесты — в PR. Релиз повторяет сборку и проверяет точный состав пакета.
# Скрипт сверяет DEPLOY_VERSION с Cargo.toml до сборки и не публикует файлы сам.
BUILD_CMD="pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/native-release.ps1"
ARTIFACT_FILE=scripts/generated_downloads/ChillHub-Setup.exe
VERSION_CMD="sed -n 's/^version = \"\([^\"]*\)\"/\1/p' launcher/ChillHub.Native/Cargo.toml | head -1"

PUBLISH_DEST=/var/www/site-downloads/ChillHub-Setup.exe
VERIFY_URL=https://launcher.samoy.love/downloads/ChillHub-Setup.exe.sha256

# deploy-kit загружает ZIP в админ-API; latest переключается отдельно.
SELFUPDATE_URL=https://launcher.samoy.love/admin/api
SELFUPDATE_ZIP=scripts/generated_downloads/ChillHub-launcher-payload.zip
HEALTH=https://launcher.samoy.love/#download
NOTIFY=all
CHANGELOG_PATHS='launcher/ChillHub.Native scripts/native-*.ps1 scripts/ensure-webview2-bootstrapper.ps1 scripts/installer.nsi scripts/app.ico scripts/ci/ensure-nsis.ps1 scripts/ci/ensure-native-rust.ps1'
