# Цель-файл: установщик ChillHub на сайте (/downloads/ChillHub-Setup.exe).
#
# Это описание читают ОБА пути выкатки — правка здесь меняет оба разом:
#
#   * пайплайн: job installer в deploy.yml зовёт desktop-artifact.yml с
#     config на этот файл;
#   * локально: dk deploy chillhub-installer (или dk deploy без аргументов
#     из этого репозитория) — режим PUBLISH_DEST в bin/deploy.
#
# Публикует обоим путям publish-file.sh на сервере: атомарная подмена файла,
# прежний остаётся жёсткой ссылкой .prev для мгновенного отката. Каталог живёт
# ВНЕ релизов сайта — см. location /downloads/ в конфиге nginx
# (deploy-kit/nginx/sites/chillhub-launcher.conf) и комментарий в site.env.
APP=chillhub-installer

# Bash-строка на обоих путях, PowerShell зовётся явно. ensure-nsis.ps1 —
# первой командой: образ windows-latest НЕ несёт NSIS, а локально скрипт
# просто найдёт установленный (без прав администратора choco не поставит —
# и честно скажет об этом).
#
# Версия приходит переменной DEPLOY_VERSION от вызывающего (тег в CI, иначе
# VERSION_CMD ниже) и сверяется сборкой с <Version> в csproj: расхождение —
# отказ, см. Resolve-AppVersion в scripts/build-installer.ps1.
BUILD_CMD="pwsh -NoProfile -ExecutionPolicy Bypass -Command './scripts/ci/ensure-nsis.ps1; ./scripts/build-installer.ps1 -Configuration Release -AppVersion \$env:DEPLOY_VERSION'"
ARTIFACT_FILE=scripts/generated_downloads/ChillHub-Setup.exe

# Версию объявляет сам репозиторий: <Version> из csproj — ровно тот источник,
# с которым build-installer.ps1 сверяет -AppVersion. Публиковать установщик
# с заглушкой вместо версии нельзя: она уехала бы в launcher.version каждому
# скачавшему.
VERSION_CMD="sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' launcher/ChillHub/ChillHub.csproj | head -1"

# Куда смотрит кнопка «Скачать для Windows» на лендинге.
PUBLISH_DEST=/var/www/site-downloads/ChillHub-Setup.exe

# Сверка после публикации: прод обязан раздавать ровно ту сумму, которую
# посчитала сборка, — «зелёный деплой со старыми файлами» ловится здесь.
VERIFY_URL=https://launcher.samoy.love/downloads/ChillHub-Setup.exe.sha256

# Ссылка «открыть» в уведомлении и проба для `dk`: раздел скачивания лендинга.
HEALTH=https://launcher.samoy.love/#download
NOTIFY=all
