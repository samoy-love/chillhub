# Цель: лендинг launcher.samoy.love.

APP=chillhub-site
BUILD_CMD="rm -rf stage-site && cp -r landing stage-site"
ARTIFACT_DIR=stage-site

ROOT=/var/www/site
OWNER=ubuntu:ubuntu

NGINX_RELOAD=1

# Конфиг nginx описывается ПАРОЙ: NGINX_CONF — что ставить, NGINX_DEST — куда.
# Пайплайн выполняет три шага с nginx (взять конфиг, проверить его nginx-ом в
# докере, применить на хосте через nginx-apply.sh) только если заданы ОБА.
# Здесь стоял один NGINX_DEST — и все три шага молча пропускались: выкатка
# оставалась зелёной, а chillhub-launcher.conf не вёз на сервер никто. Правка
# конфига в deploy-kit не меняла на проде ничего и не имела способа об этом
# сообщить. Половина пары — это не «настроено частично», это выключенный шаг.
#
# Путь считается от корня deploy-kit: конфигурация nginx живёт только там
# (CLAUDE.md, раздел nginx), и пайплайн качает файл оттуда же, откуда берёт
# проверяющий его ci/nginx-check.sh — из deploy-kit@main. Копии конфига в этом
# репозитории нет и заводить её не надо.
#
# Пара стоит именно у цели site, а не у admin-ui, хотя статикой раздаются обе:
#   * chillhub-launcher.conf описывает весь server_name launcher.samoy.love,
#     и его корень — /var/www/site/current, то есть ROOT этой цели. Морда
#     админки — поддерево /admin/ui/ внутри того же конфига, а не свой сайт;
#   * site едет ПЕРВОЙ в цепочке site → api → admin → admin-ui: конфиг должен
#     лежать на месте до того, как поднимутся сервисы, которые он проксирует;
#   * у файла обязан быть ровно один владелец. Две цели, везущие один и тот же
#     /etc/nginx/sites-available/chillhub-launcher.conf, гонялись бы за него на
#     каждой выкатке и делали бы по два nginx-apply вместо одного.
# api и admin не могут получить пару в принципе: они едут go-service.yml, а в
# нём поддержки nginx нет вообще.
NGINX_CONF=nginx/sites/chillhub-launcher.conf
NGINX_DEST=/etc/nginx/sites-available/chillhub-launcher.conf

HEALTH=https://launcher.samoy.love/
VERSION_URL=https://launcher.samoy.love/version.json

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,status.samoy.love

KEEP=5

# О релизах объявляет БОТ samoy-status, а не CI: агент раз в минуту опрашивает
# /version.json каждого сервиса, видит смену версии и пишет в чат. Голос один и
# должен таким остаться — если бы уведомлял ещё и пайплайн, на каждую выкатку
# приходило бы по два сообщения. Поэтому здесь `never`, а TELEGRAM_* в этом
# репозитории нет и заводить их не надо.
NOTIFY=never

# Установщик лежит в /var/www/site-downloads — ВНЕ каталога релизов. Файл на
# 253 МБ незачем копировать в каждую выкатку, и подмена сайта не должна его
# сносить. Публикуется отдельно, целью installer.
#
# Проверочные токены Let's Encrypt тоже вне релизов: certbot пишет в
# /var/www/site, и в конфиге ACME-location сознательно указывает туда, а не
# на current — иначе продление сертификата сломается ровно тогда, когда
# понадобится.
