# Цель: лендинг launcher.samoy.love.

APP=chillhub-site
BUILD_CMD="rm -rf stage-site && cp -r landing stage-site"
ARTIFACT_DIR=stage-site

ROOT=/var/www/site
OWNER=ubuntu:ubuntu

NGINX_RELOAD=1

# Конфиг nginx описывается ПАРОЙ: NGINX_CONF — что ставить, NGINX_DEST — куда.
# Пайплайн выполняет три шага с nginx (взять конфиг, проверить его nginx-ом в
# докере, применить на хосте через nginx-apply.sh) только если заданы ОБА.
# Здесь стоял один NGINX_DEST — и все три шага молча пропускались: выкатка
# оставалась зелёной, а chillhub-launcher.conf не вёз на сервер никто. Правка
# конфига в deploy-kit не меняла на проде ничего и не имела способа об этом
# сообщить. Половина пары — это не «настроено частично», это выключенный шаг.
#
# Путь считается от корня deploy-kit: конфигурация nginx живёт только там
# (CLAUDE.md, раздел nginx), и пайплайн качает файл оттуда же, откуда берёт
# проверяющий его ci/nginx-check.sh — из deploy-kit@main. Копии конфига в этом
# репозитории нет и заводить её не надо.
#
# Пара стоит именно у цели site, а не у admin-ui, хотя статикой раздаются обе:
#   * chillhub-launcher.conf описывает весь server_name launcher.samoy.love,
#     и его корень — /var/www/site/current, то есть ROOT этой цели. Морда
#     админки — поддерево /admin/ui/ внутри того же конфига, а не свой сайт;
#   * site едет ПЕРВОЙ в цепочке site → api → admin → admin-ui: конфиг должен
#     лежать на месте до того, как поднимутся сервисы, которые он проксирует;
#   * у файла обязан быть ровно один владелец. Две цели, везущие один и тот же
#     /etc/nginx/sites-available/chillhub-launcher.conf, гонялись бы за него на
#     каждой выкатке и делали бы по два nginx-apply вместо одного.
# api и admin не могут получить пару в принципе: они едут go-service.yml, а в
# нём поддержки nginx нет вообще.
NGINX_CONF=nginx/sites/chillhub-launcher.conf
NGINX_DEST=/etc/nginx/sites-available/chillhub-launcher.conf

HEALTH=https://launcher.samoy.love/
VERSION_URL=https://launcher.samoy.love/version.json

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,die.samoy.love,status.samoy.love

KEEP=5

# О релизе рассказывает сама выкатка, событием и в тот же момент. Прежнее
# молчание держалось на опросе: агент раз в минуту обходил VERSION_URL выше и
# узнавал о релизе по разнице двух соседних снимков — а разница не знает ни про
# три выкатки за минуту, ни про выкатку с откатом, ни про провал, при котором
# версия просто осталась прежней. Событие знает про всё это, потому что
# рождается там же, где решается исход выкатки. Отсюда `all`.
#
# Дублей это не создаёт: голос в чате по-прежнему один. Событие уезжает БОТУ
# status.samoy.love, а не в Telegram напрямую, — форматирует и отправляет его
# тот же единственный отправитель. Поэтому TELEGRAM_* в этом репозитории нет и заводить
# их не надо. Сам опрос остаётся, но уже как проверка: версия на проде, о
# которой не было события, — аномалия, а не молчаливо принятый релиз.
NOTIFY=all

# ЧТО ВЕЗЁТ ЭТА ЦЕЛЬ — для списка изменений.
#
# Репозиторий один, целей шесть, а список изменений считался по всей его
# истории: 22.08 карточка chillhub-site перечислила восемь PR при одном
# настоящем изменении — сайт не выкатывался с 16.08, и диапазон «прод → HEAD»
# накрыл шесть дней чужой работы. В списке сайта оказались правки лаунчера и
# фавиконка админки.
#
# Пути те же, по которым задача changes в deploy.yml решает, катить ли эту
# цель: один ответ на вопрос «что относится к цели» на оба применения.
CHANGELOG_PATHS='landing .htmlhintrc .stylelintrc.json .stylelintignore'

# Установщик лежит в /var/www/site-downloads — ВНЕ каталога релизов. Файл на
# 253 МБ незачем копировать в каждую выкатку, и подмена сайта не должна его
# сносить. Публикуется отдельно, целью installer.
#
# Проверочные токены Let's Encrypt тоже вне релизов: certbot пишет в
# /var/www/site, и в конфиге ACME-location сознательно указывает туда, а не
# на current — иначе продление сертификата сломается ровно тогда, когда
# понадобится.

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки.
#
# Сборки у лендинга нет: BUILD_CMD выше — это `cp -r landing`, то есть на
# сервер уезжают ровно те файлы, что лежат в репозитории. Значит нет и
# `npm run dev`, за который можно было бы зацепиться, — раздаём каталог
# статическим сервером из deploy-kit (lib/static-server.mjs, там же написано,
# почему не `npx serve`).
RUN_DIR=landing
# Путь в кавычках: в нём есть пробел, а команду выполняет шелл.
RUN_CMD='node "%KIT%/lib/static-server.mjs" %PORT% .'

# 55780 — рядом с фермой (API 55700, админка 55777), а не в диапазоне сайтов:
# лендинг лаунчера открывают вместе с ними, и держать всю ферму на соседних
# номерах проще, чем помнить, что один её кусок уехал к Astro-страницам.
RUN_PORT=55780

# Абсолютные ссылки на launcher.samoy.love в разметке остаются прод-адресами и
# локально не подменяются: это canonical, og:url и sitemap — они ОБЯЗАНЫ
# указывать на прод, иначе первый же выкаченный лендинг расскажет поисковику,
# что сайт живёт на localhost. Отличается локально только то, откуда берутся
# сами файлы.
