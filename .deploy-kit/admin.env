# Цель: сервер админки лаунчера (chillhub-admin).

APP=chillhub-admin
ROOT=/opt/chillhub-admin
ARTIFACT_DIR=stage-admin
UNIT=chillhub-admin.service
OWNER=root:www-data
GOARCH=arm64

BUILD_CMD='rm -rf stage-admin && mkdir -p stage-admin && cd server && GOOS=linux GOARCH=${DEPLOY_GOARCH:-arm64} CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.Version=${DEPLOY_VERSION:-dev}" -o ../stage-admin/chillhub-admin ./cmd/admin && cd ..'

# /admin/api/health отвечает без авторизации — именно для проверок.
HEALTH=https://launcher.samoy.love/admin/api/health

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,die.samoy.love,status.samoy.love

KEEP=5
WRITE_VERSION_FILE=0

# О релизе рассказывает сама выкатка, событием и в тот же момент. Прежнее
# молчание держалось на опросе: агент обходил /version.json и узнавал о релизе
# по разнице двух снимков — а разница не знает ни про три выкатки за минуту, ни
# про выкатку с откатом, ни про провал, при котором версия просто осталась
# прежней. Событие знает про всё это, потому что рождается там же, где решается
# исход выкатки. Отсюда `all`.
#
# Дублей это не создаёт: голос в чате по-прежнему один. Событие уезжает БОТУ
# status.samoy.love, а не в Telegram напрямую, — форматирует и отправляет его
# тот же единственный отправитель. Поэтому TELEGRAM_* в этом репозитории нет и заводить
# их не надо.
NOTIFY=all

# ЧТО ВЕЗЁТ ЭТА ЦЕЛЬ — для списка изменений.
#
# Репозиторий один, целей шесть, а список изменений считался по всей его
# истории: 22.08 карточка chillhub-site перечислила восемь PR при одном
# настоящем изменении — сайт не выкатывался с 16.08, и диапазон «прод → HEAD»
# накрыл шесть дней чужой работы. В списке сайта оказались правки лаунчера и
# фавиконка админки.
#
# Пути те же, по которым задача changes в deploy.yml решает, катить ли эту
# цель: один ответ на вопрос «что относится к цели» на оба применения.
CHANGELOG_PATHS='server/cmd/admin server/internal server/go.mod server/go.sum'

# Пароль админки хранится хешем в systemd drop-in и задаётся отдельно от
# выкатки: он меняется редко, а класть его в каждый деплой — лишний повод
# провезти секрет через ещё один шаг.

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки.
RUN_DIR=server
RUN_CMD="go run ./cmd/admin"
RUN_PORT=55777
RUN_HEALTH=/admin/api/health

# CONTENT_ROOT — тот же каталог, что у chillhub-api, и по той же причине: это
# общее состояние вне git. Админка в него пишет, API из него читает; разъедься
# они — опубликованное через админку не появилось бы в выдаче.
#
# COOKIE_SECURE=false и отсутствие COOKIE_DOMAIN — условие того, что в
# админку вообще можно войти по http://localhost: Secure-кука по нешифрованному
# соединению не сохраняется, а кука, выписанная на launcher.samoy.love, к
# localhost не относится. Проявляется это как «логин принят, но каждая
# следующая страница снова просит войти».
#
# ADMIN_ALLOW_PLAIN_PASSWORD=1 — единственный способ отдать пароль сервису, не
# считая bcrypt. Флаг локальный по устройству: в прод-юните его нет, и
# случайно скопированный туда открытый пароль там просто не сработает.
RUN_ENV="ADMIN_LISTEN_ADDR=127.0.0.1:%PORT%;CONTENT_ROOT=%MAIN%/content;COOKIE_SECURE=false;ADMIN_USERNAME=admin;ADMIN_ALLOW_PLAIN_PASSWORD=1;JWT_ACCESS_TTL=24h;JWT_REFRESH_TTL=720h"

# СЕКРЕТЫ ВЫДАЁТ РАННЕР, А НЕ ЧЕЛОВЕК.
#
# До этого единственным путём был scripts/run-dev.ps1, который спрашивал
# пароль через Read-Host — то есть поднять ферму одной командой было нельзя в
# принципе: на третьем сервисе она останавливалась и ждала ввода.
#
# Значения эфемерные: генерируются на запуск, печатаются в консоль, никуда не
# пишутся. Постоянный пароль в файле рядом с репозиторием — ровно тот способ,
# которым секрет однажды уезжает в git; здесь его нет и заводить не надо.
RUN_SECRETS="JWT_SECRET;ADMIN_PASSWORD_PLAIN"

RUN_NOTE="пароль админки печатается ниже и живёт до Ctrl-C: следующий запуск выдаст другой"
