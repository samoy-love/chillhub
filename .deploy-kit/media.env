# Версионный набор официальных трейлеров и скриншотов карточек игр.
# Источники и контрольные суммы проверяются до упаковки; блогерские видео
# остаются внешними ссылками и в этот артефакт не входят.
APP=chillhub-media
ROOT=/var/www/chillhub-media
OWNER=root:www-data
NGINX_CONF=nginx/sites/chillhub-launcher.conf
NGINX_DEST=/etc/nginx/sites-available/chillhub-launcher.conf
ARTIFACT_DIR=stage-media
BUILD_CMD='if [ "${CHILLHUB_FIRST_MEDIA_PUBLICATION:-0}" = 1 ]; then node scripts/content/prepare-media-history.mjs --first-publication; else node scripts/content/prepare-media-history.mjs; fi && node scripts/content/stage-media.mjs'
HEALTH=https://launcher.samoy.love/assets/media/version.json
VERSION_URL=https://launcher.samoy.love/assets/media/version.json
KEEP=3
NOTIFY=never
NEIGHBOURS=launcher.samoy.love
CHANGELOG_PATHS='scripts/content launcher/ChillHub.Native/Data'
