# Цель: морда админки (статика, которую отдаёт nginx).
#
# Почему отдельная цель, а не часть chillhub-admin: файлы раздаёт nginx напрямую
# из /var/www/launcher/admin_ui — этот путь прибит в конфиге в восьми местах.
# Бинарь админки к ним не прикасается.
#
# Каталог /var/www/launcher/admin_ui на сервере — симлинк на current этой цели,
# поэтому переключение релиза атомарно и для nginx.

APP=chillhub-admin-ui
ROOT=/var/www/chillhub-admin-ui
ARTIFACT_DIR=stage-admin-ui
OWNER=root:www-data

BUILD_CMD='rm -rf stage-admin-ui && cp -r server/admin_ui stage-admin-ui'

# login.js — единственный файл морды, который отдаётся без авторизации
# (остальные закрыты auth_request и вернут 401 даже будучи на месте).
HEALTH=https://launcher.samoy.love/admin/ui/login.js

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,die.samoy.love,status.samoy.love

KEEP=5

# Версию не пишем: каталог раздаётся под /admin/ui/, а version.json там был бы
# доступен снаружи без авторизации.
# ЦЕЛЬ ТЕПЕРЬ ПОДТВЕРЖДАЕТ, ЧТО РАЗДАЁТСЯ ИМЕННО ВЫКАЧЕННОЕ.
#
# Морда лежит в ROOT выше, а раздаётся через симлинк
# /var/www/launcher/admin_ui -> <ROOT>/current (заведён руками, проверено на
# хосте). Цепочка рабочая, но при WRITE_VERSION_FILE=0 её никто не проверял:
# единственной проверкой после выкатки оставалось «симлинк current показывает
# на новый релиз». Это говорит о состоянии каталога и ничего — о том, что
# nginx отдаёт именно его. Замени кто-нибудь симлинк копией, и выкатка
# осталась бы зелёной, а у админки висела бы старая морда.
#
# Отметка версии закрывает разрыв: release.sh сверяет по VERSION_URL то, что
# РАЗДАЁТСЯ, — та же проверка, что у остальных статических целей. Точка
# /admin/ui/version.json открыта в nginx/sites/chillhub-launcher.conf
# (deploy-kit) отдельным location без auth_request; остальное под /admin/ui/
# по-прежнему за авторизацией.
WRITE_VERSION_FILE=1
VERSION_URL=https://launcher.samoy.love/admin/ui/version.json

# О релизе рассказывает сама выкатка, событием и в тот же момент. Прежнее
# молчание держалось на опросе: агент обходил /version.json и узнавал о релизе
# по разнице двух снимков — а разница не знает ни про три выкатки за минуту, ни
# про выкатку с откатом, ни про провал, при котором версия просто осталась
# прежней. Событие знает про всё это, потому что рождается там же, где решается
# исход выкатки. Отсюда `all`.
#
# Дублей это не создаёт: голос в чате по-прежнему один. Событие уезжает БОТУ
# status.samoy.love, а не в Telegram напрямую, — форматирует и отправляет его
# тот же единственный отправитель. Поэтому TELEGRAM_* в этом репозитории нет и заводить
# их не надо.
NOTIFY=all

# ЧТО ВЕЗЁТ ЭТА ЦЕЛЬ — для списка изменений.
#
# Репозиторий один, целей шесть, а список изменений считался по всей его
# истории: 22.08 карточка chillhub-site перечислила восемь PR при одном
# настоящем изменении — сайт не выкатывался с 16.08, и диапазон «прод → HEAD»
# накрыл шесть дней чужой работы. В списке сайта оказались правки лаунчера и
# фавиконка админки.
#
# Пути те же, по которым задача changes в deploy.yml решает, катить ли эту
# цель: один ответ на вопрос «что относится к цели» на оба применения.
CHANGELOG_PATHS='server/admin_ui .htmlhintrc .stylelintrc.json .stylelintignore'

# ------------------------------------------------------------ локальный запуск
#
# Отдельного процесса у морды нет. На проде её раздаёт nginx из
# /var/www/launcher/admin_ui, а локально — сам бинарь админки: он ищет
# server/admin_ui рядом с собой и отдаёт по /admin/ui/. Второй сервер на те же
# файлы означал бы две раздачи одного каталога на разных портах и вопрос
# «какая из них настоящая» при первом же расхождении.
RUN_SKIP="морду раздаёт chillhub-admin на /admin/ui/ — dk run chillhub-admin"

# отметка замера пайплайнов 2026-09-04
