# Цель: морда админки (статика, которую отдаёт nginx).
#
# Почему отдельная цель, а не часть chillhub-admin: файлы раздаёт nginx напрямую
# из /var/www/launcher/admin_ui — этот путь прибит в конфиге в восьми местах.
# Бинарь админки к ним не прикасается.
#
# Каталог /var/www/launcher/admin_ui на сервере — симлинк на current этой цели,
# поэтому переключение релиза атомарно и для nginx.

APP=chillhub-admin-ui
ROOT=/var/www/chillhub-admin-ui
ARTIFACT_DIR=stage-admin-ui
OWNER=root:www-data

BUILD_CMD='rm -rf stage-admin-ui && cp -r server/admin_ui stage-admin-ui'

# login.js — единственный файл морды, который отдаётся без авторизации
# (остальные закрыты auth_request и вернут 401 даже будучи на месте).
HEALTH=https://launcher.samoy.love/admin/ui/login.js

NEIGHBOURS=samoy.love,metro.samoy.love,snakes.samoy.love,status.samoy.love

KEEP=5

# Версию не пишем: каталог раздаётся под /admin/ui/, а version.json там был бы
# доступен снаружи без авторизации.
WRITE_VERSION_FILE=0

# О релизах объявляет БОТ samoy-status, а не CI: агент опрашивает сервисы и сам
# замечает смену версии. Голос должен остаться один — уведомляй ещё и пайплайн,
# на каждую выкатку приходило бы по два сообщения. Отсюда `never`; TELEGRAM_* в
# этом репозитории нет и заводить их не надо.
NOTIFY=never
