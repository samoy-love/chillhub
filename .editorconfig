root = true

[*]
end_of_line = crlf
insert_final_newline = true
charset = utf-8

[*.cs]
indent_style = space
indent_size = 4
# Enable common code style suggestions
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_new_line_before_open_brace = all:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Using directives placement and ordering
csharp_using_directive_placement = inside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Braces must not be omitted
csharp_prefer_braces = true:warning

# Trailing commas in multi-line lists/initializers
csharp_prefer_trailing_comma_in_multi_line_lists = true:suggestion

# Newline at end of file
insert_final_newline = true

# Whitespace cleanup (let formatter handle spacing and wrapping)
dotnet_style_allow_multiple_blank_lines_experimental = false:suggestion
dotnet_style_allow_statement_immediately_after_block_experimental = false:suggestion

# File header template for StyleCop SA1633 (adjust if needed)
file_header_template = Copyright (c) 2025 ChillHub\nLicensed under the MIT License.

# Treat warnings as warnings in lint job (build may still pass)
warn_as_error = false

# StyleCop rules: suppress or downgrade noisy rules
dotnet_diagnostic.SA1649.severity = none    # File name should match first type name
dotnet_diagnostic.SA1402.severity = none    # File may only contain a single type
dotnet_diagnostic.SA1513.severity = suggestion  # Closing brace should be followed by blank line
dotnet_diagnostic.SA1201.severity = suggestion  # Ordering of elements
dotnet_diagnostic.SA1204.severity = suggestion  # Static members before non-static
dotnet_diagnostic.SA1214.severity = suggestion  # Readonly before non-readonly
dotnet_diagnostic.SA1203.severity = suggestion  # Const before non-const
dotnet_diagnostic.SA1311.severity = suggestion  # Static readonly fields should begin with upper-case
dotnet_diagnostic.SA1107.severity = suggestion  # Multiple statements on one line
dotnet_diagnostic.SA1117.severity = suggestion  # Parameter wrapping
dotnet_diagnostic.SA1413.severity = suggestion  # Trailing comma in multi-line initializers
dotnet_diagnostic.SA0001.severity = none        # XML comment analysis disabled notice

# Additional suppressions per request
dotnet_diagnostic.SA1500.severity = none    # Braces for multi-line statements should not share line
dotnet_diagnostic.SA1600.severity = none    # Elements should be documented
dotnet_diagnostic.SA1601.severity = none    # Partial elements should be documented
dotnet_diagnostic.SA1602.severity = none    # Enumeration items should be documented
dotnet_diagnostic.SA1604.severity = none    # Element documentation header should have summary
dotnet_diagnostic.SA1609.severity = none    # Property documentation must have value
dotnet_diagnostic.SA1611.severity = none    # Element parameters should be documented
dotnet_diagnostic.SA1615.severity = none    # Element return value should be documented
dotnet_diagnostic.SA1618.severity = none    # Generic type parameters should be documented
dotnet_diagnostic.SA1623.severity = none    # Property documentation should match accessors
dotnet_diagnostic.SA1629.severity = none    # Documentation text should end with a period
dotnet_diagnostic.SA1633.severity = none    # File must have header

# Highly noisy spacing/formatting and layout rules (suppress during active dev)
dotnet_diagnostic.SA1515.severity = none    # Single-line comment should be preceded by blank line
dotnet_diagnostic.SA1516.severity = none    # Elements should be separated by blank line
dotnet_diagnostic.SA1507.severity = none    # Multiple blank lines in a row
dotnet_diagnostic.SA1512.severity = none    # Single-line comments should not be followed by blank line
dotnet_diagnostic.SA1501.severity = none    # Statement should not be on a single line
dotnet_diagnostic.SA1502.severity = none    # Element should not be on a single line
dotnet_diagnostic.SA1508.severity = none    # Closing brace should not be preceded by a blank line
dotnet_diagnostic.SA1137.severity = none    # Elements should have the same indentation

# Using directives/order rules (suppress to avoid churn; formatter usually handles this)
dotnet_diagnostic.SA1210.severity = none    # Using directives should be ordered alphabetically

# Naming/field prefix rules (project uses pragmatic naming in places)
dotnet_diagnostic.SA1308.severity = none    # Field should not begin with 's_'
dotnet_diagnostic.SA1300.severity = none    # Element should begin with an uppercase letter
dotnet_diagnostic.SA1310.severity = none    # Field names should not contain underscore

# Spacing around tokens and punctuation (downgrade noise)
dotnet_diagnostic.SA1001.severity = none    # Commas should be followed by whitespace
dotnet_diagnostic.SA1003.severity = none    # Operator spacing
dotnet_diagnostic.SA1009.severity = none    # Closing parenthesis should be followed by a space
dotnet_diagnostic.SA1011.severity = none    # Closing square bracket should be followed by a space
dotnet_diagnostic.SA1012.severity = none    # Opening brace spacing
dotnet_diagnostic.SA1013.severity = none    # Closing brace spacing
dotnet_diagnostic.SA1024.severity = none    # Colon spacing

# Braces/flow layout preferences
dotnet_diagnostic.SA1503.severity = none    # Braces should not be omitted

# Misc style preferences often conflicting with pragmatic code
dotnet_diagnostic.SA1116.severity = none    # Parameter list wrapping placement
dotnet_diagnostic.SA1119.severity = none    # Unnecessary parenthesis
dotnet_diagnostic.SA1122.severity = none    # Use string.Empty for empty strings
dotnet_diagnostic.SA1101.severity = none    # Prefix local calls with this
dotnet_diagnostic.SA1407.severity = none    # Arithmetic expressions should declare precedence
