<Window x:Class="ChillHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лаунчер ChillHub" Height="760" Width="1180" WindowStartupLocation="CenterScreen"
        MinHeight="640" MinWidth="980"
        ResizeMode="CanResize" SizeToContent="Manual"
        Icon="/ChillHub;component/Assets/app.ico"
        Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with gradient background -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.HeaderGradient}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0" VerticalAlignment="Center">
                <Grid.Resources>
                    <!-- Dedicated style for the Settings button: same corner radius as Karaoke, centered content -->
                    <Style x:Key="Style.SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Слева — только имя приложения. «Добро пожаловать в» занимало треть шапки и
                     ничего не сообщало: пользователь и так знает, что он запустил. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/ChillHub;component/Assets/app.ico" Width="22" Height="22"/>
                    <TextBlock Text="ChillHub" FontSize="15" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Middle: Karaoke area (two-line typewriter + crossfade), aligned to settings with 16px gap.
                     Ни фона, ни рамки: с ними декоративная строка выглядела как <TextBox> с
                     подсказкой — серый текст в рамке с внутренним отступом, в который тянет
                     кликнуть и что-то ввести. Ввода здесь нет и не будет. -->
                <Border x:Name="KaraokeHost" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,16,0"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,4" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KaraokeCurrentText" Grid.Row="0" TextWrapping="NoWrap" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock x:Name="KaraokeNextText" Grid.Row="1" TextWrapping="NoWrap" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource Brush.TextMuted}" Opacity="0.5"/>
                    </Grid>
                </Border>

                <!-- Right: Settings button only -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Размер фиксированный, а не «сколько получилось у караоке»: высота
                         декоративной строки зависит от шрифта и не должна задавать размер кнопки. -->
                    <Button Style="{StaticResource Style.SettingsButton}" Width="32" Height="32"
                            Click="SettingsBtn_Click" ToolTip="Настройки">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Баннер режима технических работ (задача 25). Скрыт, пока сервер не сообщил о работах. -->
        <Border x:Name="MaintenanceBanner" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.Danger}"/>
                <TextBlock Grid.Column="1" x:Name="MaintenanceBannerText" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2" Background="{DynamicResource Brush.Background}">
            <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
        </Grid>
    </Grid>

    <!-- Window-specific resources (empty; header gradient comes from theme dictionary) -->
    <Window.Resources>
    </Window.Resources>
</Window>
