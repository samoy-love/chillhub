<Window x:Class="ChillHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chill Hub" Height="720" Width="1100" 
        ResizeMode="CanResize" SizeToContent="Manual"
        Icon="/ChillHub;component/Assets/app.ico"
        Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with gradient background -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.HeaderGradient}">
            <Grid Margin="12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left: Logo + Title (centered vertically) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/ChillHub;component/Assets/app.ico" Width="28" Height="28"/>
                    <TextBlock Text="Chill Hub" Margin="8,0,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Right: Settings button only -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Click="SettingsBtn_Click" ToolTip="Настройки"
                            Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.Background}">
            <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
        </Grid>
    </Grid>

    <!-- Window-specific resources (empty; header gradient comes from theme dictionary) -->
    <Window.Resources>
    </Window.Resources>
</Window>
