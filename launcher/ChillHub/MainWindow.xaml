<Window x:Class="ChillHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ChillHub.Core.UI"
        Title="Лаунчер Chill Hub" WindowStartupLocation="CenterScreen"
        MinHeight="640" MinWidth="980"
        ResizeMode="CanResize" SizeToContent="Manual"
        Icon="/ChillHub;component/Assets/app.ico"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.HeaderBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0" VerticalAlignment="Center">
                <Grid.Resources>
                    <!-- Dedicated style for the Settings button: same corner radius as Karaoke, centered content -->
                    <Style x:Key="Style.SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="{DynamicResource Radius.M}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <!-- Имя, поиск, свободное место, караоке, правый блок.
                         Лишнюю ширину забирает ПОИСК, а не караоке: караоке подбирает
                         себе ширину само, под самую длинную строку песни, и в звёздочной
                         колонке оказывалось шире неё — ClipToBounds срезал строку слева,
                         и от песни оставался хвост. А в колонке по содержимому оно той же
                         шириной выталкивало кнопку настроек за край окна.
                         Поэтому поиск сжимается первым, а караоке ограничено сверху. -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Слева — приветствие и имя приложения: «Добро пожаловать в ⟨значок⟩ Chill Hub».
                     Приветствие набрано вторичным цветом, чтобы главным словом оставалось имя. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Добро пожаловать в" FontSize="14" Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    <Image Source="/ChillHub;component/Assets/app.ico" Width="22" Height="22" VerticalAlignment="Center"/>
                    <TextBlock Text="Chill Hub" FontSize="15" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Title}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Поиск по играм. Переехал сюда из сайдбара: список игр — единственная
                     навигация в приложении, и её место там же, где остальное управление.
                     Подсказка — свойством поля, а не надписью поверх: своя надпись стояла
                     по краю сетки, а текст поля начинается внутри рамки и Padding, и после
                     клика каретка появлялась правее подсказки. Значок лупы отдельным слоем:
                     он не текст и с кареткой не спорит. -->
                <Grid Grid.Column="1" MaxWidth="220" HorizontalAlignment="Left" MinWidth="120" Margin="24,0,16,0" VerticalAlignment="Center">
                    <TextBox x:Name="GameSearchBox" TextChanged="GameSearch_TextChanged"
                             ui:Placeholder.Text="Поиск по играм"
                             Template="{DynamicResource Template.TextBox.Field}"
                             VerticalContentAlignment="Center" Height="28"
                             Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}"
                             Padding="26,0,8,0" FontSize="12" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12" IsHitTestVisible="False"
                               Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </Grid>

                <!-- Свободное место на диске игр. Тоже из подвала сайдбара: это свойство
                     машины, а не списка, и в шапке оно видно с любого экрана. Пустая
                     строка — когда диск недоступен; тогда и места в шапке не занимает. -->
                <TextBlock x:Name="DiskFreeText" Grid.Column="2" Text="" FontSize="12" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextMuted}"/>

                <!-- Караоке — Баста, «Моя игра»: печатаемая строка с мигающим курсором и
                     следующая строка бледнее, слева нота акцентом. Ни фона, ни рамки: с ними
                     строка выглядела как поле ввода с подсказкой. Высоты строк фиксированы,
                     чтобы шапка не дышала, когда строка пустая (пауза между куплетами).
                     Ширина подбирается под самую длинную строку (KaraokePresenter). -->
                <Border x:Name="KaraokeHost" Grid.Column="3" MaxWidth="340" HorizontalAlignment="Right" Margin="16,0,16,0"
                        Background="Transparent" BorderThickness="0" Padding="8,0"
                        ClipToBounds="True" ToolTip="Баста — «Моя игра»" ToolTipService.Placement="Bottom">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Height="17">
                                <TextBlock x:Name="KaraokeCurrentText" TextWrapping="NoWrap" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                                <!-- Курсор — тонкая акцентная черта; мигает сам, см. KaraokePresenter -->
                                <Border x:Name="KaraokeCaret" Width="2" Height="13" Margin="1,0,0,0" CornerRadius="1"
                                        Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="KaraokeNextText" TextWrapping="NoWrap" FontSize="11" Height="15"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: индикатор загрузок + настройки -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Чип загрузок виден, пока очередь не пуста и мы НЕ на главной: со
                         страницы игры и из настроек ход закачки иначе не виден вовсе, а на
                         главной он повторял бы очередь, стоящую внизу того же экрана
                         (см. RefreshDownloadsIndicator). Это индикатор, а не кнопка:
                         подсвечиваться и нажиматься ему нечего. Отступы задаются здесь
                         явно — шаблон Style.SettingsButton свой Padding не пробрасывает. -->
                    <Border x:Name="HeaderDownloadsBtn" Height="32" Padding="12,0" Margin="0,0,8,0"
                            Visibility="Collapsed" CornerRadius="{DynamicResource Radius.M}"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            ToolTip="Очередь загрузок" ToolTipService.Placement="Bottom">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="14"
                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderDownloadsText" Text="" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                    <!-- Размер фиксированный, а не «сколько получилось у караоке»: высота
                         декоративной строки зависит от шрифта и не должна задавать размер кнопки. -->
                    <!-- Подсказка снизу, а не у курсора: у правого края экрана всплывашка
                         «Настройки» упиралась в границу и обрезалась до «Настрой». -->
                    <Button Style="{StaticResource Style.SettingsButton}" Width="32" Height="32"
                            Click="SettingsBtn_Click" ToolTip="Настройки"
                            ToolTipService.Placement="Bottom" ToolTipService.HorizontalOffset="-40">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Баннер режима технических работ. Скрыт, пока сервер не сообщил о работах.
             Полоса под шапкой, той же ширины и с тем же отступом слева (14), чтобы значок
             стоял в одной колонке с приветствием, а не на два пикселя правее. Значок —
             Warning, а не Danger: работы — временное ограничение, как «нужно обновление»
             у игры, а красным в лаунчере отмечены сбои и разрушительные действия.
             Причина набрана основным весом, срок — вторичным цветом: сообщение читается
             как заголовок и подпись, а не как абзац одинаковых слов. -->
        <Border x:Name="MaintenanceBanner" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource Brush.Warning}"/>
                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}">
                    <Run x:Name="MaintenanceBannerReason" FontWeight="SemiBold"/>
                    <Run x:Name="MaintenanceBannerEta" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2" Background="{DynamicResource Brush.Background}">
            <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
        </Grid>

        <!-- Окно «Что нового». Открывается само один раз после обновления лаунчера
             (см. Core/Changelog/ChangelogGate), а вручную — кнопкой в новостях лаунчера
             и в настройках.
             Живёт в окне, а не на главной странице: открывать его умеют и настройки,
             а вторая копия той же разметки на второй странице разъехалась бы с первой.
             RowSpan на все три строки — затемнение обязано накрыть и шапку, и баннер
             работ, иначе кнопки под «модальным» окном остаются нажимаемыми. -->
        <Grid x:Name="ChangelogOverlay" Visibility="Collapsed" Background="{DynamicResource Brush.Scrim}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.RowSpan="3">
          <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="Changelog.BoolToVis"/>

            <!-- Полоса слева. У непросмотренного выпуска она акцентная, у прочитанного —
                 обычная рамка: пролистывая длинный список, новое видно по краю, не
                 вчитываясь в номера. -->
            <Style x:Key="Style.Changelog.Stripe" TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
              <Setter Property="CornerRadius" Value="8,0,0,8"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>

            <!-- Один пункт списка: точка и текст. Точка отдельной колонкой, а не первым
                 символом строки: иначе перенесённая строка выравнивалась бы под точкой,
                 а не под текстом. -->
            <DataTemplate x:Key="Template.Changelog.Line">
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="•" FontSize="14" VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.Accent}"/>
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13.5"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource Brush.Text}"/>
              </Grid>
            </DataTemplate>

            <!-- Один выпуск: номер версии, дата и пункты. Слева — акцентная полоса:
                 она делит длинный список на выпуски заметнее, чем отступ. -->
            <DataTemplate x:Key="Template.Changelog.Release">
              <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="{DynamicResource Radius.M}"
                      BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                      Margin="0,0,0,12" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource Style.Changelog.Stripe}"/>
                  <StackPanel Grid.Column="1" Margin="16,14,16,14">
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Version}" FontSize="17" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Title}"/>
                      <!-- «Новое» — рядом с номером, а не у края: строку читают слева
                           направо, и про выпуск надо узнать до того, как начнёшь его
                           читать. На первом запуске отмечать нечем, и значка не будет
                           ни у одного выпуска (см. ChangelogMarks). -->
                      <Border Grid.Column="1" Margin="10,2,0,0" Padding="7,2" VerticalAlignment="Center"
                              CornerRadius="{DynamicResource Radius.S}"
                              Background="{DynamicResource Brush.AccentFill}"
                              Visibility="{Binding IsNew, Converter={StaticResource Changelog.BoolToVis}}">
                        <TextBlock Text="Новое" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.OnAccent}"/>
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="12.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Changes}"
                                  ItemTemplate="{StaticResource Template.Changelog.Line}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </Grid.Resources>

          <!-- Тень: отдельный слой под карточкой, а не Effect на ней — размытие поверх
               содержимого делает текст мыльным. Тот же приём, что и у формы обратной связи
               на главной. -->
          <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,40,0,34"
                  CornerRadius="{DynamicResource Radius.L}" Background="#000000" Opacity="0.22"
                  SnapsToDevicePixels="True" UseLayoutRounding="True"/>

          <!-- VerticalAlignment=Stretch + Margin держат карточку внутри окна: список длинный,
               и при Center он ушёл бы за нижний край экрана вместо того, чтобы прокручиваться. -->
          <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderHover}"
                  BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Width="720"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,40,0,40"
                  SnapsToDevicePixels="True" UseLayoutRounding="True"
                  TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display"
                  TextOptions.TextHintingMode="Fixed" RenderOptions.ClearTypeHint="Enabled">
            <Grid>
              <Grid.RowDefinitions>
                <!-- шапка -->
                <RowDefinition Height="Auto"/>
                <!-- список выпусков — единственное, что растёт и прокручивается -->
                <RowDefinition Height="*"/>
                <!-- кнопка -->
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="20,20,20,12">
                <StackPanel Margin="0,0,36,0">
                  <TextBlock Text="Что нового" Style="{DynamicResource Style.PageTitle}"/>
                  <TextBlock x:Name="ChangelogSubtitle" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
                <Button Content="✕" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" Padding="0"
                        Style="{DynamicResource Style.Button.GhostNeutral}"
                        ToolTip="Закрыть" Click="ChangelogClose_Click"/>
              </Grid>

              <!-- CanContentScroll=False: выпуски разной высоты, и прокрутка «по элементам»
                   прыгала бы через целый выпуск за один щелчок колеса. -->
              <ScrollViewer x:Name="ChangelogScroll" Grid.Row="1" Margin="20,0,14,0" Padding="0,0,6,0"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            CanContentScroll="False" Focusable="False">
                <ItemsControl x:Name="ChangelogList"
                              ItemTemplate="{StaticResource Template.Changelog.Release}"/>
              </ScrollViewer>

              <Border Grid.Row="2" Margin="20,12,20,20" BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource Brush.Border}" Padding="0,16,0,0">
                <Button Content="Понятно" HorizontalAlignment="Right" MinWidth="140"
                        Style="{DynamicResource Style.Button.Primary}" Click="ChangelogClose_Click"/>
              </Border>
            </Grid>
          </Border>
        </Grid>
    </Grid>
</Window>
