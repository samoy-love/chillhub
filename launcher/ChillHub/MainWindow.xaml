<Window x:Class="ChillHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лаунчер Chill Hub" Height="660" Width="1130" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" SizeToContent="Manual"
        Icon="/ChillHub;component/Assets/app.ico"
        Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with gradient background -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.HeaderGradient}">
            <Grid Margin="16,0" VerticalAlignment="Center">
                <Grid.Resources>
                    <!-- Dedicated style for the Settings button: same corner radius as Karaoke, centered content -->
                    <Style x:Key="Style.SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left: Logo + Title (centered vertically) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Добро пожаловать в" FontSize="18" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    <Image Source="/ChillHub;component/Assets/app.ico" Margin="16,0,0,0" Width="28" Height="28"/>
                    <TextBlock Text="Chill Hub" FontSize="18" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Middle: Karaoke area (two-line typewriter + crossfade), aligned to settings with 16px gap -->
                <Border x:Name="KaraokeHost" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,16,0"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.M}" Padding="8,4" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KaraokeCurrentText" Grid.Row="0" TextWrapping="NoWrap" FontSize="12" FontWeight="SemiBold" Foreground="#7A6FA8"/>
                        <TextBlock x:Name="KaraokeNextText" Grid.Row="1" TextWrapping="NoWrap" FontSize="11" FontWeight="Normal" Foreground="#4A3F6E" Opacity="0.55"/>
                    </Grid>
                </Border>

                <!-- Right: Settings button only -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Style.SettingsButton}"
                            Width="{Binding ElementName=KaraokeHost, Path=ActualHeight}"
                            Height="{Binding ElementName=KaraokeHost, Path=ActualHeight}"
                            Click="SettingsBtn_Click" ToolTip="Настройки">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.Background}">
            <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
        </Grid>
    </Grid>

    <!-- Window-specific resources (empty; header gradient comes from theme dictionary) -->
    <Window.Resources>
    </Window.Resources>
</Window>
