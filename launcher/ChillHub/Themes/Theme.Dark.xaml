<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Palette -->
  <!-- Одна акцентная краска (#7C5CFF) и три статусных цвета. Раньше акцентов было три —
       розовый, фиолетовый и градиент между ними — и ни один из них не значил «главное». -->
  <Color x:Key="Color.Background">#0C0C10</Color>        <!-- фон окна -->
  <Color x:Key="Color.Surface">#14141B</Color>           <!-- карточка на фоне -->
  <Color x:Key="Color.Surface2">#1B1B24</Color>          <!-- карточка на карточке -->
  <Color x:Key="Color.Border">#24242F</Color>
  <Color x:Key="Color.Text">#E9E9F0</Color>
  <Color x:Key="Color.TextSecondary">#9A9AAB</Color>
  <Color x:Key="Color.TextMuted">#6E6E80</Color>          <!-- подписи, «не установлена» -->
  <!-- Единственный акцент -->
  <Color x:Key="Color.Accent">#7C5CFF</Color>
  <Color x:Key="Color.AccentHover">#8F73FF</Color>
  <Color x:Key="Color.SecondaryAccent">#6949E0</Color>   <!-- нажатое состояние акцента -->
  <!-- Статусы игр: готова / нужно обновление / проблема -->
  <Color x:Key="Color.Success">#57C98A</Color>
  <Color x:Key="Color.Warning">#E0A64B</Color>
  <Color x:Key="Color.Danger">#E06B6B</Color>
  <Color x:Key="Color.Selection">#1B1B26</Color>
  <!-- Состояния -->
  <Color x:Key="Color.HeaderStart">#101017</Color>
  <Color x:Key="Color.HeaderMid">#101017</Color>
  <Color x:Key="Color.HeaderEnd">#101017</Color>
  <Color x:Key="Color.Hover">#1B1B24</Color>
  <Color x:Key="Color.Pressed">#22222E</Color>
  <Color x:Key="Color.BorderHover">#35354A</Color>
  <Color x:Key="Color.BorderPressed">#35354A</Color>
  <Color x:Key="Color.ListHover">#16161E</Color>
  <Color x:Key="Color.ListHoverAlt">#1B1B24</Color>
  <Color x:Key="Color.Skeleton">#1B1B24</Color>
  <!-- Слайдеры и полосы -->
  <Color x:Key="Color.Track">#22222E</Color>
  <Color x:Key="Color.TrackFill">#7C5CFF</Color>
  <Color x:Key="Color.Thumb">#4A4458</Color>
  <Color x:Key="Color.ThumbHover">#7C5CFF</Color>
  <Color x:Key="Color.ThumbActive">#8F73FF</Color>
  <!-- Три радиуса на всё приложение: мелкое, контролы, карточки -->
  <CornerRadius x:Key="Radius.S">6</CornerRadius>
  <CornerRadius x:Key="Radius.M">8</CornerRadius>
  <CornerRadius x:Key="Radius.L">12</CornerRadius>

  <!-- Brushes mapped to new Palette -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
  <!-- Title/headline text color -->
  <SolidColorBrush x:Key="Brush.Title" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
  <SolidColorBrush x:Key="Brush.SecondaryAccent" Color="{StaticResource Color.SecondaryAccent}"/>
  <!-- Заливка главной кнопки. Ключ остался с градиентных времён, но краска теперь одна:
       градиент на тёмном фоне всё равно читался как грязное пятно. -->
  <SolidColorBrush x:Key="Brush.AccentGradientPrimary" Color="{StaticResource Color.Accent}"/>
  <!-- State brushes -->
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}"/>
  <SolidColorBrush x:Key="Brush.BorderHover" Color="{StaticResource Color.BorderHover}"/>
  <SolidColorBrush x:Key="Brush.BorderPressed" Color="{StaticResource Color.BorderPressed}"/>
  <SolidColorBrush x:Key="Brush.ListHover" Color="{StaticResource Color.ListHover}"/>
  <SolidColorBrush x:Key="Brush.ListHoverAlt" Color="{StaticResource Color.ListHoverAlt}"/>
  <SolidColorBrush x:Key="Brush.Skeleton" Color="{StaticResource Color.Skeleton}"/>
  <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}"/>
  <SolidColorBrush x:Key="Brush.TrackFill" Color="{StaticResource Color.TrackFill}"/>
  <SolidColorBrush x:Key="Brush.Thumb" Color="{StaticResource Color.Thumb}"/>
  <SolidColorBrush x:Key="Brush.ThumbHover" Color="{StaticResource Color.ThumbHover}"/>
  <SolidColorBrush x:Key="Brush.ThumbActive" Color="{StaticResource Color.ThumbActive}"/>
  <!-- Semantic colors -->
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}"/>

  <!-- Header background (solid per spec) -->

  <!-- Шапка — ровная заливка. Ключ сохранён ради ссылок из MainWindow. -->
  <SolidColorBrush x:Key="Brush.HeaderGradient" Color="{StaticResource Color.HeaderStart}"/>

  <!-- Пунктирный прямоугольник фокуса Windows: выключен разом для всех элементов.

       Значение FocusVisualStyle по умолчанию — ссылка на ресурс с этим ключом, поэтому
       пустой шаблон здесь снимает рамку и с тех элементов, у которых своего стиля нет
       (например Border с Focusable="True" на карточке игры). Точечные сеттеры
       FocusVisualStyle="{x:Null}" в стилях ниже остаются: они дешевле, чем разбирать,
       какой из них теперь лишний.

       Через FrameworkElement.FocusVisualStyleProperty.OverrideMetadata это не делается:
       свойство объявлено самим FrameworkElement, метаданные для типа-владельца уже
       зарегистрированы, и вызов падает с ArgumentException. В статическом конструкторе
       App это роняло лаунчер до первой строки boot.log — версия 1.5.11 не запускалась
       вовсе. -->
  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
    <Setter Property="Template" Value="{x:Null}"/>
  </Style>

  <!-- TextBlock default -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ContextMenu and MenuItem dark theme -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  RenderOptions.EdgeMode="Aliased">
            <ItemsPresenter Margin="0"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin" Value="4,4,4,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource Brush.Border}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- Custom template without IconPresenter to avoid black icon placeholders -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <Grid>
              <ContentPresenter Margin="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                RecognizesAccessKey="True"
                                ContentSource="Header"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ListHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ToolTip dark theme: ensure readable white text on dark background -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>

  <!-- Removed glass brushes to avoid transparency -->

  <!-- Animated skeleton placeholder -->
  <Style x:Key="Style.Skeleton" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{StaticResource Brush.Skeleton}"/>
    <Setter Property="Height" Value="140"/>
    <Setter Property="Opacity" Value="0.55"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard x:Name="SkeletonPulse">
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:1.1"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
      <EventTrigger RoutedEvent="Unloaded">
        <StopStoryboard BeginStoryboardName="SkeletonPulse"/>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!-- Гасит системную пунктирную рамку фокуса по Tab на элементах, у которых нет
       своего implicit-стиля ниже. Button/TextBox/ComboBox и остальные со своим
       стилем это правило не увидят — им та же настройка проставлена в их
       собственных стилях; здесь — страховка для всего, что появится позже. -->
  <Style TargetType="Control">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- Window/Page background -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
  </Style>
  <Style TargetType="Page">
    <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
  </Style>

  <!-- Button modern -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <!-- Кнопки — единственный часто табаемый элемент, у которого не было своего
         шаблона: остальные (TextBox, ComboBox, ListBox…) уже гасят рамку ниже
         по файлу, а Button рисовал системный пунктирный прямоугольник поверх
         тёмной темы. -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary button (e.g., Play) -->
  <Style x:Key="Style.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPrimary}"/>
    <!-- Тёмный текст на акценте даёт ~6:1, белый — ~3.5:1. Раньше стояло #0A0A0A поверх
         тёмного градиента, то есть тёмное на тёмном. -->
    <Setter Property="Foreground" Value="#0C0C10"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.SecondaryAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Вторичная кнопка. Жила тремя одинаковыми копиями — в HomePage, в GamePage под
       именем Style.Button.GameGhost и в UpdateWindow, — и расходилась в мелочах от
       копии к копии. Теперь одна на всё приложение. -->
  <Style x:Key="Style.Button.GhostNeutral" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- «Назад» на всех вложенных экранах: одна кнопка, слева, со стрелкой. Раньше их
       было три разных — на странице игры без стрелки слева, в новости другой ширины
       слева, в настройках со стрелкой и СПРАВА, — и возврат каждый раз искали заново. -->
  <Style x:Key="Style.Button.Back" TargetType="Button" BasedOn="{StaticResource Style.Button.GhostNeutral}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <!-- Содержимое — через шаблон, а не готовый StackPanel в Setter Content: элемент
         в сеттере один на весь стиль, его получает первая кнопка, а на остальных
         страницах (игра, новость) кнопка оставалась пустой рамкой. -->
    <Setter Property="Content" Value="Назад"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Заголовок вложенного экрана -->
  <Style x:Key="Style.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <!-- TextBox / ComboBox / ListBox -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ScrollViewer.Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <!-- ToggleButton покрывает весь контрол, так что клик по любому месту открывает список -->
            <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          ClickMode="Press" Focusable="False">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Brush.BorderPressed}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="8,2,4,2" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
              <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4">
                  <ScrollViewer CanContentScroll="True" Background="{StaticResource Brush.Surface}">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ComboBox dropdown item styling (override template to avoid blue focus) -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter Margin="6,2" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="#0C0C10"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <!-- Некоторые системные шаблоны подсвечивают IsHighlighted для текущего элемента -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="#0C0C10"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Influence system dropdown colors used by default templates -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <!-- Use neutral selection for default templates instead of blue accent -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource Color.Background}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <!-- Extra mappings to neutralize any blue from default templates -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{StaticResource Color.ListHover}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource Color.ListHover}"/>

  <!-- Override system scrollbar dimensions so default templates (which bind to SystemParameters) use 3px -->
  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ListHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Карточки: радиус 12, рамка ровно 1px. Полуторапиксельная рамка на дробном DPI
       давала то одну, то две линии — отсюда «разная толщина» соседних карточек. -->
  <Style x:Key="Style.Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Style.Section" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
  </Style>
  <!-- Bordered panel for progress bar + caption -->
  <Style x:Key="Style.ProgressPanel" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Track}"/>
  </Style>

  <!-- Slider neutral style (avoid system template quirks on dark theme) -->
  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Track}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Margin="6,10">
            <!-- Rounded track base: thinner -->
            <Border CornerRadius="2" Height="4" VerticalAlignment="Center" Background="{StaticResource Brush.Track}"/>
            <!-- Use Track with repeat buttons filling left/right portions -->
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   IsDirectionReversed="False">
              <Track.DecreaseRepeatButton>
                <!-- Extend selected zone under half of the thumb (thumb is 16px, so -8 margin) -->
                <RepeatButton Background="{StaticResource Brush.TrackFill}" BorderBrush="{x:Null}" Margin="0,0,-8,0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Background="{StaticResource Brush.Track}" BorderBrush="{x:Null}">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="16" FocusVisualStyle="{x:Null}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="th" Fill="{StaticResource Brush.Thumb}" StrokeThickness="0"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="th" Property="Fill" Value="{StaticResource Brush.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="th" Property="Fill" Value="{StaticResource Brush.ThumbActive}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- CheckBox (dark theme) -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="0,0,8,0">
              <Border x:Name="Box" CornerRadius="3"
                      Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"/>
              <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 15 5"
                      StrokeThickness="2" Stroke="#0C0C10" Visibility="Collapsed"
                      StrokeEndLineCap="Square" StrokeLineJoin="Round"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbar theming per request: track = Background, thumb = #1A122B, hover = slightly lighter, border = #2B1F4A -->
  <SolidColorBrush x:Key="Brush.ScrollbarTrack" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="#2E2E3C"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumbHover" Color="#3F3F52"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumbBorder" Color="{StaticResource Color.Border}"/>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{StaticResource Brush.ScrollbarTrack}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   Minimum="0"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True"
                   Orientation="{TemplateBinding Orientation}">
              <!-- Buttons скрыты, но присутствуют для корректной разметки Track -->
              <Track.DecreaseRepeatButton>
                <RepeatButton Visibility="Collapsed"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb"
                       Background="{StaticResource Brush.ScrollbarThumb}"
                       BorderBrush="{StaticResource Brush.ScrollbarThumbBorder}"
                       BorderThickness="0"
                       Opacity="0.75">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThBase"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Visibility="Collapsed"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Thumb" Property="Background" Value="{StaticResource Brush.ScrollbarThumbHover}"/>
              <Setter TargetName="PART_Thumb" Property="Opacity" Value="0.9"/>
              <Setter TargetName="PART_Thumb" Property="BorderThickness" Value="1"/>
              <Setter TargetName="PART_Thumb" Property="BorderBrush" Value="{StaticResource Brush.ScrollbarThumbBorder}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="8"/>
              <Setter Property="Width" Value="Auto"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter Property="Width" Value="8"/>
              <Setter Property="Height" Value="Auto"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Window/Page background fallback -->

  <!-- Витрина: ровная подложка под обложкой игры. Пока обложки нет, это единственный фон,
       и он не должен спорить с ней цветом, когда она появится. -->
  <SolidColorBrush x:Key="Brush.HeroGradient" Color="#1E1B2B"/>
  <!-- Затемнение поверх обложки, чтобы белый заголовок читался на любой картинке -->
  <LinearGradientBrush x:Key="Brush.HeroScrim" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#00000000"/>
    <GradientStop Offset="0.45" Color="#66000000"/>
    <GradientStop Offset="1" Color="#E60C0C10"/>
  </LinearGradientBrush>
  <!-- Второй слой затемнения — слева направо, под заголовок и кнопку в левом нижнем углу.
       Правая половина обложки остаётся почти нетронутой: там обычно логотип игры. -->
  <LinearGradientBrush x:Key="Brush.HeroScrimSide" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#8C0C0C10"/>
    <GradientStop Offset="0.45" Color="#330C0C10"/>
    <GradientStop Offset="1" Color="#000C0C10"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.HeroBadge.Bg" Color="#1B1B24"/>
  <SolidColorBrush x:Key="Brush.HeroBadge.Border" Color="{StaticResource Color.Border}"/>

  <!-- Круглая кнопка сведений об игре (ⓘ) на витрине -->
  <Style x:Key="Style.Button.HeroInfo" TargetType="Button">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="#3314141B"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="18" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.SecondaryAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Вкладки под витриной: подчёркивание, а не залитая пилюля. Пилюля весом спорила с
       главной кнопкой действия — две крашенные акцентом плашки рядом, и обе «главные». -->
  <Style x:Key="Style.Button.HeroTab" TargetType="ToggleButton">
    <Setter Property="Padding" Value="2,0,2,8"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                  BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
