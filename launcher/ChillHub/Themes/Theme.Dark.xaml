<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Palette -->
  <!-- Core palette aligned with landing (landing/styles.css :root) -->
  <Color x:Key="Color.Background">#060606</Color>        <!-- neutral near-black -->
  <Color x:Key="Color.Surface">#0B0B0B</Color>           <!-- neutral dark surface -->
  <Color x:Key="Color.Border">#1E1E38</Color>            <!-- stroke (darker) -->
  <Color x:Key="Color.Text">#E8E8FB</Color>              <!-- text -->
  <Color x:Key="Color.TextSecondary">#B0B3C8</Color>      <!-- muted (slightly brighter for readability) -->
  <!-- Accents from landing logo gradient: bright = pink, duller = purple -->
  <Color x:Key="Color.Accent">#FF3A75</Color>           <!-- bright pink for checkmarks and primary accent -->
  <Color x:Key="Color.AccentHover">#8A2A4A</Color>       <!-- darker wine hover to match UpdateWindow -->
  <Color x:Key="Color.SecondaryAccent">#A78BFA</Color>   <!-- brighter/lighter purple for secondary accent -->
  <!-- Semantic colors (grayscale variants) -->
  <Color x:Key="Color.Success">#4CAF50</Color>
  <Color x:Key="Color.Danger">#FF6B6B</Color>
  <Color x:Key="Color.Selection">#262626</Color>
  <!-- Extended palette for states and components (derived from landing card tones) -->
  <Color x:Key="Color.HeaderStart">#0B0812</Color>       <!-- deeper top -->
  <Color x:Key="Color.HeaderMid">#07060E</Color>         <!-- deeper mid -->
  <Color x:Key="Color.HeaderEnd">#020205</Color>         <!-- matches darkest background -->
  <Color x:Key="Color.Hover">#1D1D36</Color>             <!-- card-2 -->
  <Color x:Key="Color.Pressed">#141428</Color>
  <Color x:Key="Color.BorderHover">#2A2A50</Color>
  <Color x:Key="Color.BorderPressed">#2A2A50</Color>
  <Color x:Key="Color.ListHover">#1B1B34</Color>
  <Color x:Key="Color.ListHoverAlt">#141428</Color>
  <Color x:Key="Color.Skeleton">#1A1A3A</Color>
  <!-- Slider / controls palette per spec -->
  <Color x:Key="Color.Track">#1B1B34</Color>
  <Color x:Key="Color.TrackFill">#3A2966</Color>
  <!-- Slider thumb colors tuned to be distinct from TrackFill but still dark -->
  <Color x:Key="Color.Thumb">#4A3A7A</Color>
  <Color x:Key="Color.ThumbHover">#8A2A4A</Color>
  <Color x:Key="Color.ThumbActive">#A78BFA</Color>
  <CornerRadius x:Key="Radius.L">10</CornerRadius>
  <CornerRadius x:Key="Radius.M">8</CornerRadius>
  <Thickness x:Key="Spacing.S">8</Thickness>

  <!-- Brushes mapped to new Palette -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <!-- Title/headline text color -->
  <SolidColorBrush x:Key="Brush.Title" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
  <SolidColorBrush x:Key="Brush.SecondaryAccent" Color="{StaticResource Color.SecondaryAccent}"/>
  <!-- Gradient accent brush for primary buttons (grad-a -> grad-b) -->
  <LinearGradientBrush x:Key="Brush.AccentGradientPrimary" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#3A2966"/>
    <GradientStop Offset="1" Color="#8A2A4A"/>
  </LinearGradientBrush>
  <!-- State brushes -->
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}"/>
  <SolidColorBrush x:Key="Brush.BorderHover" Color="{StaticResource Color.BorderHover}"/>
  <SolidColorBrush x:Key="Brush.BorderPressed" Color="{StaticResource Color.BorderPressed}"/>
  <SolidColorBrush x:Key="Brush.ListHover" Color="{StaticResource Color.ListHover}"/>
  <SolidColorBrush x:Key="Brush.ListHoverAlt" Color="{StaticResource Color.ListHoverAlt}"/>
  <SolidColorBrush x:Key="Brush.Skeleton" Color="{StaticResource Color.Skeleton}"/>
  <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}"/>
  <SolidColorBrush x:Key="Brush.TrackFill" Color="{StaticResource Color.TrackFill}"/>
  <SolidColorBrush x:Key="Brush.Thumb" Color="{StaticResource Color.Thumb}"/>
  <SolidColorBrush x:Key="Brush.ThumbHover" Color="{StaticResource Color.ThumbHover}"/>
  <SolidColorBrush x:Key="Brush.ThumbActive" Color="{StaticResource Color.ThumbActive}"/>
  <!-- Semantic colors -->
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}"/>

  <!-- Header background (solid per spec) -->
  <SolidColorBrush x:Key="Brush.HeaderBackground" Color="{StaticResource Color.HeaderStart}"/>

  <!-- Header gradient using project colors (3-stop, tuned for darker base) -->
  <LinearGradientBrush x:Key="Brush.HeaderGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0.0" Color="{StaticResource Color.HeaderStart}"/>
    <GradientStop Offset="0.42" Color="{StaticResource Color.HeaderMid}"/>
    <GradientStop Offset="1.0" Color="{StaticResource Color.HeaderEnd}"/>
  </LinearGradientBrush>

  <!-- TextBlock default -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ContextMenu and MenuItem dark theme -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  RenderOptions.EdgeMode="Aliased">
            <ItemsPresenter Margin="0"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin" Value="4,4,4,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource Brush.Border}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- Custom template without IconPresenter to avoid black icon placeholders -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <Grid>
              <ContentPresenter Margin="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                RecognizesAccessKey="True"
                                ContentSource="Header"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ListHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ToolTip dark theme: ensure readable white text on dark background -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>

  <!-- Removed glass brushes to avoid transparency -->

  <!-- Animated skeleton placeholder -->
  <Style x:Key="Style.Skeleton" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{StaticResource Brush.Skeleton}"/>
    <Setter Property="Height" Value="140"/>
    <Setter Property="Opacity" Value="0.55"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard x:Name="SkeletonPulse">
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:1.1"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
      <EventTrigger RoutedEvent="Unloaded">
        <StopStoryboard BeginStoryboardName="SkeletonPulse"/>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!-- Window/Page background -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
  </Style>
  <Style TargetType="Page">
    <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
  </Style>

  <!-- Button modern -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary button (e.g., Play) -->
  <Style x:Key="Style.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPrimary}"/>
    <Setter Property="Foreground" Value="#0A0A0A"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.SecondaryAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TextBox / ComboBox / ListBox -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ScrollViewer.Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <!-- ToggleButton покрывает весь контрол, так что клик по любому месту открывает список -->
            <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          ClickMode="Press" Focusable="False">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Brush.BorderPressed}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="8,2,4,2" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
              <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                <Border Background="{StaticResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4">
                  <ScrollViewer CanContentScroll="True" Background="{StaticResource Brush.Surface}">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ComboBox dropdown item styling (override template to avoid blue focus) -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter Margin="6,2" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="#0A0A0A"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <!-- Некоторые системные шаблоны подсвечивают IsHighlighted для текущего элемента -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="#0A0A0A"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Influence system dropdown colors used by default templates -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <!-- Use neutral selection for default templates instead of blue accent -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource Color.Background}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <!-- Extra mappings to neutralize any blue from default templates -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{StaticResource Color.ListHover}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource Color.ListHover}"/>

  <!-- Override system scrollbar dimensions so default templates (which bind to SystemParameters) use 3px -->
  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ListHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Card/Section styles per spec: background #121212, border #282828 -->
  <Style x:Key="Style.Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Style.Section" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
  </Style>
  <!-- Bordered panel for progress bar + caption -->
  <Style x:Key="Style.ProgressPanel" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="18"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.AccentGradientPrimary}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Track}"/>
  </Style>

  <!-- Slider neutral style (avoid system template quirks on dark theme) -->
  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Track}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Margin="6,10">
            <!-- Rounded track base: thinner -->
            <Border CornerRadius="2" Height="4" VerticalAlignment="Center" Background="{StaticResource Brush.Track}"/>
            <!-- Use Track with repeat buttons filling left/right portions -->
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   IsDirectionReversed="False">
              <Track.DecreaseRepeatButton>
                <!-- Extend selected zone under half of the thumb (thumb is 16px, so -8 margin) -->
                <RepeatButton Background="{StaticResource Brush.TrackFill}" BorderBrush="{x:Null}" Margin="0,0,-8,0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Background="{StaticResource Brush.Track}" BorderBrush="{x:Null}">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="16" FocusVisualStyle="{x:Null}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="th" Fill="{StaticResource Brush.Thumb}" StrokeThickness="0"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="th" Property="Fill" Value="{StaticResource Brush.ThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="th" Property="Fill" Value="{StaticResource Brush.ThumbActive}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- CheckBox (dark theme) -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="0,0,8,0">
              <Border x:Name="Box" CornerRadius="3"
                      Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"/>
              <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 15 5"
                      StrokeThickness="2" Stroke="#0A0A0A" Visibility="Collapsed"
                      StrokeEndLineCap="Square" StrokeLineJoin="Round"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbar theming per request: track = Background, thumb = #1A122B, hover = slightly lighter, border = #2B1F4A -->
  <SolidColorBrush x:Key="Brush.ScrollbarTrack" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="#2A2A50"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumbHover" Color="#3A3A66"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumbBorder" Color="#2B1F4A"/>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{StaticResource Brush.ScrollbarTrack}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   Minimum="0"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True"
                   Orientation="{TemplateBinding Orientation}">
              <!-- Buttons скрыты, но присутствуют для корректной разметки Track -->
              <Track.DecreaseRepeatButton>
                <RepeatButton Visibility="Collapsed"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb"
                       Background="{StaticResource Brush.ScrollbarThumb}"
                       BorderBrush="{StaticResource Brush.ScrollbarThumbBorder}"
                       BorderThickness="0"
                       Opacity="0.75">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThBase"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Visibility="Collapsed"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Thumb" Property="Background" Value="{StaticResource Brush.ScrollbarThumbHover}"/>
              <Setter TargetName="PART_Thumb" Property="Opacity" Value="0.9"/>
              <Setter TargetName="PART_Thumb" Property="BorderThickness" Value="1"/>
              <Setter TargetName="PART_Thumb" Property="BorderBrush" Value="{StaticResource Brush.ScrollbarThumbBorder}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="8"/>
              <Setter Property="Width" Value="Auto"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter Property="Width" Value="8"/>
              <Setter Property="Height" Value="Auto"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Window/Page background fallback -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Color.Background}"/>
</ResourceDictionary>
