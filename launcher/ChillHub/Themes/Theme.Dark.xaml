<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:ChillHub.Core.UI">
  <!-- Palette -->
  <!--
    ХОЛОДНАЯ НОЧЬ И ОДИН УГОЛЁК. Та же система, что у сайта и админки 2.0.

    Ушла связка «фиолетовый #7C5CFF на чёрном #0C0C10»: она читалась как самый
    расхожий признак наспех сделанного интерфейса и, что важнее, спорила с
    обложками игр — те стоят рядом и обязаны держать свой цвет.

    Глубина здесь набирается СВЕТЛОТОЙ, а не тенями: четыре ступени фона от
    страницы до третьей карточки. Тени остаются только у настоящих оверлеев,
    которые действительно висят над экраном.

    Каждая краска ниже проверена счётом на всех четырёх фонах, где встречается,
    а не подобрана на глаз. Цифры в комментариях — худший контраст из четырёх.
  -->
  <Color x:Key="Color.Background">#0E1114</Color>        <!-- фон окна -->
  <Color x:Key="Color.Surface">#14181D</Color>           <!-- карточка на фоне -->
  <Color x:Key="Color.Surface2">#1A2027</Color>          <!-- карточка на карточке -->
  <Color x:Key="Color.Surface3">#212932</Color>          <!-- поле ввода, дорожка -->
  <Color x:Key="Color.Border">#262E36</Color>
  <Color x:Key="Color.Border2">#384450</Color>
  <Color x:Key="Color.Border3">#4A5866</Color>           <!-- бегунок полосы под курсором -->           <!-- рамка под курсором -->
  <Color x:Key="Color.Text">#DDE2E6</Color>              <!-- 11,27 -->
  <Color x:Key="Color.TextSecondary">#98A3AC</Color>     <!-- 5,72 -->
  <!--
    #8A949D, а не #7A848D из палитры сайта. На сайте приглушённый текст не
    попадает на третью карточку, а здесь попадает — на #212932 он давал 3,86,
    ниже порога AA 4,5 для мелкого текста, а им набраны все подписи. #8A949D
    даёт 4,76 на самом светлом из фонов, на которых встречается.
  -->
  <Color x:Key="Color.TextMuted">#8A949D</Color>          <!-- подписи, «не установлена» -->
  <!--
    ДВА УГЛЯ, А НЕ ОДИН, И ВОТ ПОЧЕМУ.

    Color.Accent — краска ЗНАКА: полосы прогресса, проценты, рамка выбранной
    карточки, каретка караоке. Она стоит на тёмном фоне, и ей нужен контраст
    к нему: #E5825B даёт 5,38 на самом светлом фоне, а #D1663C — только 3,98.

    Color.AccentFill — краска ЗАЛИВКИ главной кнопки. Здесь наоборот: важен
    контраст подписи НА ней. На #D1663C тёмная подпись даёт 5,30, а белая —
    3,70, то есть белая порог не берёт. Поэтому подпись на заливке тёмная
    (Brush.OnAccent), и это единственное место, где текст темнее фона.
  -->
  <Color x:Key="Color.Accent">#E5825B</Color>
  <Color x:Key="Color.AccentHover">#F09A72</Color>
  <Color x:Key="Color.AccentFill">#D1663C</Color>
  <Color x:Key="Color.AccentFillHover">#E5825B</Color>
  <Color x:Key="Color.AccentFillPressed">#C25E37</Color>
  <Color x:Key="Color.OnAccent">#140904</Color>          <!-- подпись на заливке, 5,30 -->
  <!-- Выключенная главная кнопка: тёплая, но погасшая. Светлая подпись на ней
       (Brush.TextSecondary) читается, тёмная — нет, поэтому подпись у выключенной
       своя, см. триггеры IsEnabled в HomePage. -->
  <Color x:Key="Color.AccentFillDisabled">#33261F</Color>
  <!-- Пункт меню и выпадающего списка под курсором и в нажатии. Отдельные краски, а не
       Brush.Hover: тот совпадает с фоном самого меню, и наведение на пункт не было видно
       вовсе — список выглядел нерабочим. Взяты с запасом по светлоте (1,52 и 1,72 к фону
       меню): подсветка на грани различимости в списке из четырёх строк не отвечает на
       вопрос «на чём я сейчас». Тёплыми их не делаем — уголёк в интерфейсе один, и он
       занят главным действием. -->
  <Color x:Key="Color.MenuHover">#333F4A</Color>
  <Color x:Key="Color.MenuPressed">#3A4753</Color>
  <!-- Статусы игр: готова / нужно обновление / проблема. Все три проверены на четырёх
       фонах; краски сайта пришлось осветлить — #C0564D давал 3,28 на третьей карточке. -->
  <Color x:Key="Color.Success">#7DAB71</Color>            <!-- 5,56 -->
  <Color x:Key="Color.Warning">#BF9439</Color>            <!-- 5,26 -->
  <Color x:Key="Color.Danger">#D47A70</Color>             <!-- 4,77 -->
  <!-- Заливка опасной кнопки: приглушённый тёплый красный, заметный, но не спорящий
       с угольком главного действия. Светлая подпись на нём даёт 11,45. -->
  <Color x:Key="Color.DangerFill">#3A1F1C</Color>
  <Color x:Key="Color.DangerFillHover">#4A2925</Color>
  <Color x:Key="Color.DangerFillPressed">#5A332E</Color>
  <Color x:Key="Color.DangerFillDisabled">#241614</Color>
  <Color x:Key="Color.DangerText">#F0DCD9</Color>
  <Color x:Key="Color.Selection">#1A2027</Color>
  <!-- Заливка кнопки запуска без акцента. Полупрозрачная, потому что кнопка стоит
       на обложке игры: сплошная плашка вырезала бы из картинки прямоугольник. -->
  <Color x:Key="Color.GhostFill">#D91A2027</Color>
  <!-- Состояния -->
  <Color x:Key="Color.HeaderStart">#12161A</Color>
  <Color x:Key="Color.Hover">#1A2027</Color>
  <Color x:Key="Color.Pressed">#212932</Color>
  <Color x:Key="Color.BorderHover">#384450</Color>
  <Color x:Key="Color.BorderPressed">#384450</Color>
  <Color x:Key="Color.ListHover">#171C22</Color>
  <Color x:Key="Color.ListHoverAlt">#1A2027</Color>
  <Color x:Key="Color.Skeleton">#1A2027</Color>
  <!-- Слайдеры и полосы -->
  <Color x:Key="Color.Track">#212932</Color>
  <Color x:Key="Color.Thumb">#384450</Color>
  <!-- Три радиуса на всё приложение: мелкое, контролы, карточки. Были 6/8/12 — мягкое
       скругление «по умолчанию», за которое цепляется глаз. Стало 3/4/5: форма читается
       как инструмент, а не как карточка в ленте. -->
  <CornerRadius x:Key="Radius.S">3</CornerRadius>
  <CornerRadius x:Key="Radius.M">4</CornerRadius>
  <CornerRadius x:Key="Radius.L">5</CornerRadius>

  <!-- Brushes mapped to new Palette -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}"/>
  <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.Border2" Color="{StaticResource Color.Border2}"/>
  <SolidColorBrush x:Key="Brush.Border3" Color="{StaticResource Color.Border3}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
  <!-- Заголовки. Не чистый белый: самый светлый тон системы — Color.Text, и белее
       него на странице нет ничего. Чистый белый остался от прежней палитры. -->
  <SolidColorBrush x:Key="Brush.Title" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
  <SolidColorBrush x:Key="Brush.AccentFill" Color="{StaticResource Color.AccentFill}"/>
  <SolidColorBrush x:Key="Brush.AccentFillHover" Color="{StaticResource Color.AccentFillHover}"/>
  <SolidColorBrush x:Key="Brush.AccentFillPressed" Color="{StaticResource Color.AccentFillPressed}"/>
  <!-- Подпись на залитой кнопке: тёмная, потому что белая на угле не берёт порог. -->
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}"/>
  <SolidColorBrush x:Key="Brush.AccentFillDisabled" Color="{StaticResource Color.AccentFillDisabled}"/>
  <!-- Затемнение под настоящими оверлеями. Единственное место, где чёрный уместен:
       это не поверхность, а тень от неё на всём остальном. -->
  <SolidColorBrush x:Key="Brush.Scrim" Color="#C0000000"/>
  <SolidColorBrush x:Key="Brush.MenuHover" Color="{StaticResource Color.MenuHover}"/>
  <SolidColorBrush x:Key="Brush.MenuPressed" Color="{StaticResource Color.MenuPressed}"/>
  <!-- State brushes -->
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}"/>
  <SolidColorBrush x:Key="Brush.BorderHover" Color="{StaticResource Color.BorderHover}"/>
  <SolidColorBrush x:Key="Brush.BorderPressed" Color="{StaticResource Color.BorderPressed}"/>
  <SolidColorBrush x:Key="Brush.ListHover" Color="{StaticResource Color.ListHover}"/>
  <SolidColorBrush x:Key="Brush.ListHoverAlt" Color="{StaticResource Color.ListHoverAlt}"/>
  <SolidColorBrush x:Key="Brush.Skeleton" Color="{StaticResource Color.Skeleton}"/>
  <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}"/>
  <SolidColorBrush x:Key="Brush.Thumb" Color="{StaticResource Color.Thumb}"/>
  <!-- Semantic colors -->
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="Brush.GhostFill" Color="{StaticResource Color.GhostFill}"/>

  <!-- Шапка — ровная заливка. -->
  <SolidColorBrush x:Key="Brush.HeaderBg" Color="{StaticResource Color.HeaderStart}"/>

  <!-- Пунктирный прямоугольник фокуса Windows: выключен разом для всех элементов.

       Значение FocusVisualStyle по умолчанию — ссылка на ресурс с этим ключом, поэтому
       пустой шаблон здесь снимает рамку и с тех элементов, у которых своего стиля нет
       (например Border с Focusable="True" на карточке игры). Точечные сеттеры
       FocusVisualStyle="{x:Null}" в стилях ниже остаются: они дешевле, чем разбирать,
       какой из них теперь лишний.

       Через FrameworkElement.FocusVisualStyleProperty.OverrideMetadata это не делается:
       свойство объявлено самим FrameworkElement, метаданные для типа-владельца уже
       зарегистрированы, и вызов падает с ArgumentException. В статическом конструкторе
       App это роняло лаунчер до первой строки boot.log — версия 1.5.11 не запускалась
       вовсе. -->
  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
    <Setter Property="Template" Value="{x:Null}"/>
  </Style>

  <!-- TextBlock default -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ContextMenu and MenuItem dark theme -->
  <!-- Меню — скруглённая карточка с внутренним полем, пункты внутри тоже со скруглением:
       прямоугольник без полей с пунктами впритык к рамке был единственным «системным»
       элементом на экране среди карточек с радиусом 12. HasDropShadow выключен вместе с
       AllowsTransparency: системная тень рисуется квадратной и вылезает из-под углов. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.M}"
                  Margin="0,2,0,0"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <ItemsPresenter Margin="0"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Margin" Value="6,4,6,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource Brush.Border}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- Custom template without IconPresenter to avoid black icon placeholders -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.S}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <Grid>
              <ContentPresenter Margin="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                RecognizesAccessKey="True"
                                ContentSource="Header"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Подсветка — Brush.MenuHover, а не Brush.Hover: у второго ровно тот же
                 цвет, что у фона меню (Surface2), и наведение не было видно вообще —
                 список вариантов запуска выглядел неживым. Нажатие — ещё на ступень
                 светлее, иначе клик ничем не отзывается. -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.MenuHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.MenuPressed}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Разрушительный пункт меню («Удалить локальные файлы»): красный текст, чтобы его
       нельзя было принять за соседнее безобидное действие в списке одинаковых строк. -->
  <Style x:Key="Style.MenuItem.Danger" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
  </Style>

  <!-- ToolTip dark theme: ensure readable white text on dark background -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{StaticResource Radius.S}"
                  SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Removed glass brushes to avoid transparency -->

  <!-- Начальный сдвиг шиммера. Ресурс, а не число в разметке: Freezable внутри
       шаблона запечатывается вместе с ним, и анимировать путь
       RenderTransform.X на замороженном TranslateTransform WPF отказывается —
       "Не удается анимировать в постоянном экземпляре объекта". Ссылка на
       DynamicResource оставляет преобразование изменяемым. -->
  <sys:Double x:Key="Skeleton.ShimmerStartX">-300</sys:Double>

  <!-- Shimmer skeletons (dark, subtle) -->
  <Style x:Key="Style.Skeleton.NewsCard" TargetType="ContentControl">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid ClipToBounds="True">
            <Border CornerRadius="{StaticResource Radius.L}" Background="{DynamicResource Brush.Surface}" Opacity="0.35"/>
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00FFFFFF" Offset="0"/>
                  <GradientStop Color="#22FFFFFF" Offset="0.35"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
              <Rectangle.RenderTransform>
                <TranslateTransform X="{DynamicResource Skeleton.ShimmerStartX}"/>
              </Rectangle.RenderTransform>
              <!-- Анимация идёт по пути в RenderTransform самого прямоугольника: имя на
                   TranslateTransform (это Freezable) в namescope шаблона не попадает, и
                   Storyboard.TargetName на нём валит приложение. Поэтому и триггер живёт
                   в стиле прямоугольника — цель по умолчанию — он сам, TargetName не нужен.
                   Так же сделан Style.Skeleton.GameRow.

                   Двух пусков, а не одного, требует порядок событий. Одного Loaded мало:
                   карточку с пришедшей обложкой прячет Visibility.Collapsed, Unloaded при
                   этом не наступает, и шиммер каждой новости и каждой строки списка
                   крутился до самого выхода из лаунчера. Одного условия по видимости тоже
                   мало: действия триггера выполняются на ПЕРЕХОДЕ, а прямоугольник шаблона
                   рождается внутри уже видимого дерева — перехода не случается, и шиммер
                   не заводится вовсе. Поэтому Loaded заводит, а условие снимает и заводит
                   заново; в EnterActions пуск от Loada снимается, чтобы две одинаковые
                   анимации не тикали разом. -->
              <Rectangle.Style>
                <Style TargetType="Rectangle">
                  <Style.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard x:Name="NewsCardShimmerOnLoad">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-300" To="300" Duration="0:0:1.6"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static ui:UiAnimations.Instance}, Path=Enabled}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <MultiDataTrigger.EnterActions>
                        <RemoveStoryboard BeginStoryboardName="NewsCardShimmerOnLoad"/>
                        <BeginStoryboard x:Name="NewsCardShimmer">
                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-300" To="300" Duration="0:0:1.6"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </MultiDataTrigger.EnterActions>
                      <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="NewsCardShimmerOnLoad"/>
                        <RemoveStoryboard BeginStoryboardName="NewsCardShimmer"/>
                      </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Style.Skeleton.GameRow" TargetType="ContentControl">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid ClipToBounds="True">
            <Border CornerRadius="{StaticResource Radius.S}" Background="{DynamicResource Brush.Surface}" Opacity="0.35"/>
            <Rectangle x:Name="SkRect2">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00FFFFFF" Offset="0"/>
                  <GradientStop Color="#22FFFFFF" Offset="0.35"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
              <Rectangle.RenderTransform>
                <TranslateTransform X="{DynamicResource Skeleton.ShimmerStartX}"/>
              </Rectangle.RenderTransform>
              <!-- Условия, два пуска и причина — см. Style.Skeleton.NewsCard выше. -->
              <Rectangle.Style>
                <Style TargetType="Rectangle">
                  <Style.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard x:Name="GameRowShimmerOnLoad">
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-300" To="300" Duration="0:0:1.6"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static ui:UiAnimations.Instance}, Path=Enabled}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <MultiDataTrigger.EnterActions>
                        <RemoveStoryboard BeginStoryboardName="GameRowShimmerOnLoad"/>
                        <BeginStoryboard x:Name="GameRowShimmer">
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-300" To="300" Duration="0:0:1.6"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </MultiDataTrigger.EnterActions>
                      <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="GameRowShimmerOnLoad"/>
                        <RemoveStoryboard BeginStoryboardName="GameRowShimmer"/>
                      </MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Rectangle.Style>
            </Rectangle>
          </Grid>
          <ControlTemplate.Triggers>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Animated skeleton placeholder -->
  <Style x:Key="Style.Skeleton" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{StaticResource Brush.Skeleton}"/>
    <Setter Property="Height" Value="140"/>
    <Setter Property="Opacity" Value="0.55"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <!-- Пульс идёт, только пока скелетон в самом деле на экране. По Loaded/Unloaded он
           не выключался никогда: секции скелетонов прячут Visibility.Collapsed у родителя,
           а Unloaded при этом не наступает — десяток невидимых Border'ов крутил вечный
           клок анимации на UI-потоке всё время работы лаунчера, включая жизнь в трее.
           IsVisible снимает и скрытые секции, и спрятанное окно; UiAnimations.Enabled —
           свёрнутое в панель задач окно, у которого IsVisible остаётся истинной. -->
      <!-- Скелетоны секций стоят прямо в разметке страницы и въезжают в дерево вместе
           с ней: переход в «видно» у них случается всегда, поэтому одного условия
           достаточно. Шиммеры выше заводятся иначе — они рождаются из шаблона внутри
           уже видимого дерева, и им нужен отдельный пуск по Loaded. -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
          <Condition Binding="{Binding Source={x:Static ui:UiAnimations.Instance}, Path=Enabled}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions>
          <BeginStoryboard x:Name="SkeletonPulse">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:1.1"/>
            </Storyboard>
          </BeginStoryboard>
        </MultiDataTrigger.EnterActions>
        <MultiDataTrigger.ExitActions>
          <RemoveStoryboard BeginStoryboardName="SkeletonPulse"/>
        </MultiDataTrigger.ExitActions>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Гасит системную пунктирную рамку фокуса по Tab на элементах, у которых нет
       своего implicit-стиля ниже. Button/TextBox/ComboBox и остальные со своим
       стилем это правило не увидят — им та же настройка проставлена в их
       собственных стилях; здесь — страховка для всего, что появится позже. -->
  <Style TargetType="Control">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- Window/Page background -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
  </Style>
  <Style TargetType="Page">
    <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
  </Style>

  <!-- Button modern -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <!-- Кнопки — единственный часто табаемый элемент, у которого не было своего
         шаблона: остальные (TextBox, ComboBox, ListBox…) уже гасят рамку ниже
         по файлу, а Button рисовал системный пунктирный прямоугольник поверх
         тёмной темы. -->
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary button (e.g., Play) -->
  <Style x:Key="Style.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentFill}"/>
    <!-- Подпись тёмная, а не белая: на угле #D1663C тёмная даёт 5,30, белая — 3,70,
         то есть порог AA 4,5 белая не берёт. См. Color.AccentFill. -->
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentFillHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AccentFillPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Вторичная кнопка. Жила тремя одинаковыми копиями — в HomePage, в GamePage под
       именем Style.Button.GameGhost и в UpdateWindow, — и расходилась в мелочах от
       копии к копии. Теперь одна на всё приложение. -->
  <!-- Кнопка-ссылка: только текст, без рамки и заливки. Для действий, которые лишь
       разворачивают уже показанное («Показать ещё N» под очередью) — рамка и фон делали
       бы из них ещё одну кнопку в ряду настоящих. -->
  <Style x:Key="Style.Button.Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Style.Button.GhostNeutral" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Опасная кнопка («Отмена» закачки): приглушённая красная заливка с красной рамкой.
       Одна на всё приложение — раньше главная красила отмену так, а страница игры
       показывала её ТОЙ ЖЕ фиолетовой заливкой, что и «Установить»: остановить закачку
       и начать её выглядели одинаково. -->
  <SolidColorBrush x:Key="Brush.DangerFill" Color="{StaticResource Color.DangerFill}"/>
  <SolidColorBrush x:Key="Brush.DangerFillHover" Color="{StaticResource Color.DangerFillHover}"/>
  <SolidColorBrush x:Key="Brush.DangerFillPressed" Color="{StaticResource Color.DangerFillPressed}"/>
  <SolidColorBrush x:Key="Brush.DangerFillDisabled" Color="{StaticResource Color.DangerFillDisabled}"/>
  <SolidColorBrush x:Key="Brush.DangerText" Color="{StaticResource Color.DangerText}"/>
  <Style x:Key="Style.Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Brush.DangerFill}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.DangerText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerFillHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerFillPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Кнопка-значок без рамки (стрелки и крестик в очереди, «обновить» у лент): в покое
       только серый глиф, под курсором — мягкая подложка и белый глиф. Опасный вариант
       (снять с очереди) под курсором краснеет, чтобы отличаться от перестановки рядом. -->
  <Style x:Key="Style.Button.QueueIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Style.Button.QueueIcon.Danger" TargetType="Button" BasedOn="{StaticResource Style.Button.QueueIcon}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerFill}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.DangerFillHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- «Назад» на всех вложенных экранах: одна кнопка, слева, со стрелкой. Раньше их
       было три разных — на странице игры без стрелки слева, в новости другой ширины
       слева, в настройках со стрелкой и СПРАВА, — и возврат каждый раз искали заново. -->
  <Style x:Key="Style.Button.Back" TargetType="Button" BasedOn="{StaticResource Style.Button.GhostNeutral}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <!-- Содержимое — через шаблон, а не готовый StackPanel в Setter Content: элемент
         в сеттере один на весь стиль, его получает первая кнопка, а на остальных
         страницах (игра, новость) кнопка оставалась пустой рамкой. -->
    <Setter Property="Content" Value="Назад"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Заголовок вложенного экрана -->
  <Style x:Key="Style.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <!-- TextBox / ComboBox / ListBox -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- Поле формы: рамка, подсветка фокуса и подсказка ВНУТРИ шаблона.
       Подсказка стояла отдельной надписью поверх поля, в соседней ячейке той же сетки, и
       её отступы подбирались руками под отступы поля. Совпадение держалось на честном
       слове и не держалось: подсказку сетка ставила по своему краю, а текст поля живёт
       внутри рамки и Padding, — после клика каретка появлялась не там, где стояла
       подсказка. Здесь у обеих одна рамка, один Padding, один шрифт и одно выравнивание,
       так что промахнуться нечем. Текст подсказки — в Placeholder.Text у самого поля. -->
  <ui:CaretInsetConverter x:Key="CaretInsetConv"/>
  <ControlTemplate x:Key="Template.TextBox.Field" TargetType="TextBox">
    <Border x:Name="bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource Radius.M}"
            SnapsToDevicePixels="True">
      <Grid>
        <!-- Отступы подсказки — Padding поля плюс отступ каретки: WPF держит внутри
             области содержимого TextBoxView со своими 2px по бокам, и подсказка, набитая
             ровно по Padding, вставала левее первого символа. -->
        <TextBlock x:Name="Hint" Visibility="Collapsed" IsHitTestVisible="False"
                   Text="{Binding Path=(ui:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                   Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent},
                                    Converter={StaticResource CaretInsetConv}}"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                   Foreground="{DynamicResource Brush.TextMuted}"/>
        <!-- Padding сюда НЕ пробрасываем: TextBoxBase сам ставит его области содержимого,
             и связка Margin="{TemplateBinding Padding}" применяла отступ дважды — текст
             начинался на 8px правее подсказки, ровно на ширину отступа. -->
        <ScrollViewer x:Name="PART_ContentHost"
                      Focusable="False"
                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Auto"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <!-- Подсказка видна ТОЛЬКО у пустого поля: иначе она оставалась поверх набранного
           текста, стоило увести фокус. -->
      <Trigger Property="Text" Value="">
        <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
      </Trigger>
      <!-- Фокус — акцентом: в форме четыре поля подряд, и без подсветки непонятно,
           куда именно попадёт набранный текст. -->
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.6"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Однострочное поле формы. Margin="0" обязателен: базовый стиль задаёт полям
       Margin="0,0,8,0", и без сброса правая колонка формы уезжала на эти 8px от края
       карточки. Padding="8,0" + рамка = 9px до текста — ровно столько же отступает
       ContentSite в шаблоне ComboBox, поэтому «Имя», «Контакт» и «Тип» начинаются по
       одной линии. -->
  <Style x:Key="Style.TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Template" Value="{StaticResource Template.TextBox.Field}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
  </Style>

  <!-- Многострочное поле: та же рамка, но текст с верхнего края и перенос по словам. -->
  <Style x:Key="Style.TextBox.Field.Multiline" TargetType="TextBox" BasedOn="{StaticResource Style.TextBox.Field}">
    <Setter Property="Height" Value="Auto"/>
    <Setter Property="Padding" Value="8,8"/>
    <Setter Property="MinHeight" Value="120"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ScrollViewer.Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <!-- Тот же радиус, что у кнопок и полей ввода: 4px рядом с ними читался как чужой -->
            <Border x:Name="Bd" CornerRadius="{StaticResource Radius.M}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"/>
            <!-- ToggleButton покрывает весь контрол, так что клик по любому месту открывает список -->
            <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          ClickMode="Press" Focusable="False">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="BorderBrush" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tb" Property="BorderBrush" Value="{StaticResource Brush.BorderPressed}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="Transparent"/>
                      <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="8,2,4,2" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
              <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,4,0,0">
                <Border Background="{StaticResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderHover}" BorderThickness="1" CornerRadius="{StaticResource Radius.M}" Padding="4">
                  <ScrollViewer CanContentScroll="True" Background="Transparent">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ComboBox dropdown item styling (override template to avoid blue focus) -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <!-- Наведение — нейтральная подсветка, как у пунктов меню; акцентом отмечен только
         выбранный пункт. Раньше и наведение, и выбор красились одним фиолетовым, и в
         списке из четырёх строк две выглядели «выбранными». -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.S}">
            <ContentPresenter Margin="6,2" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Brush.MenuHover, а не Brush.Hover: выпадающий список стоит на Surface2, и
                 подсветка того же цвета была невидима — ровно та же беда, что и у пунктов
                 меню вариантов запуска. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.MenuHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <!-- Некоторые системные шаблоны подсвечивают IsHighlighted для текущего элемента -->
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.MenuHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentFill}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentFillHover}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Influence system dropdown colors used by default templates -->
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <!-- Use neutral selection for default templates instead of blue accent -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource Color.Background}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Color.Selection}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
  <!-- Extra mappings to neutralize any blue from default templates -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{StaticResource Color.ListHover}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="{StaticResource Color.ListHover}"/>

  <!-- Override system scrollbar dimensions so default templates (which bind to SystemParameters) use 3px -->
  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">8</sys:Double>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.ListHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Карточки: радиус 12, рамка ровно 1px. Полуторапиксельная рамка на дробном DPI
       давала то одну, то две линии — отсюда «разная толщина» соседних карточек. -->
  <Style x:Key="Style.Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Style.Section" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
  </Style>
  <!-- Bordered panel for progress bar + caption -->
  <Style x:Key="Style.ProgressPanel" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Track}"/>
  </Style>

  <!-- Ползунок: дорожка 4px, заполненная часть — акцент, бегунок — светлый круг с
       акцентным кольцом, под курсором и при перетаскивании кольцо ярче и бегунок чуть
       больше. Прежний бегунок был тёмно-серым кругом на тёмной же дорожке —
       его приходилось искать, а заполнение уезжало под бегунок отрицательным отступом. -->
  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
    <Setter Property="Background" Value="{StaticResource Brush.Track}"/>
    <Setter Property="MinHeight" Value="28"/>
    <!-- Щелчок по дорожке ставит бегунок под курсор, а не сдвигает его на одно деление -->
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center" MinHeight="{TemplateBinding MinHeight}">
            <!-- Дорожка на всю ширину, с полями под половину бегунка -->
            <Border Height="4" CornerRadius="2" Margin="10,0" VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"/>
            <Track x:Name="PART_Track" Margin="10,0"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   IsDirectionReversed="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Focusable="False" Cursor="Hand" Command="Slider.DecreaseLarge">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <!-- Заполненная часть; -10 справа заводит её под центр бегунка -->
                      <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="-10,0,-10,0"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                      </Grid>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Focusable="False" Cursor="Hand" Command="Slider.IncreaseLarge">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Grid Background="Transparent"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="20" Height="20" FocusVisualStyle="{x:Null}" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Ellipse x:Name="ring" Width="16" Height="16"
                                 Fill="{StaticResource Brush.Text}"
                                 Stroke="{StaticResource Brush.Accent}" StrokeThickness="3"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ring" Property="Width" Value="18"/>
                          <Setter TargetName="ring" Property="Height" Value="18"/>
                          <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ring" Property="Width" Value="20"/>
                          <Setter TargetName="ring" Property="Height" Value="20"/>
                          <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Brush.AccentHover}"/>
                          <Setter TargetName="ring" Property="Fill" Value="#FFFFFF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- CheckBox (dark theme) -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="0,0,8,0">
              <Border x:Name="Box" CornerRadius="3"
                      Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1"/>
              <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 15 5"
                      StrokeThickness="2" Stroke="{DynamicResource Brush.Background}" Visibility="Collapsed"
                      StrokeEndLineCap="Square" StrokeLineJoin="Round"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Hover}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Полоса прокрутки в духе overlay-скроллбаров: дорожка прозрачная, бегунок — тонкая
       полупрозрачная пилюля, которая наливается цветом только под курсором. Прежняя
       серая дорожка во всю высоту ленты читалась как отдельная колонка интерфейса. -->
  <SolidColorBrush x:Key="Brush.ScrollbarTrack" Color="Transparent"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="{StaticResource Color.Border2}"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumbHover" Color="{StaticResource Color.Border3}"/>
  <SolidColorBrush x:Key="Brush.ScrollbarThumbBorder" Color="{StaticResource Color.Border}"/>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{StaticResource Brush.ScrollbarTrack}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track"
                   Minimum="0"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   IsDirectionReversed="True"
                   Orientation="{TemplateBinding Orientation}">
              <!-- Buttons скрыты, но присутствуют для корректной разметки Track -->
              <Track.DecreaseRepeatButton>
                <RepeatButton Visibility="Collapsed"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <!-- В покое бегунок почти не виден (0.35): на главной вертикальных полос
                     сразу три — список игр, лента новостей, очередь, — и в прежней
                     четверти яркости они рисовали три светлые черты поперёк экрана.
                     Под курсором полоса проявляется целиком. -->
                <Thumb x:Name="PART_Thumb"
                       Background="{StaticResource Brush.ScrollbarThumb}"
                       BorderBrush="{StaticResource Brush.ScrollbarThumbBorder}"
                       BorderThickness="0"
                       Opacity="0.35">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <!-- Отступ по 2px с боков: бегунок 4px внутри дорожки 8px, а под
                           курсором дорожка целиком остаётся зоной захвата -->
                      <Border x:Name="ThBase"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Margin="2"
                              CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Visibility="Collapsed"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Thumb" Property="Background" Value="{StaticResource Brush.ScrollbarThumbHover}"/>
              <Setter TargetName="PART_Thumb" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="8"/>
              <Setter Property="Width" Value="Auto"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter Property="Width" Value="8"/>
              <Setter Property="Height" Value="Auto"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Window/Page background fallback -->

  <!-- Затемнение поверх обложки, чтобы заголовок читался на любой картинке -->
  <!-- Затемнение легче прежнего (0.45 → #66, низ #E6): вместе с Opacity=0.5 самой обложки
       картинка гасла почти целиком, и витрина превращалась в тёмно-серую плашку с
       текстом. Теперь читаемость текста держит нижняя половина и левый край, а верх и
       правая часть отдают обложку как есть. -->
  <LinearGradientBrush x:Key="Brush.HeroScrim" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#00000000"/>
    <GradientStop Offset="0.5" Color="#33000000"/>
    <GradientStop Offset="1" Color="#CC0E1114"/>
  </LinearGradientBrush>
  <!-- Второй слой затемнения — слева направо, под заголовок и кнопку в левом нижнем углу.
       Правая половина обложки остаётся почти нетронутой: там обычно логотип игры. -->
  <LinearGradientBrush x:Key="Brush.HeroScrimSide" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#990E1114"/>
    <GradientStop Offset="0.5" Color="#260E1114"/>
    <GradientStop Offset="1" Color="#000E1114"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.HeroBadge.Bg" Color="{StaticResource Color.Surface2}"/>
  <SolidColorBrush x:Key="Brush.HeroBadge.Border" Color="{StaticResource Color.Border}"/>

  <!-- Кнопка сведений об игре на витрине: полупрозрачная «стеклянная» кнопка с текстом.
       Круглая ⓘ без подписи читалась как подсказка, а не как переход на страницу игры. -->
  <!-- «Об игре» — спутник кнопки действия, а не её ровня: обычное начертание, вторичный
       цвет и рамка потише. Прежние SemiBold, светлая рамка и заливка давали ей тот же вес,
       что и главной кнопке, а в состояниях без заливки («Убрать из очереди», «Проверка…»)
       она перевешивала — глаз выбирал справочный экран вместо действия.
       Заливка при этом ОБЯЗАНА быть: кнопка стоит на обложке игры, и полностью прозрачной
       она разваливалась на светлых картинках — рамка и подпись висели прямо на песке и
       небе, без подложки под текстом. Та же полупрозрачная подложка, что у «стеклянной»
       кнопки запуска рядом. -->
  <Style x:Key="Style.Button.HeroInfo" TargetType="Button">
    <Setter Property="Height" Value="42"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="#99101017"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Вкладки под витриной: подчёркивание, а не залитая пилюля. Пилюля весом спорила с
       главной кнопкой действия — две крашенные акцентом плашки рядом, и обе «главные». -->
  <Style x:Key="Style.Button.HeroTab" TargetType="ToggleButton">
    <Setter Property="Padding" Value="2,0,2,8"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                  BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
