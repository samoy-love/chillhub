<Window x:Class="ChillHub.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chill Hub — обновление" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="600" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
  <Grid Margin="16">
    <Grid.Resources>
      <!-- Override accent within this window to secondary (purple) so CheckBox checked state is purple like 'Играть' -->
      <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.SecondaryAccent}"/>
      <!-- Make hover state pink (use the pink stop of the current gradient) -->
      <SolidColorBrush x:Key="Brush.AccentHover" Color="#8A2A4A"/>
      <!-- Darker primary gradient for 'Обновить и перезапустить' -->
      <LinearGradientBrush x:Key="Brush.AccentGradientPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3A2966"/>
        <GradientStop Offset="1" Color="#8A2A4A"/>
      </LinearGradientBrush>
      <!-- Progress visuals shared brushes (copied from HomePage) -->
      <SolidColorBrush x:Key="Brush.ProgressBorder" Color="#2B1F4A"/>
      <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#1A122B"/>
      <!-- Verify indicator gradient (copied from HomePage) -->
      <LinearGradientBrush x:Key="Brush.VerifyGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#6F3AFF"/>
        <GradientStop Offset="1" Color="#A78BFA"/>
      </LinearGradientBrush>
      <!-- Local Primary style to ensure hover uses our local AccentHover (avoids StaticResource capture in theme) -->
      <Style x:Key="Style.Button.PrimaryLocal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPrimary}"/>
        <Setter Property="Foreground" Value="#0A0A0A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" CornerRadius="{StaticResource Radius.M}" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                  <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Neutral ghost button style (outline) -->
      <!-- ProgressBar styles copied from HomePage (sizes removed) -->
      <Style x:Key="Style.ProgressBar.Verify" TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid ClipToBounds="True">
                <Border CornerRadius="3" Background="{DynamicResource Brush.Border}"/>
                <!-- Animated indicator for indeterminate state -->
                <Border x:Name="IndBar" CornerRadius="3" Width="160" HorizontalAlignment="Left" Background="{StaticResource Brush.VerifyGradient}">
                  <Border.RenderTransform>
                    <TranslateTransform X="-180"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsIndeterminate" Value="True">
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="IndBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-180" To="300" Duration="0:0:1.8"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Style.ProgressBar.Rounded" TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid ClipToBounds="True">
                <!-- Track with thick dark border and dark background; named PART_Track so WPF wires it -->
                <Border x:Name="PART_Track" CornerRadius="6" BorderThickness="2.5"
                        Background="{DynamicResource Brush.ProgressTrack}" BorderBrush="{DynamicResource Brush.ProgressBorder}"/>
                <!-- Indicator; named PART_Indicator so WPF sets width automatically for determinate mode -->
                <Border x:Name="PART_Indicator" CornerRadius="6" Background="{DynamicResource Brush.AccentGradientPrimary}"
                        HorizontalAlignment="Left"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Проверка обновления лаунчера" FontSize="18" Margin="0,0,0,8"/>

    <StackPanel Grid.Row="1">
      <TextBlock x:Name="StatusText" Text="Инициализация..." TextWrapping="Wrap" Margin="0,0,0,8"/>
      <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" Style="{DynamicResource Style.ProgressBar.Rounded}"/>
      <StackPanel x:Name="DevPanel">
        <Border Background="{DynamicResource Brush.Surface}" Padding="8" CornerRadius="6" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <TextBlock Text="Для разработки можно пропустить проверку. Отметьте флаг ниже и нажмите 'Продолжить'."
                     Foreground="{DynamicResource Brush.TextSecondary}"/>
        </Border>
        <CheckBox x:Name="DevSkipCheck" Content="Пропустить проверку (DEV)" Foreground="{DynamicResource Brush.Text}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="PrimaryBtn" Content="Обновить и перезапустить" MinWidth="200" Height="36" FontSize="13" FontWeight="SemiBold" Padding="12,6" Click="PrimaryBtn_Click" Margin="0,0,8,0" HorizontalAlignment="Right" Style="{DynamicResource Style.Button.PrimaryLocal}"/>
      <Button Content="Выход" Width="120" Height="36" FontSize="13" FontWeight="SemiBold" Padding="12,6" Click="ExitBtn_Click" Style="{DynamicResource Style.Button.GhostNeutral}"/>
    </StackPanel>
  </Grid>
</Window>

