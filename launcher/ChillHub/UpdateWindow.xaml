<Window x:Class="ChillHub.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chill Hub — обновление" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="600" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
  <Grid Margin="16">
    <Grid.Resources>
      <!-- СВОЕЙ ПАЛИТРЫ У ЭТОГО ОКНА БОЛЬШЕ НЕТ.
           Здесь жили розово-фиолетовый градиент кнопки, розовое наведение (#8A2A4A) и
           отдельный градиент индикатора — осколки палитры, от которой лаунчер отказался:
           в теме остался ОДИН акцент, и «Обновить и перезапустить» обязана выглядеть той
           же главной кнопкой, что «Играть» и «Установить». Окно обновления — первое, что
           видит человек при запуске, и оно же было единственным, где приложение выглядело
           чужим самому себе.
           Полосы прогресса берут краски из темы по тем же именам, что и главный экран. -->
      <SolidColorBrush x:Key="Brush.ProgressBorder" Color="{DynamicResource Color.Border}"/>
      <SolidColorBrush x:Key="Brush.ProgressTrack" Color="{DynamicResource Color.Track}"/>
      <SolidColorBrush x:Key="Brush.VerifyFill" Color="{DynamicResource Color.Accent}"/>
      <!-- Neutral ghost button style (outline) -->
      <!-- ProgressBar styles copied from HomePage (sizes removed) -->
      <Style x:Key="Style.ProgressBar.Verify" TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid ClipToBounds="True">
                <Border CornerRadius="3" Background="{DynamicResource Brush.Border}"/>
                <!-- Animated indicator for indeterminate state -->
                <Border x:Name="IndBar" CornerRadius="3" Width="160" HorizontalAlignment="Left" Background="{StaticResource Brush.VerifyFill}">
                  <Border.RenderTransform>
                    <TranslateTransform X="-180"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Остановка обязательна: EnterActions без ExitActions оставляют бегунок
                     крутиться и после того, как полоса стала определённой. -->
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsIndeterminate" Value="True"/>
                    <Condition Property="IsVisible" Value="True"/>
                  </MultiTrigger.Conditions>
                  <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="UpdateVerifyRun">
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="IndBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-180" To="300" Duration="0:0:1.8"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </MultiTrigger.EnterActions>
                  <MultiTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="UpdateVerifyRun"/>
                  </MultiTrigger.ExitActions>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Style.ProgressBar.Rounded" TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid ClipToBounds="True">
                <!-- Track with thick dark border and dark background; named PART_Track so WPF wires it -->
                <Border x:Name="PART_Track" CornerRadius="{DynamicResource Radius.S}" BorderThickness="2.5"
                        Background="{DynamicResource Brush.ProgressTrack}" BorderBrush="{DynamicResource Brush.ProgressBorder}"/>
                <!-- Indicator; named PART_Indicator so WPF sets width automatically for determinate mode -->
                <Border x:Name="PART_Indicator" CornerRadius="{DynamicResource Radius.S}" Background="{DynamicResource Brush.AccentFill}"
                        HorizontalAlignment="Left"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Проверка обновления лаунчера" FontSize="18" Margin="0,0,0,8"/>

    <StackPanel Grid.Row="1">
      <TextBlock x:Name="StatusText" Text="Проверяем, есть ли новая версия…" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <!-- Полоса скрыта до первой работы: до этого она стояла пустой дорожкой под любым
           сообщением окна, в том числе под сообщением об ошибке, и выглядела застрявшей
           загрузкой. Видимостью управляет ApplyUiState. -->
      <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"
                   Visibility="Collapsed" Style="{DynamicResource Style.ProgressBar.Rounded}"/>
      <StackPanel x:Name="DevPanel">
        <Border Background="{DynamicResource Brush.Surface}" Padding="8" CornerRadius="{DynamicResource Radius.S}" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <TextBlock Text="Для разработки можно пропустить проверку. Отметьте флаг ниже и нажмите 'Продолжить'."
                     Foreground="{DynamicResource Brush.TextSecondary}"/>
        </Border>
        <CheckBox x:Name="DevSkipCheck" Content="Пропустить проверку (DEV)" Foreground="{DynamicResource Brush.Text}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="PrimaryBtn" Content="Обновить и перезапустить" MinWidth="200" Height="36" FontSize="13" FontWeight="SemiBold" Padding="12,6" Click="PrimaryBtn_Click" Margin="0,0,8,0" HorizontalAlignment="Right" Style="{DynamicResource Style.Button.Primary}"/>
      <Button Content="Выход" Width="120" Height="36" FontSize="13" FontWeight="SemiBold" Padding="12,6" Click="ExitBtn_Click" Style="{DynamicResource Style.Button.GhostNeutral}"/>
    </StackPanel>
  </Grid>
</Window>

