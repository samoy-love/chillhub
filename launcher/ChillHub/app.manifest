<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ChillHub.app" />

  <!-- Права администратора не нужны и не запрашиваются: лаунчер пишет только в
       %APPDATA% и в выбранную пользователем папку игр. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- ЗАЧЕМ: без longPathAware Win32 обрезает пути на 260 символах. У игр с глубокой
           вложенностью (движковые ассеты внутри папки игры внутри выбранной пользователем
           папки) это выстреливало уже ПОСЛЕ скачивания — на File.Move в фазе активации,
           когда трафик потрачен, а обновление всё равно падало.
           dpiAware намеренно не задан: WPF остаётся в поведении по умолчанию. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
