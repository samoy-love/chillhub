<Page x:Class="ChillHub.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки"
      Background="{DynamicResource Brush.Background}">
  <Grid Margin="16">
    <Grid.Resources>
      <!-- Make page-local accent purple (same as Play secondary accent) so Slider uses it -->
      <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.SecondaryAccent}"/>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Title}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Name="BackBtn" Click="BackBtn_Click" Width="120" HorizontalAlignment="Right" Padding="12,8" MinHeight="36" Margin="12,0,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" Margin="0,0,6,0"/>
          <TextBlock Text="Назад"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Content -->
    <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top">
      <!-- Thin divider under header -->
      <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14"/>
      <!-- Storage section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Папка для установки игр" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Путь" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="GamesPathBox" Margin="12,0,12,0" MinHeight="32"/>
            <Button Grid.Column="2" Name="ChooseBtn" Content="Выбрать" Click="ChooseBtn_Click" Padding="12,8" MinHeight="36" MinWidth="110"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Download section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Скачивание" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Потоки" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Name="ThreadsSlider" Minimum="2" Maximum="16" Width="260" Margin="12,0,10,0"
                    TickFrequency="1" IsSnapToTickEnabled="true" ValueChanged="ThreadsSlider_ValueChanged"/>
            <TextBlock Grid.Column="2" Name="ThreadsValueText" Text="8" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Integrity section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,14,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Целостность игры" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     Text="Сверяет установленные файлы с последней опубликованной версией. Все файлы читаются заново, поэтому проверка может занять несколько минут."/>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Игра" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Name="IntegrityGameBox" Margin="12,0,12,0" MinHeight="32"
                      DisplayMemberPath="Title"/>
            <Button Grid.Column="2" Name="IntegrityCheckBtn" Content="Проверить" Click="IntegrityCheckBtn_Click"
                    Padding="12,8" MinHeight="36" MinWidth="110"/>
          </Grid>
          <Grid Grid.Row="3" Name="IntegrityProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Name="IntegrityProgress" Height="8" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Name="IntegrityCancelBtn" Content="Отмена" Click="IntegrityCancelBtn_Click"
                    Margin="12,0,0,0" Padding="12,6" MinHeight="32" MinWidth="90"/>
          </Grid>
          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="IntegrityStatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
            <Button Grid.Column="1" Name="IntegrityRepairBtn" Content="Восстановить" Click="IntegrityRepairBtn_Click"
                    Visibility="Collapsed" Margin="12,0,0,0" Padding="12,8" MinHeight="36" MinWidth="140"
                    Style="{DynamicResource Style.Button.Primary}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Privacy section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,14,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Конфиденциальность" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
            <CheckBox Name="AutoErrorReportsCheck" Content="Отправлять автоматические отчёты об ошибках"/>
            <TextBlock Text="Включает отправку необработанных исключений вместе с логами, конфигурацией и именем компьютера. Ручная отправка обратной связи работает всегда."
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Integrations section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Интеграции" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
            <CheckBox Name="DiscordRpcCheck" Content="Показывать в Discord, во что вы играете"/>
            <TextBlock Text="Discord будет показывать название игры, версию сборки и время сессии в вашем статусе. Работает, только если Discord запущен на этом компьютере."
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <!-- Текст задаётся в коде: пока владелец не подставил Application ID, интеграция не активируется -->
            <TextBlock Name="DiscordRpcHintText" Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- About / diagnostics section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="О программе" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Версия лаунчера" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="VersionText" Text="—" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <Button Grid.Row="2" Name="OpenLogsBtn" Content="Открыть папку с логами" Click="OpenLogsBtn_Click"
                  HorizontalAlignment="Left" Padding="12,8" MinHeight="36" MinWidth="200" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Footer actions -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Grid.Column="1">
        <Button Name="SaveBtn" Content="Сохранить" Style="{DynamicResource Style.Button.Primary}" Click="SaveBtn_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
