<Page x:Class="ChillHub.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки"
      Background="{DynamicResource Brush.Background}">
  <!-- Локальной подмены Brush.Accent здесь больше нет: страница перекрашивала акцент
       в другой оттенок, и слайдеры с чекбоксами настроек отличались по цвету от всего
       остального приложения. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <!-- «Назад» слева, заголовок следом — как на странице игры и в новости. Раньше
         кнопка стояла справа, и на трёх экранах возврат был в трёх разных местах. -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Name="BackBtn" Style="{DynamicResource Style.Button.Back}" Click="BackBtn_Click"/>
      <TextBlock Grid.Column="1" Text="Настройки" Style="{DynamicResource Style.PageTitle}" Margin="16,0,0,0"/>
    </Grid>

    <!-- Content. Обёрнуто в ScrollViewer: на невысоком окне карточки не влезают
         по вертикали — без прокрутки «Конфиденциальность» и всё, что ниже,
         просто обрезалось по низу страницы. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Vertical" VerticalAlignment="Top">
      <!-- Thin divider under header -->
      <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,14"/>
      <!-- Storage section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Папка для установки игр" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Путь" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="GamesPathBox" Margin="12,0,12,0" MinHeight="32"/>
            <Button Grid.Column="2" Name="ChooseBtn" Content="Выбрать" Click="ChooseBtn_Click" Padding="12,8" MinHeight="36" MinWidth="110"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Download section. Потоки и лимит скорости живут в одной карточке: обе
           настройки правят одну и ту же закачку, и разносить их по двум блокам
           значило заставлять читателя искать вторую половину одного решения. -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Скачивание" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Потоки" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Name="ThreadsSlider" Minimum="2" Maximum="16" Width="260" Margin="12,0,10,0"
                    TickFrequency="1" IsSnapToTickEnabled="true" ValueChanged="ThreadsSlider_ValueChanged"/>
            <TextBlock Grid.Column="2" Name="ThreadsValueText" Text="8" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Скорость загрузки" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" Name="SpeedLimitSlider" Minimum="0" Maximum="10" Width="260" Margin="12,0,10,0"
                    TickFrequency="1" IsSnapToTickEnabled="true" ValueChanged="SpeedLimitSlider_ValueChanged"/>
            <TextBlock Grid.Column="2" Name="SpeedLimitValueText" Text="без лимита" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Privacy section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Конфиденциальность" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
            <CheckBox Name="AutoErrorReportsCheck" Content="Отправлять автоматические отчёты об ошибках"/>
            <TextBlock Text="Включает отправку необработанных исключений вместе с логами и конфигурацией. Пути сокращаются, имя пользователя и имя компьютера не передаются. Ручная отправка обратной связи работает всегда."
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <CheckBox Name="UsageMetricsCheck" Content="Отправлять обезличенную статистику использования" Margin="0,12,0,0"/>
            <TextBlock Text="Запуски лаунчера, установки и обновления игр, коды ошибок. Без имени пользователя, имени компьютера и путей."
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Tray section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Трей" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,8,0,0">
            <CheckBox Name="MinimizeToTrayCheck" Content="Сворачивать в трей вместо закрытия"/>
            <TextBlock Text="Крестик и Alt+F4 будут прятать окно в трей вместо выхода. Полностью завершить работу лаунчера можно из меню значка в трее."
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- About / diagnostics section -->
      <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="О программе" FontWeight="SemiBold"/>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Версия лаунчера" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Name="VersionText" Text="—" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <Button Grid.Row="2" Name="OpenLogsBtn" Content="Открыть папку с логами" Click="OpenLogsBtn_Click"
                  HorizontalAlignment="Left" Padding="12,8" MinHeight="36" MinWidth="200" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </StackPanel>
    </ScrollViewer>

    <!-- Панель действия. Отделена линией и залита фоном страницы: без них список
         настроек проезжал прямо под кнопкой «Сохранить», и та висела поверх текста. -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0"
            Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <Button Name="SaveBtn" Content="Сохранить" HorizontalAlignment="Right"
              Style="{DynamicResource Style.Button.Primary}" Click="SaveBtn_Click"/>
    </Border>
  </Grid>
</Page>
