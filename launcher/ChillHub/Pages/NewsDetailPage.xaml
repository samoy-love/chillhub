<Page x:Class="ChillHub.Pages.NewsDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Новость"
      Background="{DynamicResource Brush.Background}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
      <Button Name="BackBtn" Content="Назад" Width="100" Click="BackBtn_Click"
              Background="{DynamicResource Brush.Surface}"
              Foreground="{DynamicResource Brush.Text}"
              BorderBrush="{DynamicResource Brush.Border}"/>
      <TextBlock Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <!-- Main content (browser) -->
      <wv2:WebView2 Name="Browser"/>
      <!-- Запасное сообщение: показывается, если WebView2 вообще не удалось поднять
           (тогда NavigateToString недоступен и окно осталось бы пустым) -->
      <Border Name="ErrorPanel" Visibility="Collapsed"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="8" Padding="20" MaxWidth="620"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Не удалось открыть новость" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Title}" TextWrapping="Wrap"/>
          <TextBlock Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
