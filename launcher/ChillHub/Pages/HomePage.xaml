<Page x:Class="ChillHub.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:pr="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      Title="Главная"
      Background="{DynamicResource Brush.Background}">
  <Page.Resources>
    <!-- Base dim colors -->
    <!-- Play state uses logo's purple (secondary accent family) -->
    <SolidColorBrush x:Key="Btn.Play.Bg" Color="#6F3AFF"/>
    <SolidColorBrush x:Key="Btn.Play.Bg.Hover" Color="#7C3AED"/>
    <SolidColorBrush x:Key="Btn.Play.Bg.Disabled" Color="#3E2A77"/>
    <SolidColorBrush x:Key="Btn.Play.Fg" Color="#F2EDFF"/>
    <SolidColorBrush x:Key="Btn.Play.Border" Color="#8C6AFF"/>

    <!-- Variant C: softly filled accents for Update -->
    <SolidColorBrush x:Key="Btn.Update.Bg" Color="#2B1F4A"/>
    <SolidColorBrush x:Key="Btn.Update.Bg.Hover" Color="#3A2966"/>
    <SolidColorBrush x:Key="Btn.Update.Bg.Disabled" Color="#20183A"/>
    <SolidColorBrush x:Key="Btn.Update.Fg" Color="#F2EDFF"/>
    <SolidColorBrush x:Key="Btn.Update.Border" Color="#8C6AFF"/>

    <!-- Install uses dark vibrant gradient like UpdateWindow primary -->
    <LinearGradientBrush x:Key="Btn.Install.Bg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#3A2966"/>
      <GradientStop Offset="1" Color="#8A2A4A"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Btn.Install.Bg.Hover" Color="{DynamicResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Btn.Install.Bg.Disabled" Color="#7A2748"/>
    <SolidColorBrush x:Key="Btn.Install.Fg" Color="#FFEAF1"/>
    <SolidColorBrush x:Key="Btn.Install.Border" Color="#FF6A95"/>

    <!-- Variant C: softly filled danger for Retry -->
    <SolidColorBrush x:Key="Btn.Retry.Bg" Color="#3A2222"/>
    <SolidColorBrush x:Key="Btn.Retry.Bg.Hover" Color="#4A2929"/>
    <SolidColorBrush x:Key="Btn.Retry.Bg.Disabled" Color="#2A1A1A"/>
    <SolidColorBrush x:Key="Btn.Retry.Fg" Color="#F8ECEC"/>
    <SolidColorBrush x:Key="Btn.Retry.Border" Color="#FF6B6B"/>

    <!-- Variant C: softly filled danger for Cancel -->
    <SolidColorBrush x:Key="Btn.Cancel.Bg" Color="#3A2222"/>
    <SolidColorBrush x:Key="Btn.Cancel.Bg.Hover" Color="#4A2929"/>
    <SolidColorBrush x:Key="Btn.Cancel.Bg.Disabled" Color="#2A1A1A"/>
    <SolidColorBrush x:Key="Btn.Cancel.Fg" Color="#F8ECEC"/>
    <SolidColorBrush x:Key="Btn.Cancel.Border" Color="#FF6B6B"/>

    <SolidColorBrush x:Key="Btn.Check.Bg" Color="{DynamicResource Color.Surface}"/>
    <SolidColorBrush x:Key="Btn.Check.Bg.Hover" Color="{DynamicResource Color.Hover}"/>
    <SolidColorBrush x:Key="Btn.Check.Bg.Disabled" Color="{DynamicResource Color.Pressed}"/>
    <SolidColorBrush x:Key="Btn.Check.Fg" Color="{DynamicResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Btn.Check.Border" Color="{DynamicResource Color.Border}"/>

    <!-- Local bright pink gradient just for checkmarks (legend + installed status) -->
    <LinearGradientBrush x:Key="Brush.CheckmarkGradientPink" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#8C6AFF"/>
      <GradientStop Offset="1" Color="#FF3A75"/>
    </LinearGradientBrush>

    <!-- Verify indicator: rounded, purple shades -->
    <LinearGradientBrush x:Key="Brush.VerifyGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#6F3AFF"/>
      <GradientStop Offset="1" Color="#A78BFA"/>
    </LinearGradientBrush>
    <Style x:Key="Style.ProgressBar.Verify" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border CornerRadius="3" Background="{DynamicResource Brush.Border}"/>
              <!-- Animated indicator for indeterminate state -->
              <Border x:Name="IndBar" CornerRadius="3" Height="6" Width="160" HorizontalAlignment="Left" Background="{StaticResource Brush.VerifyGradient}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="tt" X="-180"/>
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" From="-180" To="300" Duration="0:0:1.8"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Generic dim button template -->
    <Style x:Key="Style.Button.Dim.Base" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Update.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Update.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Per-status styles (inherit base and override brushes) -->
    <Style x:Key="Style.ActionButton.Update" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Update.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Update.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Hover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Install" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Install.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Install.Bg}"/>
      <!-- Remove bright outline by default -->
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Install.Bg.Hover}"/>
                <!-- Optional: show subtle border on hover using theme border, not bright accent -->
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Install.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Play" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Play.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Play.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Play.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Play.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Retry" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Retry.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Retry.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Retry.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Retry.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Retry.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Retry.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Cancel" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Cancel.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Cancel.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Cancel.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Cancel.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Cancel.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Cancel.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Checking" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Check.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Check.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Check.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Check.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Check.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Check.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Local button styles for Feedback modal (match UpdateWindow styles) -->
    <!-- Accent gradient like in UpdateWindow for primary action -->
    <LinearGradientBrush x:Key="Brush.AccentGradientPrimary" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#3A2966"/>
      <GradientStop Offset="1" Color="#8A2A4A"/>
    </LinearGradientBrush>
    <!-- Hover/pressed helpers (fallbacks if not defined globally) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#6F3AFF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8A2A4A"/>

    <Style x:Key="Style.Button.PrimaryLocal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPrimary}"/>
      <Setter Property="Foreground" Value="#0A0A0A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.Button.GhostNeutral" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <Grid Margin="8,8,8,8" Background="{DynamicResource Brush.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Селекторы игры и сборки перенесены в левую колонку центральной области -->

    <!-- Центральная область: слева выбор игры/сборки, справа две ленты новостей -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- Левая колонка (сайдбар) слегка ужата по ширине -->
        <ColumnDefinition Width="310"/>
        <!-- Пробел между сайдбаром и новостями (уменьшен) -->
        <ColumnDefinition Width="8"/>
        <!-- Две колонки новостей -->
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Левый сайдбар: выбор игры (лист) -->
      <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,0,0" Padding="12" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Header with refresh button -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Игры" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}"/>
            <!-- Compact verify indicator: small indeterminate bar between title and refresh button -->
            <ProgressBar Grid.Column="1" Name="GamesVerifyIndicator" Width="100" Height="6" VerticalAlignment="Center"
                         IsIndeterminate="True" Visibility="Collapsed"
                         Style="{StaticResource Style.ProgressBar.Verify}" Margin="8,0,8,0"/>
            <Button Grid.Column="2" Width="32" Height="32" ToolTip="Обновить список и статусы" Click="RefreshGames_Click" Margin="8,0,0,0">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
          </Grid>
          <!-- Separator under header -->
          <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}"/>
          <!-- removed old verification indicator under header -->
          <!-- Контейнер строки списка/скелетона с тёмным фоном -->
          <Grid Grid.Row="3" Background="{DynamicResource Brush.Surface}">
            <!-- Skeleton loader для списка игр -->
            <StackPanel Name="GamesSkeleton">
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="40"/>
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="40"/>
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="40"/>
              <Border Style="{DynamicResource Style.Skeleton}" Height="40"/>
            </StackPanel>
            <!-- Листаемый список игр как боковое меню (карточки) -->
            <ListBox Name="GameList" SelectionChanged="GameCombo_SelectionChanged" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.IsVirtualizing="False"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
              <ListBox.Resources>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                </Style>
              </ListBox.Resources>
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,6,0,6"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource Style.Card}" Padding="10" Margin="0" HorizontalAlignment="Stretch"
                          ContextMenuOpening="GameItem_ContextMenuOpening">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Открыть расположение игры" Click="OpenGameFolder_Click" CommandParameter="{Binding}"/>
                        <MenuItem Header="Удалить локальные файлы" Click="DeleteGame_Click" CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- Иконка игры -->
                      <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                        <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}"/>
                        <Image x:Name="IconImg" Source="{Binding IconUrl}" Tag="{Binding IconUrl}" Stretch="UniformToFill" Visibility="Visible"/>
                      </Grid>
                      <!-- Название -->
                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                      </StackPanel>
                      <!-- Флаг статуса (векторные иконки) -->
                      <Grid Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <!-- Иконка "требуется обновление": SVG-путь, масштабируемый -->
                        <Grid x:Name="IconNeedsUpdate">
                          <Grid.Style>
                            <Style TargetType="Grid">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsUpdate}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Grid.Style>
                          <Viewbox Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Stroke="{DynamicResource Brush.Title}" StrokeThickness="0.8" Fill="{DynamicResource Brush.Title}"
                                  Data="M16.08,59.26A8,8,0,0,1,0,59.26a59,59,0,0,1,97.13-45V8a8,8,0,1,1,16.08,0V33.35a8,8,0,0,1-8,8L80.82,43.62a8,8,0,1,1-1.44-15.95l8-.73A43,43,0,0,0,16.08,59.26Zm22.77,19.6a8,8,0,0,1,1.44,16l-10.08.91A42.95,42.95,0,0,0,102,63.86a8,8,0,0,1,16.08,0A59,59,0,0,1,22.3,110v4.18a8,8,0,0,1-16.08,0V89.14h0a8,8,0,0,1,7.29-8l25.31-2.3Z"/>
                          </Viewbox>
                        </Grid>
                        <!-- Толстая галочка (Установлена последняя версия) -->
                        <Path x:Name="IconInstalled" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource Brush.CheckmarkGradientPink}" Fill="Transparent"
                              Data="M 3 11 L 9 17 L 19 5">
                          <Path.Style>
                            <Style TargetType="Path">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                    <Condition Binding="{Binding NeedsUpdate}" Value="False"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <!-- Пустой статус (не установлено) — используем такую же иконку, как в легенде -->
                        <TextBlock x:Name="IconNotInstalled" FontFamily="Segoe MDL2 Assets" Text="&#xE896;"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="20" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding NeedsUpdate}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                    <Condition Binding="{Binding NeedsUpdate}" Value="False"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <ToolTipService.ToolTip>
                          <ToolTip>
                            <TextBlock>
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Text" Value="Не установлено"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsUpdate}" Value="True">
                                      <Setter Property="Text" Value="Требуется обновление"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                      <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                        <Condition Binding="{Binding NeedsUpdate}" Value="False"/>
                                      </MultiDataTrigger.Conditions>
                                      <Setter Property="Text" Value="Установлена последняя версия"/>
                                    </MultiDataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </ToolTip>
                        </ToolTipService.ToolTip>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!-- Separator between list and legend -->
          <Border Grid.Row="5" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,0"/>

          <!-- Легенда иконок статусов игр -->
          <StackPanel Grid.Row="6" Orientation="Vertical" Margin="8,8,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,4,6" VerticalAlignment="Center">
              <Path StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stroke="{DynamicResource Brush.CheckmarkGradientPink}" Fill="Transparent"
                    Data="M 2 7 L 6 11 L 12 2" Width="12" Height="12" Stretch="Uniform" Margin="0,1,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Установлена последняя версия" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,6" VerticalAlignment="Center">
              <Viewbox Stretch="Uniform" Width="12" Height="12" Margin="0,1,8,0" VerticalAlignment="Center">
                <Path Stroke="{DynamicResource Brush.Title}" StrokeThickness="0.8" Fill="{DynamicResource Brush.Title}"
                      Data="M16.08,59.26A8,8,0,0,1,0,59.26a59,59,0,0,1,97.13-45V8a8,8,0,1,1,16.08,0V33.35a8,8,0,0,1-8,8L80.82,43.62a8,8,0,1,1-1.44-15.95l8-.73A43,43,0,0,0,16.08,59.26Zm22.77,19.6a8,8,0,0,1,1.44,16l-10.08.91A42.95,42.95,0,0,0,102,63.86a8,8,0,0,1,16.08,0A59,59,0,0,1,22.3,110v4.18a8,8,0,0,1-16.08,0V89.14h0a8,8,0,0,1,7.29-8l25.31-2.3Z"/>
              </Viewbox>
              <TextBlock Text="Требуется обновление" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE896;" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Не установлено" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Margin="0,0,8,0" Style="{DynamicResource Style.Section}" VerticalAlignment="Stretch">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="GameNewsHeader" Text="Новости игры" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}" Margin="8,8,0,0"/>
          <Button Grid.Column="1" Width="32" Height="32" ToolTip="Обновить новости игры" Click="RefreshGameNews_Click" Margin="8,8,8,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>
        <Grid Grid.Row="1">
          <!-- Skeleton loader -->
          <StackPanel Name="GameNewsSkeleton">
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}"/>
          </StackPanel>
          <ListBox Name="GameNewsList" SelectionChanged="GameNewsList_SelectionChanged" Visibility="Collapsed"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,1,0,1"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Левая колонка: обложка -->
                  <Grid Grid.Column="0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}" Height="88"/>
                    <Image x:Name="CoverImg" Source="{Binding CoverUrl}" Tag="{Binding CoverUrl}" Stretch="Uniform" Height="88" HorizontalAlignment="Stretch"
                           Loaded="CoverImg_Loaded" ImageFailed="CoverImg_ImageFailed"/>
                  </Grid>
                  <!-- Правая колонка: текст -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" MaxHeight="54"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="3" Style="{DynamicResource Style.Section}" VerticalAlignment="Stretch">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Новости лаунчера" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}" Margin="8,8,0,0"/>
          <Button Grid.Column="1" Width="32" Height="32" ToolTip="Обновить новости лаунчера" Click="RefreshLauncherNews_Click" Margin="8,8,8,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>
        <Grid Grid.Row="1">
          <!-- Skeleton loader -->
          <StackPanel Name="LauncherNewsSkeleton" Margin="0,0,0,0">
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}"/>
          </StackPanel>
          <ListBox Grid.Row="0" Name="LauncherNewsList" SelectionChanged="LauncherNewsList_SelectionChanged" Visibility="Collapsed"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,1,0,1"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Левая колонка: обложка -->
                  <Grid Grid.Column="0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}" Height="88"/>
                    <Image x:Name="CoverImg" Source="{Binding CoverUrl}" Tag="{Binding CoverUrl}" Stretch="Uniform" Height="88" HorizontalAlignment="Stretch"
                           Loaded="CoverImg_Loaded" ImageFailed="CoverImg_ImageFailed"/>
                  </Grid>
                  <!-- Правая колонка: текст -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" MaxHeight="54"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Нижняя панель: статус обновления (редизайн, кнопка справа) -->
    <Border Grid.Row="3" Margin="0,12,0,0" Style="{DynamicResource Style.ProgressPanel}" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: фиксированные по высоте элементы статуса -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
          </Grid.RowDefinitions>
          <!-- Основной статус -->
          <TextBlock Grid.Row="0" Name="StatusText" Text="Готов" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
          <!-- Прогрессбар -->
          <ProgressBar Grid.Row="1" Name="UpdateProgress" Height="20" Minimum="0" Maximum="100" Value="0" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.AccentGradientPrimary}" Background="{DynamicResource Brush.Track}" VerticalAlignment="Center"/>
          <!-- Скорость/ETA -->
          <TextBlock Grid.Row="2" Name="SpeedEtaText" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
          <!-- Размеры/оценка места -->
          <TextBlock Grid.Row="3" Name="FilesSizeText" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Правая колонка: кнопка действия и под ней — тонкая кнопка обратной связи -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Right">
          <Button Name="ActionBtn" Content="Обновить" Click="ActionBtn_Click"
                  Style="{DynamicResource Style.ActionButton.Update}"
                  Width="180" Height="52" Margin="0"
                  VerticalAlignment="Center" VerticalContentAlignment="Center"/>
          <!-- Subtle feedback button -->
          <Button Name="FeedbackBtn" Click="FeedbackBtn_Click" Width="180" Height="28" Margin="0,8,0,0"
                  Background="{DynamicResource Brush.Background}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  Foreground="{DynamicResource Brush.TextSecondary}"
                  Opacity="0.75"
                  ToolTip="Поделиться идеей или сообщить о проблеме">
            <TextBlock Text="Поделиться идеей ✨" FontSize="12" HorizontalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toast overlay (non-intrusive notifications) -->
    <Grid x:Name="ToastHost" Grid.RowSpan="4" IsHitTestVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
      <Border x:Name="Toast"
              Visibility="Collapsed"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1.5"
              CornerRadius="8"
              Padding="12"
              Effect="{x:Null}">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.Text}"/>
      </Border>
    </Grid>

    <!-- Feedback modal overlay -->
    <Grid x:Name="FeedbackOverlay" Visibility="Collapsed" Background="#C0000000"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.RowSpan="4">
      <!-- Shadow layer (no effects on content to keep text crisp) -->
      <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="12" Background="#000000" Opacity="0.22" Margin="0,6,0,0"
              SnapsToDevicePixels="True" UseLayoutRounding="True"/>
      <!-- Content card (sharp text) -->
      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderHover}" BorderThickness="1.5" CornerRadius="10"
              Padding="20" Width="720" HorizontalAlignment="Center" VerticalAlignment="Center"
              SnapsToDevicePixels="True" UseLayoutRounding="True"
              TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display"
              TextOptions.TextHintingMode="Fixed"
              RenderOptions.ClearTypeHint="Enabled">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True"
              TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Header with title and close (X) -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Обратная связь" FontSize="20" FontWeight="SemiBold"/>
          <Button Grid.Row="0" Grid.Column="1" Content="✕" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Style="{StaticResource Style.Button.GhostNeutral}" Padding="0"
                  ToolTip="Закрыть" Click="FbCancel_Click"/>
          <!-- Name field with watermark -->
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,12">
            <TextBlock Text="Имя" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <Grid>
              <TextBox x:Name="FbName" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" Padding="10,8" TextChanged="FbField_Changed"
                       Foreground="{DynamicResource Brush.Text}" FontSize="14"/>
              <TextBlock Text="Ваше имя" IsHitTestVisible="False" Margin="12,8,8,8"
                         Foreground="{DynamicResource Brush.TextSecondary}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=FbName}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=FbName}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text.Length, ElementName=FbName}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text.Length, ElementName=FbName}" Value="{x:Static sys:Int32.MinValue}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </StackPanel>
          <!-- Contact field with watermark -->
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,12">
            <TextBlock Text="Контакт" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <Grid>
              <TextBox x:Name="FbContact" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" Padding="10,8" TextChanged="FbField_Changed"
                       Foreground="{DynamicResource Brush.Text}" FontSize="14"/>
              <TextBlock Text="Telegram или email" IsHitTestVisible="False" Margin="12,8,8,8"
                         Foreground="{DynamicResource Brush.TextSecondary}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=FbContact}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=FbContact}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text.Length, ElementName=FbContact}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
              <TextBlock Text="Тип:" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ComboBox x:Name="FbType" Width="160">
                <ComboBoxItem Content="Баг"/>
                <ComboBoxItem Content="Идея"/>
                <ComboBoxItem Content="Вопрос"/>
                <ComboBoxItem Content="Другое"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="Сообщение" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <Grid>
              <TextBox x:Name="FbComment" AcceptsReturn="True" Height="260" TextWrapping="Wrap" TextChanged="FbField_Changed"
                       Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" Padding="10,8"
                       Foreground="{DynamicResource Brush.Text}" FontSize="14"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TextBox.Resources>
                  <!-- Thin rounded scrollbar (applies within this TextBox) -->
                  <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                          <Grid Width="8" Background="Transparent">
                            <Border CornerRadius="4" Background="#202020"/>
                            <Track Name="PART_Track" IsDirectionReversed="true">
                              <Track.Thumb>
                                <Thumb Background="#606060">
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                      <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Track.Thumb>
                            </Track>
                          </Grid>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TextBox.Resources>
              </TextBox>
              <TextBlock Text="Опишите сообщение или идею" IsHitTestVisible="False" Margin="12,10,8,8"
                         Foreground="{DynamicResource Brush.TextSecondary}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=FbComment}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=FbComment}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text.Length, ElementName=FbComment}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" >
            <TextBlock x:Name="FbStatus" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
            <Button x:Name="FbSendBtn" Content="Отправить" MinWidth="200" Height="36" FontSize="13" FontWeight="SemiBold" Padding="12,6" Click="FbSend_Click" Margin="0,0,8,0" Style="{DynamicResource Style.Button.PrimaryLocal}"/>
            <Button Content="Отмена" Width="120" Height="36" FontSize="13" FontWeight="SemiBold" Padding="12,6" Click="FbCancel_Click" Style="{DynamicResource Style.Button.GhostNeutral}"/>
          </StackPanel>
          <!-- Removed info caption under buttons per request -->
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
