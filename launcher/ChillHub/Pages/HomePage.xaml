<Page x:Class="ChillHub.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная"
      Background="{DynamicResource Brush.Background}">
  <Grid Margin="8,8,8,8" Background="{DynamicResource Brush.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Селекторы игры и сборки перенесены в левую колонку центральной области -->

    <!-- Центральная область: слева выбор игры/сборки, справа две ленты новостей -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- Левая колонка (сайдбар) фиксированной ширины (увеличена для длинных названий игр) -->
        <ColumnDefinition Width="320"/>
        <!-- Пробел между сайдбаром и новостями (уменьшен) -->
        <ColumnDefinition Width="8"/>
        <!-- Две колонки новостей -->
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Левый сайдбар: выбор игры (лист) -->
      <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,0,0" Padding="12" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Header with refresh button -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Игры" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}"/>
            <!-- Compact verify indicator: small indeterminate bar between title and refresh button -->
            <ProgressBar Grid.Column="1" Name="GamesVerifyIndicator" Width="100" Height="6" VerticalAlignment="Center"
                         IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.TextSecondary}" Background="{DynamicResource Brush.Border}" Margin="8,0,8,0"/>
            <Button Grid.Column="2" Width="32" Height="32" ToolTip="Обновить список и статусы" Click="RefreshGames_Click" Margin="8,0,0,0">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
          </Grid>
          <!-- Separator under header -->
          <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Border}"/>
          <!-- removed old verification indicator under header -->
          <!-- Контейнер строки списка/скелетона с тёмным фоном -->
          <Grid Grid.Row="3" Background="{DynamicResource Brush.Surface}">
            <!-- Skeleton loader для списка игр -->
            <StackPanel Name="GamesSkeleton">
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="40"/>
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="40"/>
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="40"/>
              <Border Style="{DynamicResource Style.Skeleton}" Height="40"/>
            </StackPanel>
            <!-- Листаемый список игр как боковое меню (карточки) -->
            <ListBox Name="GameList" SelectionChanged="GameCombo_SelectionChanged" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.IsVirtualizing="False"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
              <ListBox.Resources>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                </Style>
              </ListBox.Resources>
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,6,0,6"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource Style.Card}" Padding="10" Margin="0" HorizontalAlignment="Stretch"
                          ContextMenuOpening="GameItem_ContextMenuOpening">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Открыть расположение игры" Click="OpenGameFolder_Click" CommandParameter="{Binding}"/>
                        <MenuItem Header="Удалить локальные файлы" Click="DeleteGame_Click" CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- Иконка игры -->
                      <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                        <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}"/>
                        <Image x:Name="IconImg" Source="{Binding IconUrl}" Tag="{Binding IconUrl}" Stretch="UniformToFill" Visibility="Visible"/>
                      </Grid>
                      <!-- Название -->
                      <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                      </StackPanel>
                      <!-- Флаг статуса -->
                      <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE896;"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                            <Setter Property="ToolTip" Value="Не установлено"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsUpdate}" Value="True">
                                <Setter Property="Text" Value="&#xE895;"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
                                <Setter Property="ToolTip" Value="Требуется обновление"/>
                              </DataTrigger>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                  <Condition Binding="{Binding NeedsUpdate}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="&#xE73E;"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="ToolTip" Value="Установлена последняя версия"/>
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!-- Separator between list and legend -->
          <Border Grid.Row="5" Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,0"/>

          <!-- Легенда иконок статусов игр -->
          <StackPanel Grid.Row="6" Orientation="Vertical" Margin="4,8,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,4,6" VerticalAlignment="Center">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE73E;" Foreground="{DynamicResource Brush.Accent}" Margin="0,1,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Установлена последняя версия" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,6" VerticalAlignment="Center">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE895;" Foreground="{DynamicResource Brush.Title}" Margin="0,1,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Требуется обновление" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE896;" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,1,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Не установлено" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Margin="0,0,8,0" Style="{DynamicResource Style.Section}" VerticalAlignment="Stretch">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="GameNewsHeader" Text="Новости игры" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}" Margin="8,8,0,0"/>
          <Button Grid.Column="1" Width="32" Height="32" ToolTip="Обновить новости игры" Click="RefreshGameNews_Click" Margin="8,8,8,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>
        <Grid Grid.Row="1">
          <!-- Skeleton loader -->
          <StackPanel Name="GameNewsSkeleton">
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}"/>
          </StackPanel>
          <ListBox Name="GameNewsList" SelectionChanged="GameNewsList_SelectionChanged" Visibility="Collapsed"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,1,0,1"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Левая колонка: обложка -->
                  <Grid Grid.Column="0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}" Height="88"/>
                    <Image x:Name="CoverImg" Source="{Binding CoverUrl}" Tag="{Binding CoverUrl}" Stretch="Uniform" Height="88" HorizontalAlignment="Stretch"
                           Loaded="CoverImg_Loaded" ImageFailed="CoverImg_ImageFailed"/>
                  </Grid>
                  <!-- Правая колонка: текст -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" MaxHeight="54"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="3" Style="{DynamicResource Style.Section}" VerticalAlignment="Stretch">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Новости лаунчера" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}" Margin="8,8,0,0"/>
          <Button Grid.Column="1" Width="32" Height="32" ToolTip="Обновить новости лаунчера" Click="RefreshLauncherNews_Click" Margin="8,8,8,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>
        <Grid Grid.Row="1">
          <!-- Skeleton loader -->
          <StackPanel Name="LauncherNewsSkeleton" Margin="0,0,0,0">
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8"/>
            <Border Style="{DynamicResource Style.Skeleton}"/>
          </StackPanel>
          <ListBox Grid.Row="0" Name="LauncherNewsList" SelectionChanged="LauncherNewsList_SelectionChanged" Visibility="Collapsed"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,1,0,1"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Левая колонка: обложка -->
                  <Grid Grid.Column="0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}" Height="88"/>
                    <Image x:Name="CoverImg" Source="{Binding CoverUrl}" Tag="{Binding CoverUrl}" Stretch="Uniform" Height="88" HorizontalAlignment="Stretch"
                           Loaded="CoverImg_Loaded" ImageFailed="CoverImg_ImageFailed"/>
                  </Grid>
                  <!-- Правая колонка: текст -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" MaxHeight="54"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Нижняя панель: статус обновления (редизайн, кнопка справа) -->
    <Border Grid.Row="3" Margin="0,12,0,0" Style="{DynamicResource Style.ProgressPanel}" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: фиксированные по высоте элементы статуса -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="20"/>
          </Grid.RowDefinitions>
          <!-- Основной статус -->
          <TextBlock Grid.Row="0" Name="StatusText" Text="Готов" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
          <!-- Прогрессбар -->
          <ProgressBar Grid.Row="1" Name="UpdateProgress" Height="20" Minimum="0" Maximum="100" Value="0" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Track}" VerticalAlignment="Center"/>
          <!-- Скорость/ETA -->
          <TextBlock Grid.Row="2" Name="SpeedEtaText" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
          <!-- Размеры/оценка места -->
          <TextBlock Grid.Row="3" Name="FilesSizeText" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Правая колонка: единая кнопка действия (меняет текст/стиль по состоянию) -->
        <Grid Grid.Column="1" VerticalAlignment="Center">
          <Button Name="ActionBtn" Content="Обновить" Click="ActionBtn_Click"
                  Style="{DynamicResource Style.Button.Primary}"
                  Width="160" Height="40" FontSize="14" Margin="0"
                  VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>

    <!-- Toast overlay (non-intrusive notifications) -->
    <Grid x:Name="ToastHost" Grid.RowSpan="4" IsHitTestVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
      <Border x:Name="Toast"
              Visibility="Collapsed"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1.5"
              CornerRadius="8"
              Padding="12"
              Effect="{x:Null}">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.Text}"/>
      </Border>
    </Grid>
  </Grid>
</Page>
