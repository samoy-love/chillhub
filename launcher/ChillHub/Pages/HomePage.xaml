<Page x:Class="ChillHub.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:pr="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
      xmlns:ui="clr-namespace:ChillHub.Core.UI"
      Title="Главная"
      Background="{DynamicResource Brush.Background}">
  <Page.Resources>
    <!-- Progress visuals shared brushes -->
    <SolidColorBrush x:Key="Brush.ProgressBorder" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="{DynamicResource Color.Track}"/>

    <!-- Кнопка действия. Главные состояния («Играть», «Обновить», «Установить») красятся
         ОДНОЙ заливкой: раньше у каждого был свой цвет — сиреневый, тёмно-лиловый и
         розовый градиент — и по цвету нельзя было понять, что все они означают одно и то
         же «сделай главное». Отличаются они текстом, а не окраской. Опасные состояния
         («Отмена», «Повторить») остаются приглушённо-красными.
         Заливка — Color.AccentFill, а не сам акцент: на акценте не читалась ни белая
         подпись, ни тёмная, обе не дотягивали до порога AA (см. палитру темы). -->
    <SolidColorBrush x:Key="Btn.Play.Bg" Color="{DynamicResource Color.AccentFill}"/>
    <SolidColorBrush x:Key="Btn.Play.Bg.Hover" Color="{DynamicResource Color.AccentFillHover}"/>
    <SolidColorBrush x:Key="Btn.Play.Bg.Pressed" Color="{DynamicResource Color.AccentFillPressed}"/>
    <SolidColorBrush x:Key="Btn.Play.Bg.Disabled" Color="#3A3550"/>
    <SolidColorBrush x:Key="Btn.Play.Fg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Btn.Play.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="Btn.Update.Bg" Color="{DynamicResource Color.AccentFill}"/>
    <SolidColorBrush x:Key="Btn.Update.Bg.Hover" Color="{DynamicResource Color.AccentFillHover}"/>
    <SolidColorBrush x:Key="Btn.Update.Bg.Pressed" Color="{DynamicResource Color.AccentFillPressed}"/>
    <SolidColorBrush x:Key="Btn.Update.Bg.Disabled" Color="#3A3550"/>
    <SolidColorBrush x:Key="Btn.Update.Fg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Btn.Update.Border" Color="Transparent"/>

    <SolidColorBrush x:Key="Btn.Install.Bg" Color="{DynamicResource Color.AccentFill}"/>
    <SolidColorBrush x:Key="Btn.Install.Bg.Hover" Color="{DynamicResource Color.AccentFillHover}"/>
    <SolidColorBrush x:Key="Btn.Install.Bg.Pressed" Color="{DynamicResource Color.AccentFillPressed}"/>
    <SolidColorBrush x:Key="Btn.Install.Bg.Disabled" Color="#3A3550"/>
    <SolidColorBrush x:Key="Btn.Install.Fg" Color="#FFFFFF"/>

    <!-- Повторить: приглушённый красный, заметный, но не спорящий с акцентом -->
    <SolidColorBrush x:Key="Btn.Retry.Bg" Color="#2A1E22"/>
    <SolidColorBrush x:Key="Btn.Retry.Bg.Hover" Color="#3A2A2E"/>
    <SolidColorBrush x:Key="Btn.Retry.Bg.Pressed" Color="#48343A"/>
    <SolidColorBrush x:Key="Btn.Retry.Bg.Disabled" Color="#221A1C"/>
    <SolidColorBrush x:Key="Btn.Retry.Fg" Color="#F0D9D9"/>
    <SolidColorBrush x:Key="Btn.Retry.Border" Color="{DynamicResource Color.Danger}"/>

    <SolidColorBrush x:Key="Btn.Cancel.Bg" Color="#2A1E22"/>
    <SolidColorBrush x:Key="Btn.Cancel.Bg.Hover" Color="#3A2A2E"/>
    <SolidColorBrush x:Key="Btn.Cancel.Bg.Pressed" Color="#48343A"/>
    <SolidColorBrush x:Key="Btn.Cancel.Bg.Disabled" Color="#221A1C"/>
    <SolidColorBrush x:Key="Btn.Cancel.Fg" Color="#F0D9D9"/>
    <SolidColorBrush x:Key="Btn.Cancel.Border" Color="{DynamicResource Color.Danger}"/>

    <SolidColorBrush x:Key="Btn.Check.Bg" Color="{DynamicResource Color.Surface}"/>
    <SolidColorBrush x:Key="Btn.Check.Bg.Hover" Color="{DynamicResource Color.Hover}"/>
    <SolidColorBrush x:Key="Btn.Check.Bg.Pressed" Color="{DynamicResource Color.Pressed}"/>
    <SolidColorBrush x:Key="Btn.Check.Bg.Disabled" Color="{DynamicResource Color.Pressed}"/>
    <SolidColorBrush x:Key="Btn.Check.Fg" Color="{DynamicResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Btn.Check.Border" Color="{DynamicResource Color.Border}"/>

    <!-- Рамка выбранной карточки: тот же акцент, что и у кнопки действия. Раньше здесь был
         розово-фиолетовый градиент — третий акцентный цвет на экране, не значивший ничего,
         кроме «выбрано». -->
    <SolidColorBrush x:Key="Brush.CheckmarkGradientPink" Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.CardHoverBorder" Color="{DynamicResource Color.BorderHover}"/>
    <SolidColorBrush x:Key="Brush.VerifyGradient" Color="{DynamicResource Color.Accent}"/>
    <Style x:Key="Style.ProgressBar.Verify" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border CornerRadius="3" Background="{DynamicResource Brush.Border}"/>
              <!-- Animated indicator for indeterminate state -->
              <Border x:Name="IndBar" CornerRadius="3" Height="6" Width="160" HorizontalAlignment="Left" Background="{StaticResource Brush.VerifyGradient}">
                <Border.RenderTransform>
                  <TranslateTransform X="-180"/>
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- Условие на IsVisible и обязательное снятие анимации: раньше у триггера были
                   одни EnterActions, и запущенный бегунок не останавливался уже никогда —
                   ни когда полоса становилась определённой, ни когда её прятали. -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsIndeterminate" Value="True"/>
                  <Condition Property="IsVisible" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                  <BeginStoryboard x:Name="VerifyRun">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="IndBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-180" To="300" Duration="0:0:1.8"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                  <RemoveStoryboard BeginStoryboardName="VerifyRun"/>
                </MultiTrigger.ExitActions>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded dark progress bar style -->
    <!-- Тонкая полоса с настоящим прогрессом: PART_Track/PART_Indicator — имена, по которым
         WPF сам считает ширину заполнения из Value. Style.ProgressBar.Verify этих частей не
         имеет вовсе — он умеет только бежать туда-сюда, и привязанный к нему Value в карточке
         очереди не показывал ничего: полоса «дышала» независимо от того, сколько скачано. -->
    <Style x:Key="Style.ProgressBar.Rounded" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track" CornerRadius="2" BorderThickness="0"
                      Background="{DynamicResource Brush.Track}"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource Brush.Accent}"
                      HorizontalAlignment="Left"/>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- План ещё не посчитан: доли нет, но работа идёт — показываем бегунок,
                   а не пустую полосу, которая читалась бы как «ничего не происходит». -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsIndeterminate" Value="True"/>
                  <Condition Property="IsVisible" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Indicator" Property="Width" Value="90"/>
                <Setter TargetName="PART_Indicator" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform X="-100"/>
                  </Setter.Value>
                </Setter>
                <MultiTrigger.EnterActions>
                  <BeginStoryboard x:Name="RoundedRun">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       From="-100" To="600" Duration="0:0:1.8"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <!-- Без остановки бегунок карточки очереди продолжал крутиться и после
                     того, как план посчитан и полоса показывает настоящую долю. -->
                <MultiTrigger.ExitActions>
                  <RemoveStoryboard BeginStoryboardName="RoundedRun"/>
                </MultiTrigger.ExitActions>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game-specific selectable style: brighter hover, special selected+hover -->
    <Style x:Key="Style.ListBoxItem.SelectableCard.Game" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Hover (not selected) brighter -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.CardHoverBorder}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </MultiTrigger>
              <!-- Selected without focus -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.CheckmarkGradientPink}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </MultiTrigger>
              <!-- Selected with focus -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.CheckmarkGradientPink}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </MultiTrigger>
              <!-- Selected + Hover: emphasize slightly more -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.CheckmarkGradientPink}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- News-specific selectable style: hover uses progress border; keep selected states as base -->

    <!-- Generic dim button template -->
    <Style x:Key="Style.Button.Dim.Base" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Update.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Update.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <!-- 15, а не 18: остальной экран набран 11–14, и кнопка кричала громче заголовка
           витрины. Главной её делает акцентная заливка, а не кегль. -->
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Per-status styles (inherit base and override brushes) -->
    <Style x:Key="Style.ActionButton.Update" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Update.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Update.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Update.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Hover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Pressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Update.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Install" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Install.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Install.Bg}"/>
      <!-- Remove bright outline by default -->
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Install.Bg.Hover}"/>
                <!-- Optional: show subtle border on hover using theme border, not bright accent -->
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Install.Bg.Pressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Install.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Play" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Play.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Play.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Play.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Play.Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Play.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Кнопки запуска на витрине: «Steam · с модами» и «Пиратка · с модами».
         Две строки, а не одна: крупная говорит, ЧЬЯ копия запустится, мелкая — что
         произойдёт по нажатию («с модами», «установить моды»). Одной строкой это не
         помещалось, а подсказка по наведению — не то место, где игрок узнаёт, что
         делает кнопка. -->
    <Style x:Key="Style.LaunchButton.Base" TargetType="Button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Вариант, которым играли в прошлый раз: та же заливка, что у «Играть», и шире
         соседней — глазу нужен якорь, с которого начинать читать ряд. -->
    <Style x:Key="Style.LaunchButton.Accent" TargetType="Button" BasedOn="{StaticResource Style.LaunchButton.Base}">
      <Setter Property="MinWidth" Value="176"/>
      <Setter Property="Foreground" Value="{DynamicResource Btn.Play.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Play.Bg}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Hover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Pressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Play.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Второй вариант: контурная кнопка. Раньше она отличалась от акцентной только
         оттенком заливки — два прямоугольника одного размера, одного веса и почти
         одного цвета, и какой из них главный, приходилось угадывать. Теперь разница
         тройная: нет заливки, тоньше подпись, уже сама кнопка. Наведение поднимает фон
         и красит рамку акцентом — заливка целиком сделала бы светлый текст нечитаемым. -->
    <Style x:Key="Style.LaunchButton.Ghost" TargetType="Button" BasedOn="{StaticResource Style.LaunchButton.Base}">
      <Setter Property="MinWidth" Value="140"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Background" Value="#66101017"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Retry" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Retry.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Retry.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Retry.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Retry.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Retry.Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Retry.Bg.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Retry.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Retry.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Cancel" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Cancel.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Cancel.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Cancel.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Cancel.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Cancel.Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Cancel.Bg.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Cancel.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Cancel.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.ActionButton.Checking" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Btn.Check.Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Btn.Check.Bg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Btn.Check.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Check.Bg.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Check.Border}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Check.Bg.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Btn.Check.Border}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Check.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- «Убрать из очереди»: единственное состояние, где в главном слоте стоит не главное
         действие. Отдельный стиль, а не серый «Проверка…»: тот набран вторичным цветом и
         рядом с «Об игре» проигрывал ей по весу — соседняя кнопка выглядела главной,
         хотя ведёт всего лишь на справочный экран. -->
    <Style x:Key="Style.ActionButton.Dequeue" TargetType="Button" BasedOn="{StaticResource Style.Button.Dim.Base}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Pressed}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn.Check.Bg.Disabled}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded bright selectable item style (used for games and news) -->
    <Style x:Key="Style.ListBoxItem.SelectableCard" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}">
              <!-- Stretch, а не Center: в двухколоночной ленте карточки одного ряда
                   получают общую высоту, и короткая не должна плавать посередине ячейки. -->
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Hover (brighter) -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.CardHoverBorder}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <!-- Selected without focus: bright but a bit thinner -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.CheckmarkGradientPink}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </MultiTrigger>
              <!-- Selected with focus: brightest and thicker -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.CheckmarkGradientPink}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </MultiTrigger>
              <!-- Disabled dim -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Removed global ScrollBar styling to avoid StaticExtension resolution issues on some environments -->
    
    <!-- Shared skeleton sizing resources -->
    <sys:Double x:Key="Skeleton.GameRowHeight">60</sys:Double>
    <sys:Double x:Key="Skeleton.NewsPreloadHeight">120</sys:Double>
    <Thickness x:Key="Skeleton.GameTopOffsetThickness">0,4,0,0</Thickness>
    <Thickness x:Key="Skeleton.NewsTopOffsetThickness">0,6,0,0</Thickness>
  </Page.Resources>
  <Grid Margin="8,8,8,8" Background="{DynamicResource Brush.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <!-- Ленте новостей достаётся всё, что не забрали витрина и очередь. Оба соседа
           ограничены ДОЛЕЙ высоты окна (HeightShareConv), а не числом пикселей: прежние
           MinHeight=260 здесь и MaxHeight=240 у очереди на окне по умолчанию (760)
           складывались с витриной в 340 так, что новостям не оставалось ни строки —
           MinHeight защищал строку сетки, а не ленту внутри неё, и витрина съедала его
           целиком. -->
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Селекторы игры и сборки перенесены в левую колонку центральной области -->

    <!-- Центральная область: слева выбор игры/сборки, справа две ленты новостей -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- Сайдбар. Стало уже прежних 310: статус переехал из иконки в подпись под
             названием, поэтому строке больше не нужны две колонки под значки справа. -->
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="8"/>
        <!-- Витрина выбранной игры + вкладки новостей -->
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Левый сайдбар: выбор игры (лист) -->
      <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,0,0" Padding="12" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <!-- Заголовок, поиск, список, подвал. Разделителей и легенды больше нет:
                 первые ничего не отделяли (сайдбар и так карточка), вторая объясняла
                 иконки, которых теперь нет. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Список живёт в звёздочной строке и прижат к её верху: занимает ровно
                 столько, сколько нужно играм, а когда высоты не хватает — сжимается и
                 прокручивается сам. Подвал (диск, обратная связь) в строке Auto ниже
                 получает своё место ВСЕГДА. Прежняя пара «Auto с MaxHeight + распорка *»
                 при появлении очереди загрузок снизу давала строкам Auto больше, чем
                 есть у сетки, и подвал уезжал за нижний край карточки: «Поделиться
                 идеей» пряталась под панелью очереди. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Header with refresh button -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Игры" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Title}"/>
            <!-- Compact verify indicator: small indeterminate bar between title and refresh button -->
            <!-- IsIndeterminate ставится из кода вместе с видимостью, а не здесь: прибитый
                 в разметке, он запускал бесконечный бегунок при загрузке страницы, и тот
                 крутился всё время работы лаунчера под невидимой полосой. -->
            <ProgressBar Grid.Column="1" Name="GamesVerifyIndicator" Width="80" Height="4" VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Style="{StaticResource Style.ProgressBar.Verify}" Margin="8,0,8,0"/>
            <Button Grid.Column="2" Name="RefreshGamesBtn" Width="28" Height="28" ToolTip="Обновить список и статусы" Click="RefreshGames_Click" Margin="8,0,0,0" Padding="0">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
          </Grid>

          <!-- Поиск по списку. Появился здесь, потому что список игр — единственная навигация
               в приложении, и до сих пор её нельзя было ни отфильтровать, ни сузить. -->
          <!-- Подсказка «Поиск» — свойством поля, а не надписью поверх него: своя надпись
               стояла по краю сетки, а текст поля начинается внутри рамки и Padding, и после
               клика каретка появлялась правее подсказки. Значок лупы остаётся отдельным
               слоем: он не текст и с кареткой не спорит. -->
          <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="GameSearchBox" TextChanged="GameSearch_TextChanged" Margin="0"
                     ui:Placeholder.Text="Поиск"
                     Template="{DynamicResource Template.TextBox.Field}"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}"
                     Padding="26,6,8,6" FontSize="12" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12" IsHitTestVisible="False"
                       Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
          </Grid>

          <!-- Контейнер строки списка/скелетона с тёмным фоном. VerticalAlignment=Top:
               строка сетки звёздочная, а список — по содержимому, чтобы при трёх играх
               не растягивать пустой ListBox до подвала. -->
          <Grid Grid.Row="2" VerticalAlignment="Top" Background="{DynamicResource Brush.Surface}">
            <!-- Skeleton loader для списка игр -->
            <StackPanel Name="GamesSkeleton" Margin="{StaticResource Skeleton.GameTopOffsetThickness}">
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.GameRowHeight}"/>
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.GameRowHeight}"/>
              <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.GameRowHeight}"/>
              <Border Style="{DynamicResource Style.Skeleton}" Height="{StaticResource Skeleton.GameRowHeight}"/>
            </StackPanel>
            <!-- Пустое состояние: сервер недоступен -->
            <StackPanel Name="GamesEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB5E;" FontSize="28" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8"/>
              <TextBlock Text="Не удалось связаться с сервером" TextWrapping="Wrap" TextAlignment="Center"
                         FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
              <TextBlock Text="Проверьте подключение к интернету и попробуйте снова." TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,12"/>
              <Button Name="RetryLoadBtn" Content="Повторить" Click="RetryLoad_Click"
                      Style="{DynamicResource Style.Button.GhostNeutral}" Width="140" Height="32" HorizontalAlignment="Center"/>
            </StackPanel>
            <!-- Листаемый список игр как боковое меню (карточки) -->
            <ListBox Name="GameList" SelectionChanged="GameCombo_SelectionChanged" MouseDoubleClick="GameList_MouseDoubleClick"
                     Visibility="Collapsed" Background="{DynamicResource Brush.Surface}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.IsVirtualizing="False"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch">
              <ListBox.Resources>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                </Style>
              </ListBox.Resources>
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                    <!-- Видимости полос ОБЯЗАТЕЛЬНО пробрасываем из присоединённых свойств.
                         Свой ControlTemplate заменяет штатный, где эти связи есть, поэтому без
                         них ScrollViewer брал СВОИ значения по умолчанию — а у него горизонтальная
                         полоса по умолчанию Visible. Отсюда и появлялся горизонтальный скролл, и
                         содержимое переставало ограничиваться шириной контейнера. -->
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListBoxItem.SelectableCard.Game}">
                  <!-- Default row height (when content is fully loaded) -->
                  <Setter Property="MinHeight" Value="40"/>
                  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                  <Style.Triggers>
                    <!-- While there is no icon URL (loading/skeleton state), make the row taller -->
                    <DataTrigger Binding="{Binding IconUrl}" Value="">
                      <Setter Property="MinHeight" Value="{StaticResource Skeleton.GameRowHeight}"/>
                      <!-- Add top padding for visible offset while skeleton is shown -->
                      <Setter Property="Padding" Value="{StaticResource Skeleton.GameTopOffsetThickness}"/>
                      <!-- Also increase outer margin top so the whole item shifts down -->
                      <Setter Property="Margin" Value="0,10,0,6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IconUrl}" Value="{x:Null}">
                      <Setter Property="MinHeight" Value="{StaticResource Skeleton.GameRowHeight}"/>
                      <Setter Property="Padding" Value="{StaticResource Skeleton.GameTopOffsetThickness}"/>
                      <Setter Property="Margin" Value="0,10,0,6"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- Neutralize inner card border to avoid double border; content still keeps padding -->
                  <Border Padding="10" Margin="0" HorizontalAlignment="Stretch"
                          BorderThickness="0" BorderBrush="Transparent"
                          ContextMenuOpening="GameItem_ContextMenuOpening">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Подробнее об игре" Click="GameDetails_Click" CommandParameter="{Binding}"/>
                        <!-- Два пункта на одном месте: качать нечего у свежей установленной
                             игры, а проверять — наоборот, только её и есть смысл. Показывается
                             всегда ровно один (см. GameItem_ContextMenuOpening). -->
                        <MenuItem x:Name="EnqueueMenuItem" Header="Добавить в очередь загрузок"
                                  Click="EnqueueGame_Click" CommandParameter="{Binding}"/>
                        <MenuItem x:Name="VerifyMenuItem" Header="Проверить файлы игры"
                                  Click="VerifyGame_Click" CommandParameter="{Binding}"/>
                        <MenuItem Header="Открыть расположение игры" Click="OpenGameFolder_Click" CommandParameter="{Binding}"/>
                        <!-- Удаление отделено чертой и покрашено: в столбце одинаковых строк
                             оно стояло сразу под «Открыть расположение» и ловило промахи. -->
                        <Separator/>
                        <MenuItem Header="Удалить локальные файлы" Click="DeleteGame_Click" CommandParameter="{Binding}"
                                  Style="{DynamicResource Style.MenuItem.Danger}"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <!-- Grow row height while skeleton is visible -->
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Style.Card}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ElementName=GameRowSkeleton, Path=Visibility}" Value="Visible">
                            <Setter Property="MinHeight" Value="80"/>
                            <!-- Add extra top padding so the skeleton/card is not stuck to the top -->
                            <Setter Property="Padding" Value="10,12,10,10"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <!-- Две колонки вместо четырёх: значок статуса стал подписью под
                             названием, а кнопка ⓘ убрана — то же самое делают двойной клик,
                             контекстное меню и «Подробнее» в витрине. -->
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <!-- Per-row shimmer overlay -->
                      <!-- Spacer to enforce taller layout when skeleton is shown -->
                      <Border x:Name="GameRowSkeletonSpacer" Grid.ColumnSpan="2"
                              Height="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=ActualHeight}"
                              Margin="{StaticResource Skeleton.GameTopOffsetThickness}" Background="Transparent"
                              Visibility="{Binding ElementName=GameRowSkeleton, Path=Visibility}"/>
                      <ContentControl x:Name="GameRowSkeleton" Grid.ColumnSpan="2" Panel.ZIndex="1"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="{StaticResource Skeleton.GameTopOffsetThickness}"
                                      IsHitTestVisible="False"
                                      Height="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=ActualHeight}">
                        <ContentControl.Style>
                          <Style TargetType="ContentControl" BasedOn="{StaticResource Style.Skeleton.GameRow}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <!-- Show skeleton while there's no icon URL -->
                              <DataTrigger Binding="{Binding IconUrl}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IconUrl}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ContentControl.Style>
                      </ContentControl>
                      <!-- Иконка игры -->
                      <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                        <!-- Default icon (visible under image or when no image) -->
                        <TextBlock x:Name="DefaultGameIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="18"
                                   Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <Image x:Name="IconImg" ui:CoverImage.Url="{Binding IconUrl}"
                               Stretch="UniformToFill" Visibility="Visible"
                               ImageFailed="CoverImg_ImageFailed"/>
                      </Grid>
                      <!-- Название и статус словом. Статус занимает вторую строку той же
                           колонки — раньше он был иконкой справа, а расшифровка иконок жила
                           в легенде внизу сайдбара. -->
                      <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding Title}"/>
                        <!-- Подпись знает про очередь: пока игра качается — «Скачивание · 38%»
                             акцентом, а не то же янтарное «Обновление», что у соседки, которая
                             только ждёт. Второй вход MultiBinding — свойство с уведомлением,
                             по нему строка перерисовывается без пересборки списка. -->
                        <TextBlock FontSize="11" Margin="0,2,0,0" TextWrapping="NoWrap">
                          <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource GameRowStatusTextConv}" Mode="OneWay">
                              <Binding/>
                              <Binding Path="QueueLabel"/>
                              <!-- «Играет»: открытая прямо сейчас игра видна в списке, а не
                                   только на витрине — за списком к ней и возвращаются. -->
                              <Binding Path="RunLabel"/>
                              <!-- Конвертеру эти значения не нужны: они здесь, чтобы подпись
                                   пересчиталась, когда игру установили или ей потребовалось
                                   обновление. Без них строка молчала до пересборки всего
                                   списка, а пересборка мигала значками. -->
                              <Binding Path="IsInstalled"/>
                              <Binding Path="NeedsUpdate"/>
                            </MultiBinding>
                          </TextBlock.Text>
                          <TextBlock.Foreground>
                            <MultiBinding Converter="{StaticResource GameRowStatusBrushConv}" Mode="OneWay">
                              <Binding/>
                              <Binding Path="QueueLabel"/>
                              <Binding Path="RunLabel"/>
                              <Binding Path="IsInstalled"/>
                              <Binding Path="NeedsUpdate"/>
                            </MultiBinding>
                          </TextBlock.Foreground>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!-- Подвал сайдбара: свободное место и кнопка обратной связи. Место на диске здесь,
               а не под прогрессом: это свойство машины, а не текущей закачки. -->
          <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,8"/>
            <TextBlock x:Name="DiskFreeText" Text="" FontSize="11" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <Button Name="FeedbackBtn" Click="FeedbackBtn_Click" Height="28" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    ToolTip="Поделиться идеей или сообщить о проблеме">
              <TextBlock Text="Поделиться идеей" FontSize="12" HorizontalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Без правого отступа: витрина, лента и очередь внизу кончаются на одной
           вертикали. Раньше витрина заканчивалась на 8px раньше очереди, кнопка
           обновления новостей — ещё на 8px раньше витрины: три правых края в столбце. -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <!-- Витрина-герой выбранной игры -->
          <RowDefinition Height="Auto"/>
          <!-- Вкладки «Новости игры / Новости лаунчера» -->
          <RowDefinition Height="Auto"/>
          <!-- Лента новостей выбранной вкладки. Очередь загрузок раньше стояла отдельной
               строкой ЗДЕСЬ, между вкладками и лентой, и разрывала пару «вкладка → её
               содержимое», забирая у ленты высоту. Теперь очередь живёт в нижней панели
               (см. QueueDock ниже) — там же, где показывался её дубликат. -->
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Витрина-герой: обложка, заголовок, статус, кнопка действия и сведения.
             Высота считается из ширины по пропорции Steam Library Hero (1920×620) —
             ровно того формата, что SteamGridDB отдаёт в разделе Heroes. Без этого
             витрина тянулась по ширине окна при почти постоянной высоте, от 5:1 до
             13:1, и обложка обрезалась по-разному при каждом размере окна: назвать
             художнику требуемый размер было невозможно.
             MaxHeight не даёт витрине съесть ленту новостей: дальше него обложка
             кадрируется по центру, как это делает и сам Steam. Предел — доля высоты
             окна, а не число: 340px на окне в 760 были почти половиной экрана, и вместе
             с очередью загрузок витрина выдавливала новости в ноль. Доля 0.30: на 2K
             треть окна под витриной оказалась 350px почти пустого фона — обложка,
             обрезанная до 5:1, теряла и логотип, и силуэты, а текст занимал угол. -->
        <!-- MinHeight не меньше содержимого (бейдж, заголовок, строка сведений, кнопка —
             ~140px плюс поля 16 с двух сторон). На минимальном окне доля высоты давала
             витрине меньше, чем нужно её содержимому: Grid переставал помещаться,
             WPF накладывал на него layout-clip по внутреннему полю — обложка и
             затемнение обрезались рамкой в 16px, а низ кнопки срезался. MinHeight
             сильнее MaxHeight, поэтому доля здесь просто перестаёт работать. -->
        <Border Grid.Row="0" Margin="0,0,0,8" CornerRadius="12" MinHeight="184"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Page},
                                    Converter={StaticResource HeightShareConv}, ConverterParameter=0.30}"
                Background="{DynamicResource Brush.HeroGradient}" ClipToBounds="True">
          <Border.Style>
            <Style TargetType="Border">
              <!-- Пропорция включается только когда обложка есть. Без неё витрина
                   резервировала бы под картинку треть экрана и стояла пустой — на 2K
                   это две сотни пикселей чёрного поля над заголовком. -->
              <Setter Property="Height" Value="Auto"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=HeroCoverImg}" Value="Visible">
                  <Setter Property="Height"
                          Value="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth,
                                          Converter={StaticResource AspectHeightConv}}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Обложка из галереи игры (GalleryClient): показывается, когда gallery.json
                 отдал хотя бы одну картинку, иначе остаётся Collapsed и виден только градиент фона. -->
            <!-- Кадрируется с упором вниз, а не по центру: когда витрина ниже пропорции
                 обложки, срезается верх — небо и пустой фон, — а сюжетная часть, где обычно
                 логотип и персонажи, остаётся в кадре.
                 Кисть на прямоугольнике, а не <Image VerticalAlignment=Bottom>: у Image с
                 не-Stretch выравниванием и отрицательным Margin разметка ужимала картинку в
                 поле Grid без учёта Margin — на маленьком окне обложка стояла в рамке 16px
                 внутри витрины. Прямоугольник тянется по слоту, а кадрирование делает кисть. -->
            <!-- Opacity 0.75, а не 0.5: половинная прозрачность плюс два слоя затемнения
                 сверху гасили обложку до серого пятна. Читаемость текста держат сами
                 затемнения (Brush.HeroScrim/HeroScrimSide), а не глушение всей картинки. -->
            <Rectangle x:Name="HeroCoverImg" Grid.Row="0" Grid.RowSpan="2" Opacity="0.75" Visibility="Collapsed"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-16">
              <Rectangle.Fill>
                <ImageBrush x:Name="HeroCoverBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Bottom"/>
              </Rectangle.Fill>
            </Rectangle>

            <!-- Затемнение под текстом: белый заголовок обязан читаться на любой обложке,
                 а не только на тёмной. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource Brush.HeroScrim}"
                    Margin="-16" IsHitTestVisible="False"/>
            <!-- Второй слой — слева направо: текст стоит в левом нижнем углу, а логотип
                 обложки обычно по центру. Одно вертикальное затемнение либо не спасало
                 заголовок от логотипа, либо гасило всю картинку. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource Brush.HeroScrimSide}"
                    Margin="-16" IsHitTestVisible="False"/>

            <!-- Иконка игры крупным планом — заглушка, пока обложки нет. Поверх обложки
                 не рисуется: маленький квадрат в углу спорил с картинкой во всю витрину. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="104" Height="104"
                  Margin="0,0,0,0" Opacity="0.9">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=HeroCoverImg}" Value="Visible">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Image x:Name="HeroIconImg" ui:CoverImage.Url="{Binding SelectedItem.IconUrl, ElementName=GameList}"
                     Stretch="Uniform" ImageFailed="CoverImg_ImageFailed"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <!-- Бейдж статуса выбранной игры -->
              <Border x:Name="HeroStatusBadge" CornerRadius="{StaticResource Radius.S}" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8"
                      Background="{DynamicResource Brush.HeroBadge.Bg}" BorderBrush="{DynamicResource Brush.HeroBadge.Border}" BorderThickness="1">
                <TextBlock x:Name="HeroStatusText" Text="Проверка…" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
              </Border>
              <TextBlock x:Name="HeroTitleText" Text="Выберите игру" FontSize="26" FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <!-- Версия, объём и наигранное. Витрина занимала полтораста пикселей под одно
                   название — всё, что игрок хотел о ней знать, лежало на других экранах. -->
              <TextBlock x:Name="HeroMetaText" Text="" FontSize="12" Margin="0,4,0,0"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <!-- ЕДИНСТВЕННАЯ кнопка действия в приложении. Раньше их было две — здесь и
                     внизу окна — одинакового вида и с одинаковым текстом. У игры с модами,
                     готовой к запуску, её место занимают кнопки запуска ниже: «Играть» там
                     не отвечала на вопрос, ЧТО именно запустится. -->
                <Button x:Name="ActionBtn" Content="Играть" Click="ActionBtn_Click"
                        Style="{DynamicResource Style.ActionButton.Play}"
                        Width="180" Height="46" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <!-- Два способа играть с модами — своей копией из Steam и сборкой с сервера —
                     вынесены кнопками. Выбор, спрятанный в меню, — не выбор: чем запустит
                     «Играть», можно было узнать, только открыв стрелку. Кнопки нет, если её
                     вариант сейчас недоступен: тогда он ждёт под стрелкой вместе с причиной. -->
                <Button x:Name="LaunchBtn1" Click="LaunchBtn_Click" Visibility="Collapsed"
                        Style="{DynamicResource Style.LaunchButton.Accent}">
                  <StackPanel>
                    <TextBlock x:Name="LaunchBtn1Title" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <!-- 0.85, а не 0.75: подпись набрана 11-м кеглем, и на заливке кнопки более
                         бледная давала 3,4:1 при пороге 4,5:1. -->
                    <TextBlock x:Name="LaunchBtn1Note" FontSize="11" Opacity="0.85" Margin="0,1,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="LaunchBtn2" Click="LaunchBtn_Click" Visibility="Collapsed" Margin="8,0,0,0"
                        Style="{DynamicResource Style.LaunchButton.Ghost}">
                  <StackPanel>
                    <TextBlock x:Name="LaunchBtn2Title" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LaunchBtn2Note" FontSize="11" Opacity="0.85" Margin="0,1,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <!-- Стрелка с остальными вариантами: «без модов» и то, что сейчас
                     недоступно. Видна только у игры с модами: у остальных выбирать нечего,
                     и пустая кнопка рядом только сбивала бы с толку. -->
                <Button x:Name="LaunchMenuBtn" Click="LaunchMenuBtn_Click"
                        Style="{DynamicResource Style.LaunchButton.Ghost}"
                        Width="46" MinWidth="46" Padding="0" Margin="4,0,0,0"
                        Visibility="Collapsed" ToolTip="Другие варианты запуска">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="12"
                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <!-- Отступ 24, а не 8: «Об игре» — не третий вариант запуска, а переход на
                     другой экран. При равных зазорах стрелка «другие варианты» стояла ровно
                     посередине между кнопкой запуска и этой, и было не понять, к чему из
                     двух она относится. Расстояние и делит ряд на группы. -->
                <Button x:Name="HeroInfoBtn" Click="GameDetails_Click"
                        Style="{DynamicResource Style.Button.HeroInfo}"
                        Height="46" Margin="24,0,0,0" VerticalAlignment="Center" ToolTip="Сведения, история изменений, папка игры">
                  <!-- Подпись, а не одинокая ⓘ: кнопка ведёт на отдельный экран, и слово
                       говорит об этом, а значок в кружке читался как всплывающая подсказка. -->
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Об игре" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Вкладки под витриной: переключают ленту без перезагрузки страницы -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="2,4,0,8">
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="NewsTabGame" Content="Новости игры" IsChecked="True"
                          Style="{DynamicResource Style.Button.HeroTab}" Click="NewsTabGame_Click" Margin="0,0,18,0"/>
            <ToggleButton x:Name="NewsTabLauncher" Content="Новости лаунчера" IsChecked="False"
                          Style="{DynamicResource Style.Button.HeroTab}" Click="NewsTabLauncher_Click"/>
            <!-- Одна кнопка обновления на обе вкладки, сразу за ними. У правого края она
                 стояла в полутора тысячах пикселей от вкладок и читалась как «обновить всё»,
                 а не как действие над лентой. Раньше у каждой ленты была своя кнопка на
                 отдельной строке под вкладками — 32px высоты на одинокий значок. -->
            <Button Width="28" Height="28" Margin="10,0,0,6" VerticalAlignment="Center"
                    Style="{DynamicResource Style.Button.QueueIcon}"
                    ToolTip="Обновить ленту" Click="RefreshActiveNews_Click">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
          </StackPanel>
        </Border>

        <Grid x:Name="GameNewsPanel" Grid.Row="2" Visibility="Visible">
        <!-- Заголовка «Новости <игра>» здесь нет: название игры стоит строкой выше в
             витрине, слово «Новости» — на активной вкладке, кнопка обновления — в строке
             вкладок. -->
        <Grid>
          <!-- Skeleton loader -->
          <StackPanel Name="GameNewsSkeleton" Margin="{StaticResource Skeleton.NewsTopOffsetThickness}">
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.NewsPreloadHeight}"/>
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.NewsPreloadHeight}"/>
            <Border Style="{DynamicResource Style.Skeleton}" Height="{StaticResource Skeleton.NewsPreloadHeight}"/>
          </StackPanel>
          <!-- Пустое состояние: у игры пока нет новостей. Без него под заголовком
               «Новости <игра>» оставалась голая дыра в половину экрана — у списка игр
               пустое состояние было, у ленты новостей нет. -->
          <StackPanel Name="GameNewsEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
            <!-- Нейтральный значок, а не треугольник предупреждения: «новостей нет» —
                 обычное состояние молодой игры, а не ошибка. -->
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="24" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,8"/>
            <TextBlock Text="Пока новостей нет" TextWrapping="Wrap" TextAlignment="Center"
                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="Здесь появятся объявления и события этой игры." TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
          </StackPanel>
          <ListBox Name="GameNewsList" SelectionChanged="GameNewsList_SelectionChanged" Visibility="Collapsed" Padding="0" Margin="-4,-4,0,0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <!-- Одна или две колонки по ширине ленты (NewsColumnsConv). Карточки в две
               колонки на 2K — той же плотности, что на ноутбуке; отступ между
               колонками — боковые поля карточек, внешние 4px компенсированы Margin
               самого списка, чтобы края лент совпали с витриной. -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <ui:NewsFlowPanel Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox},
                                                  Converter={StaticResource NewsColumnsConv}}"
                                VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListBoxItem.SelectableCard}">
              <Setter Property="Margin" Value="4,4,4,4"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch" BorderThickness="0" BorderBrush="Transparent">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Restrict shimmer overlay to image area only (fixed height 88) -->
                  <!-- Левая колонка: обложка -->
                  <Grid Grid.Column="0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <ContentControl x:Name="GameNewsImgSkeleton"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="1"
                                    IsHitTestVisible="False" Margin="{StaticResource Skeleton.NewsTopOffsetThickness}"
                                    Height="{Binding ElementName=CoverImg, Path=ActualHeight}">
                      <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleY="0.7"/>
                      </ContentControl.LayoutTransform>
                      <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource Style.Skeleton.NewsCard}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=CoverImg}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ContentControl.Style>
                    </ContentControl>
                    <!-- Removed skeleton placeholder for cover images per request -->
                    <!-- Обложка — рамка 16:9 фиксированного размера, картинка вписывается
                         заполнением. Прежние Uniform + Height=108 отдавали размер обложки
                         на откуп пропорциям картинки: широкая новость получала 168x95,
                         квадратная — 108x108, и соседние карточки расходились и по высоте
                         обложки, и по левому краю текста. -->
                    <Border Width="168" Height="94" CornerRadius="{StaticResource Radius.S}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
                            Background="{DynamicResource Brush.Surface2}">
                      <!-- Height дублирует высоту рамки не ради разметки, а ради раскодирования:
                           ImageLoader берёт из него размер, под который распаковывать картинку
                           (см. ApplyBitmap), и без него каждая обложка новости разворачивалась
                           бы в память в полный рост. -->
                      <Image x:Name="CoverImg" ui:CoverImage.Url="{Binding CoverUrl}" Stretch="UniformToFill" Height="94"
                             ImageFailed="CoverImg_ImageFailed"/>
                    </Border>
                  </Grid>
                  <!-- Правая колонка: текст -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" MaxHeight="54"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        </Grid>

        <Grid x:Name="LauncherNewsPanel" Grid.Row="2" Visibility="Collapsed">
        <Grid>
          <!-- Skeleton loader -->
          <StackPanel Name="LauncherNewsSkeleton" Margin="{StaticResource Skeleton.NewsTopOffsetThickness}">
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.NewsPreloadHeight}"/>
            <Border Style="{DynamicResource Style.Skeleton}" Margin="0,0,0,8" Height="{StaticResource Skeleton.NewsPreloadHeight}"/>
            <Border Style="{DynamicResource Style.Skeleton}" Height="{StaticResource Skeleton.NewsPreloadHeight}"/>
          </StackPanel>
          <ListBox Grid.Row="0" Name="LauncherNewsList" SelectionChanged="LauncherNewsList_SelectionChanged" Visibility="Collapsed" Padding="0" Margin="-4,-4,0,0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <!-- Одна или две колонки по ширине ленты (NewsColumnsConv). Карточки в две
               колонки на 2K — той же плотности, что на ноутбуке; отступ между
               колонками — боковые поля карточек, внешние 4px компенсированы Margin
               самого списка, чтобы края лент совпали с витриной. -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <ui:NewsFlowPanel Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox},
                                                  Converter={StaticResource NewsColumnsConv}}"
                                VerticalAlignment="Top"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListBoxItem.SelectableCard}">
              <Setter Property="Margin" Value="4,4,4,4"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch" BorderThickness="0" BorderBrush="Transparent">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Левая колонка: обложка -->
                  <Grid Grid.Column="0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CoverUrl}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <!-- Image-only shimmer overlay bound to cover height -->
                    <ContentControl x:Name="LauncherNewsImgSkeleton"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="1"
                                    IsHitTestVisible="False" Margin="{StaticResource Skeleton.NewsTopOffsetThickness}"
                                    Height="{Binding ElementName=CoverImg, Path=ActualHeight}">
                      <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleY="0.7"/>
                      </ContentControl.LayoutTransform>
                      <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource Style.Skeleton.NewsCard}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=CoverImg}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ContentControl.Style>
                    </ContentControl>
                    <Border x:Name="ImgSkeleton" Style="{DynamicResource Style.Skeleton}" Width="168" Height="94" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <!-- Обложка — рамка 16:9 фиксированного размера, картинка вписывается
                         заполнением. Прежние Uniform + Height=108 отдавали размер обложки
                         на откуп пропорциям картинки: широкая новость получала 168x95,
                         квадратная — 108x108, и соседние карточки расходились и по высоте
                         обложки, и по левому краю текста. -->
                    <Border Width="168" Height="94" CornerRadius="{StaticResource Radius.S}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
                            Background="{DynamicResource Brush.Surface2}">
                      <!-- Height дублирует высоту рамки не ради разметки, а ради раскодирования:
                           ImageLoader берёт из него размер, под который распаковывать картинку
                           (см. ApplyBitmap), и без него каждая обложка новости разворачивалась
                           бы в память в полный рост. -->
                      <Image x:Name="CoverImg" ui:CoverImage.Url="{Binding CoverUrl}" Stretch="UniformToFill" Height="94"
                             ImageFailed="CoverImg_ImageFailed"/>
                    </Border>
                  </Grid>
                  <!-- Правая колонка: текст -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               LineStackingStrategy="BlockLineHeight" LineHeight="18" MaxHeight="54"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- Нижняя панель: только ход работы. Кнопка действия уехала в витрину, а сама панель
         скрывается в покое (см. SyncBottomBarVisibility) — пустая полоса прогресса под
         надписью «Готово» сообщала о процессе, которого нет. -->
    <Border x:Name="BottomBar" Grid.Row="3" Margin="0,8,0,0" Style="{DynamicResource Style.ProgressPanel}" Padding="12"
            Visibility="Collapsed">
      <!-- Одна колонка: правая (Auto) осталась пустой после переезда кнопки действия
           в витрину и лишь съедала 12px отступа справа — очередь кончалась раньше ленты
           новостей над ней. -->
      <Grid>
        <Grid>
          <!-- Два взаимоисключающих вида на одном месте:
               очередь не пуста  → список карточек (по карточке на игру);
               очередь пуста     → статус выбранной игры («Готово», объём, свободное место).
               Раньше показывались ОБА сразу, в разных концах экрана, про одну и ту же
               позицию: «Ждёт очереди…» стояло и в карточке, и здесь. -->
          <!-- Очередь загрузок: карточка на каждую игру — ждёт, качается, снимается по ✕,
               ожидающие можно поднять/опустить стрелками (порядок среди Waiting, качающаяся
               позиция всегда первая и не переставляется). -->
          <StackPanel x:Name="QueuePanel" Visibility="Collapsed">
            <TextBlock x:Name="QueueSummaryText" Text="Очередь загрузок" FontWeight="SemiBold" FontSize="14"
                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Title}"/>
            <!-- Высоту задаёт содержимое, а не доля окна: в доке ровно столько строк,
                 сколько разрешил QueueDockLayout (см. SyncQueueDockRows), остальные ждут
                 за строкой «Показать ещё N». Прежний потолок в 28% высоты окна на низком
                 окне забирал четверть экрана ради двух с половиной строк со скроллом —
                 и ленте новостей над ним оставалось полторы карточки, тоже со скроллом.
                 Скролл остаётся только для раскрытой длинной очереди. -->
            <!-- Строки занимают всю ширину панели. Потолок в 1100px оставлял правую
                 половину пустой — панель во весь экран, а в ней узкие карточки у левого
                 края. Ширина при этом не разносит связанное по углам: название и процент
                 стоят слева вместе, цифры собраны в свою колонку справа, кнопки — за
                 ними, и у всех строк общий правый край. -->
            <ItemsControl x:Name="QueueDock"
                          MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Page},
                                              Converter={StaticResource HeightShareConv}, ConverterParameter=0.45}">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Ожидающая позиция — строка, а не карточка в полный рост: у неё нет ни
                       полосы, ни цифр, и три одинаковых по высоте карточки не влезали даже
                       в окно по умолчанию — третья всегда была срезана.
                       Карточка тянется во всю ширину дока: у всех строк общий правый край,
                       и крестик стоит на месте, как бы ни менялись цифры внутри. -->
                  <Border Margin="0,0,0,6" HorizontalAlignment="Stretch">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Style.Card}">
                        <Setter Property="Padding" Value="12,10"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Waiting">
                            <Setter Property="Padding" Value="12,6"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>

                      <!-- Иконка в рамке фиксированного размера и Uniform, а не UniformToFill:
                           заполнение по большей стороне вылезало за колонку и срезало картинку
                           по краю карточки. Uniform вписывает целиком, ClipToBounds страхует
                           от нестандартных пропорций. У ожидающей строки — меньше. -->
                      <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                              Margin="0,0,12,0" CornerRadius="6"
                              VerticalAlignment="Center" ClipToBounds="True"
                              Background="{DynamicResource Brush.Surface2}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="36"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding State}" Value="Waiting">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Image Stretch="Uniform" ui:CoverImage.Url="{Binding IconUrl}"
                               ImageFailed="CoverImg_ImageFailed"/>
                      </Border>

                      <!-- Название и процент вплотную друг к другу. Порознь — по краям
                           карточки — на широком экране между ними полтора метра пустоты,
                           и глазу приходилось проходить весь монитор, чтобы связать одно
                           с другим. -->
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   Text="{Binding Converter={StaticResource QueueItemPercentTextConv}, Mode=OneWay}"/>
                      </StackPanel>

                      <!-- Вторая строка слева — стадия: «Моды · Скачивание обновления…» у
                           качающейся, место в очереди у ожидающей. -->
                      <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,12,0" FontSize="11"
                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                 Text="{Binding Converter={StaticResource QueueItemStatusConv}, Mode=OneWay}"
                                 Foreground="{DynamicResource Brush.TextSecondary}"/>

                      <!-- Цифры — своей колонкой у правого края: объём сверху, скорость и
                           остаток под ним. Строка занимает всю ширину панели, и держать их
                           в хвосте стадии значило оставить всю правую половину карточки
                           пустой. Здесь они дают вторую точку опоры взгляду: слева — что
                           качается, справа — сколько осталось. -->
                      <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,12,0"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  Visibility="{Binding State, Converter={StaticResource QueueItemStateVisibilityConv}, ConverterParameter=Running}">
                        <TextBlock FontSize="12" TextWrapping="NoWrap" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Text="{Binding Converter={StaticResource QueueItemSizeConv}, Mode=OneWay}"/>
                        <TextBlock FontSize="11" TextWrapping="NoWrap" HorizontalAlignment="Right" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding Converter={StaticResource QueueItemSpeedConv}, Mode=OneWay}"/>
                      </StackPanel>

                      <!-- Стрелки порядка — только для ожидающих позиций. IsEnabled привязан к
                           признакам из очереди: стрелка, которую видно и можно нажать, но которая
                           ничего не делает, читается как сломанная. -->
                      <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                  Visibility="{Binding State, Converter={StaticResource QueueItemStateVisibilityConv}, ConverterParameter=Waiting}">
                        <!-- 32px, а не 26: кнопки в очереди — самые мелкие цели в приложении,
                             и в них промахивались. Значок остался мелким, выросла зона клика. -->
                        <Button Width="32" Height="32" Padding="0" Margin="0,0,2,0"
                                ToolTip="Поднять в очереди. Если выше идёт закачка — начать эту вместо неё"
                                IsEnabled="{Binding CanMoveUp}"
                                Style="{StaticResource Style.Button.QueueIcon}"
                                Click="MoveQueueItemUp_Click" CommandParameter="{Binding}">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" FontSize="12" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTip="Опустить в очереди"
                                IsEnabled="{Binding CanMoveDown}"
                                Style="{StaticResource Style.Button.QueueIcon}"
                                Click="MoveQueueItemDown_Click" CommandParameter="{Binding}">
                          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Center"/>
                        </Button>
                      </StackPanel>

                      <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Width="32" Height="32" Padding="0"
                              Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Снять с очереди"
                              Style="{StaticResource Style.Button.QueueIcon.Danger}"
                              Click="CancelQueueItem_Click" CommandParameter="{Binding}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" HorizontalAlignment="Center"/>
                      </Button>

                      <!-- Полоса — во всю ширину карточки под всем остальным: здесь ширина
                           работает на точность, а не разносит связанные подписи по углам. -->
                      <ProgressBar Grid.Row="2" Grid.ColumnSpan="5" Height="4" Margin="0,10,0,0"
                                   Style="{StaticResource Style.ProgressBar.Rounded}"
                                   Value="{Binding Converter={StaticResource QueueItemPercentConv}, Mode=OneWay}"
                                   IsIndeterminate="{Binding Converter={StaticResource QueueItemIndeterminateConv}, Mode=OneWay}"
                                   Visibility="{Binding State, Converter={StaticResource QueueItemStateVisibilityConv}, ConverterParameter=Running}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Раскрывашка: очередь длиннее, чем помещается в свёрнутый док. Кнопка-ссылка,
                 а не скролл: скролл внутри дока не виден, пока в него не ткнуть, и очередь
                 из четырёх позиций выглядела как очередь из двух с половиной. -->
            <Button x:Name="QueueMoreBtn" Click="QueueMoreBtn_Click" Visibility="Collapsed"
                    HorizontalAlignment="Left" Margin="0,2,0,0" Padding="0"
                    Style="{DynamicResource Style.Button.Link}"/>
          </StackPanel>

          <!-- Покой: очередь пуста, показываем ход работы по выбранной игре. Строки не
               держат фиксированную высоту: пустая строка теперь не занимает места, а
               полоса появляется только когда есть чему идти. -->
          <StackPanel x:Name="IdleStatusPanel" VerticalAlignment="Center">
            <TextBlock Name="StatusText" Text="Готово" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"
                         Style="{StaticResource Style.ProgressBar.Rounded}"/>
            <TextBlock Name="SpeedEtaText" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,6,0,0"/>
            <TextBlock Name="FilesSizeText" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Toast overlay (non-intrusive notifications) -->
    <Grid x:Name="ToastHost" Grid.RowSpan="4" IsHitTestVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
      <Border x:Name="Toast"
              Visibility="Collapsed"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12"
              Effect="{x:Null}">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.Text}"/>
      </Border>
    </Grid>

    <!-- Модальная форма обратной связи. RowSpan на все четыре строки корневого Grid:
         затемнение обязано накрыть и шапку, и ленту, иначе сквозь «модальное» окно
         остаются нажимаемыми кнопки под ним. -->
    <Grid x:Name="FeedbackOverlay" Visibility="Collapsed" Background="#C0000000"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.RowSpan="4">
      <Grid.Resources>
        <!-- Сами поля формы одеты общим стилем из темы (Style.TextBox.Field): штатный
             TextBox рисует прямой угол, ничем не отмечает фокус и не умеет подсказки.
             Здесь остаётся только подпись над полем. -->
        <Style x:Key="Style.Fb.Label" TargetType="TextBlock">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
          <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
      </Grid.Resources>

      <!-- Тень: отдельный слой на 6px ниже карточки, а не Effect на ней. Размытие поверх
           содержимого делает текст мыльным, поэтому карточка остаётся без эффектов. -->
      <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,40,0,34"
              CornerRadius="12" Background="#000000" Opacity="0.22"
              SnapsToDevicePixels="True" UseLayoutRounding="True"/>

      <!-- Карточка. VerticalAlignment=Stretch + Margin ограничивают её высотой окна: при
           Center высота не ограничена ничем, и поле сообщения убегало за нижний край экрана. -->
      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderHover}" BorderThickness="1" CornerRadius="10"
              Padding="20" Width="720" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,40,0,40"
              SnapsToDevicePixels="True" UseLayoutRounding="True"
              TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display"
              TextOptions.TextHintingMode="Fixed"
              RenderOptions.ClearTypeHint="Enabled">
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True"
              TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed">
          <Grid.RowDefinitions>
            <!-- шапка -->
            <RowDefinition Height="Auto"/>
            <!-- имя, контакт, тип -->
            <RowDefinition Height="Auto"/>
            <!-- подпись «Сообщение» -->
            <RowDefinition Height="Auto"/>
            <!-- поле сообщения — единственное, что растёт вместе с окном -->
            <RowDefinition Height="*"/>
            <!-- статус и кнопки -->
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Три равные колонки под короткие поля и два промежутка по 16px между ними.
               Промежуток — отдельной колонкой, а не отступом у полей: с отступами крайнее
               поле получалось на 16px шире соседей, потому что справа от него отступа нет.
               Форма при этом не растягивается на пол-экрана из-за трёх строк по одному
               полю, а ширина карточки фиксирована (720 при MinWidth окна 980), так что
               колонки не схлопываются. -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Шапка: заголовок и крестик. Оба занимают всю ширину строки, поэтому у
               заголовка правый отступ — иначе длинный заголовок уехал бы под крестик. -->
          <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="Обратная связь"
                     Style="{DynamicResource Style.PageTitle}" Margin="0,0,36,0"/>
          <Button Grid.Row="0" Grid.ColumnSpan="5" Content="✕" Width="28" Height="28"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Padding="0"
                  Style="{DynamicResource Style.Button.GhostNeutral}"
                  ToolTip="Закрыть" Click="FbCancel_Click"/>

          <!-- Имя -->
          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,20,0,0">
            <TextBlock Text="Имя" Style="{StaticResource Style.Fb.Label}"/>
            <TextBox x:Name="FbName" ui:Placeholder.Text="Ваше имя"
                     Style="{DynamicResource Style.TextBox.Field}" TextChanged="FbField_Changed"/>
          </StackPanel>

          <!-- Контакт -->
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,20,0,0">
            <TextBlock Text="Контакт" Style="{StaticResource Style.Fb.Label}"/>
            <TextBox x:Name="FbContact" ui:Placeholder.Text="Telegram или email"
                     Style="{DynamicResource Style.TextBox.Field}" TextChanged="FbField_Changed"/>
          </StackPanel>

          <!-- Тип. Подпись сверху, как у соседей: строка «Тип: [v]» с подписью слева была
               единственным полем формы с другим устройством и ломала ритм ряда.
               Height=36 повторяет высоту полей — иначе ComboBox (MinHeight 34) стоял бы
               на два пикселя ниже соседей по ряду. -->
          <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,20,0,0">
            <TextBlock Text="Тип" Style="{StaticResource Style.Fb.Label}"/>
            <ComboBox x:Name="FbType" Margin="0" Height="36">
              <ComboBoxItem Content="Баг"/>
              <ComboBoxItem Content="Идея"/>
              <ComboBoxItem Content="Вопрос"/>
              <ComboBoxItem Content="Другое"/>
            </ComboBox>
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="Сообщение"
                     Style="{StaticResource Style.Fb.Label}" Margin="0,20,0,6"/>

          <!-- Строка "*": карточка ограничена высотой окна, и поле обязано СЖИМАТЬСЯ вместе
               с ней, а не тащить за собой фиксированную высоту — именно это обрезало поле
               снизу на невысоких окнах. Длинный текст прокручивается внутри поля. -->
          <TextBox x:Name="FbComment" Grid.Row="3" Grid.ColumnSpan="5"
                   ui:Placeholder.Text="Опишите проблему или идею"
                   Style="{DynamicResource Style.TextBox.Field.Multiline}" TextChanged="FbField_Changed"/>

          <Grid Grid.Row="4" Grid.ColumnSpan="5" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Статус — в своей колонке, а не в одном ряду с кнопками: длинная строка
                 («Лимит ручных отправок исчерпан. Повторите через ~N мин.») сдвигала
                 кнопки влево, и «Отправить» переставала быть крайней правой. -->
            <TextBlock x:Name="FbStatus" Grid.Column="0" VerticalAlignment="Center"
                       Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Отмена" Width="120" Height="36" FontSize="13" FontWeight="SemiBold"
                      Margin="0,0,8,0" Click="FbCancel_Click" Style="{DynamicResource Style.Button.GhostNeutral}"/>
              <!-- Главная кнопка — правая, крайняя: так стоят кнопки во всех диалогах Windows -->
              <Button x:Name="FbSendBtn" Content="Отправить" Margin="0" Click="FbSend_Click"
                      Style="{DynamicResource Style.Button.Primary}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>

