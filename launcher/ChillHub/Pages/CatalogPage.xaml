<Page x:Class="ChillHub.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог"
      Background="{DynamicResource Brush.Background}">
    <ScrollViewer>
      <StackPanel Margin="16">
        <TextBlock Text="Каталог игр" FontSize="18" Margin="0,0,0,12"/>
        <ItemsControl Name="GamesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="16" Width="240" Foreground="{DynamicResource Brush.Text}"/>
                  <TextBlock Text="{Binding LatestVersion}" Width="160" Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <Button Content="Обновить" Width="100" Margin="8,0,0,0"/>
                  <Button Content="Играть" Width="100" Margin="8,0,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
</Page>
