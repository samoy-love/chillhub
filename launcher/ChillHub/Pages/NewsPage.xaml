<Page x:Class="ChillHub.Pages.NewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Новости"
      Background="{DynamicResource Brush.Background}">
  <ScrollViewer>
    <StackPanel Margin="16">
      <TextBlock Text="Новости" FontSize="18" Margin="0,0,0,12"/>
      <ItemsControl Name="NewsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource Style.Card}" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,6"/>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
