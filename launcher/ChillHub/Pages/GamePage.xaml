<Page x:Class="ChillHub.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Игра"
      Background="{DynamicResource Brush.Background}">
  <Page.Resources>
    <!-- Прогресс-бар в стиле главной страницы -->
    <SolidColorBrush x:Key="Brush.ProgressBorder" Color="#2B1F4A"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#1A122B"/>
    <LinearGradientBrush x:Key="Brush.GameAccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#3A2966"/>
      <GradientStop Offset="1" Color="#8A2A4A"/>
    </LinearGradientBrush>

    <Style x:Key="Style.ProgressBar.Game" TargetType="ProgressBar">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track" CornerRadius="6" BorderThickness="2.5"
                      Background="{DynamicResource Brush.ProgressTrack}" BorderBrush="{DynamicResource Brush.ProgressBorder}"/>
              <Border x:Name="PART_Indicator" CornerRadius="6" Background="{StaticResource Brush.GameAccentGradient}"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Нейтральная кнопка (быстрые действия, «Назад») -->
    <Style x:Key="Style.Button.GameGhost" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Основная кнопка действия (Установить/Обновить/Отмена) -->
    <Style x:Key="Style.Button.GamePrimary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Brush.GameAccentGradient}"/>
      <Setter Property="Foreground" Value="#FFEAF1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Подпись поля в карточке сведений -->
    <Style x:Key="Style.FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Style.FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,16,12"/>
    </Style>
    <Style x:Key="Style.SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <!-- Карточка в списке changelog. Свой стиль, а не общий из HomePage:
         Style.ListBoxItem.SelectableCard объявлен в ресурсах HomePage и снаружи недоступен. -->
    <Style x:Key="Style.ListBoxItem.ChangelogCard" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" CornerRadius="10" BorderThickness="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1.2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Style.NetStep" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Page.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Шапка: назад + обложка + название + состояние -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Name="BackBtn" Content="Назад" Width="100" Height="32"
              Style="{StaticResource Style.Button.GameGhost}" Click="BackBtn_Click" VerticalAlignment="Top"/>
      <Border Grid.Column="1" Width="64" Height="64" Margin="16,0,0,0" CornerRadius="8"
              Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
        <Grid>
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="26"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Name="GameIcon" Stretch="UniformToFill"
                 Loaded="CoverImg_Loaded" ImageFailed="CoverImg_ImageFailed"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Name="TitleText" Text="Игра" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Title}" TextTrimming="CharacterEllipsis"/>
        <Border Name="StateBadge" CornerRadius="10" Padding="10,3" Margin="0,6,0,0"
                HorizontalAlignment="Left"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <TextBlock Name="StateText" Text="Состояние неизвестно" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
        </Border>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: сведения, действия, версии -->
        <StackPanel Grid.Column="0">

          <!-- Сведения об установке -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Сведения" Style="{StaticResource Style.SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="Установленная версия" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="InstalledVersionText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBlock Text="Доступная версия" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="LatestVersionText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="Размер на диске" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="SizeOnDiskText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <TextBlock Text="Свободно на диске" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="FreeSpaceText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                  <TextBlock Text="Место установки" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="InstallPathText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Действия и прогресс -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Действия" Style="{StaticResource Style.SectionHeader}"/>
              <!-- Кнопки «Играть» здесь нет намеренно: запуск игры остаётся на главной странице -->
              <WrapPanel>
                <Button Name="ActionBtn" Content="Установить" MinWidth="180" Height="40" Margin="0,0,8,8"
                        Style="{StaticResource Style.Button.GamePrimary}" Click="ActionBtn_Click"/>
                <Button Name="OpenFolderBtn" Content="Открыть папку игры" MinWidth="170" Height="40" Margin="0,0,8,8"
                        Style="{StaticResource Style.Button.GameGhost}" Click="OpenFolderBtn_Click"/>
                <Button Name="OpenLogsBtn" Content="Открыть логи" MinWidth="140" Height="40" Margin="0,0,0,8"
                        Style="{StaticResource Style.Button.GameGhost}" Click="OpenLogsBtn_Click"/>
              </WrapPanel>
              <TextBlock Name="StatusText" Text="Готов" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0"
                         TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
              <ProgressBar Name="SyncProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"
                           Style="{StaticResource Style.ProgressBar.Game}"/>
              <TextBlock Name="SpeedEtaText" Text="" FontSize="12" Margin="0,6,0,0"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
              <TextBlock Name="FilesSizeText" Text="" FontSize="12"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
          </Border>

          <!-- Модпак-профиль: первая итерация — только папка модов и доп. аргументы запуска -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Модпак-профиль" Style="{StaticResource Style.SectionHeader}"/>
              <TextBlock Text="Выбранный профиль применяется при следующем запуске игры с главной страницы."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
              <ComboBox Name="ModProfileCombo" Width="260" Height="30" HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="Name"
                        SelectionChanged="ModProfileCombo_SelectionChanged"/>
            </StackPanel>
          </Border>

          <!-- Наигранное время -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Наигранное время" Style="{StaticResource Style.SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Всего" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="TotalPlaytimeText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Последняя сессия" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="LastSessionText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Версии сборки: установка конкретной версии / откат -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Версии сборки" Style="{StaticResource Style.SectionHeader}"/>
              <TextBlock Text="Здесь можно вернуться на предыдущую сборку. Это не обновление, а переключение версии: файлы будут приведены к состоянию выбранной сборки, часть контента может пропасть."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Name="BuildsCombo" Width="220" Height="30" VerticalContentAlignment="Center"
                          SelectionChanged="BuildsCombo_SelectionChanged"/>
                <Button Name="SwitchVersionBtn" Content="Установить выбранную версию" MinWidth="220" Height="30"
                        Margin="8,0,0,0" IsEnabled="False"
                        Style="{StaticResource Style.Button.GameGhost}" Click="SwitchVersionBtn_Click"/>
              </StackPanel>
              <TextBlock Name="VersionHintText" Text="" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
          </Border>

          <!-- Игра по сети -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Игра по сети" Style="{StaticResource Style.SectionHeader}" Margin="0,0,0,10"/>

              <TextBlock Text="Как подключиться" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                         Foreground="{DynamicResource Brush.Text}"/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="1. Убедитесь, что у вас и у остальных игроков установлена одна и та же версия сборки — номер видно выше в разделе «Сведения»."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="2. Запустите игру с главной страницы лаунчера и дождитесь главного меню."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="3. Откройте раздел сетевой игры и выберите подключение к серверу по адресу, который дал хост (формат «адрес:порт»)."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="4. Если играете по локальной сети — используйте локальный адрес хоста; если через интернет — внешний адрес и проброшенный порт."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="5. Хосту нужно один раз разрешить игру в брандмауэре Windows (сети «Частная» и «Публичная»)."/>

              <TextBlock Text="Если не подключается — проверьте по порядку" FontWeight="SemiBold" FontSize="13"
                         Margin="0,10,0,6" Foreground="{DynamicResource Brush.Text}"/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• Версия сборки. Разные версии у клиента и хоста — самая частая причина отказа подключения. Сверьте номера и при необходимости выровняйте версию в разделе «Версии сборки»."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• Порт. Порт по умолчанию должен быть открыт на роутере хоста (проброс портов, TCP и/или UDP — зависит от игры) и не занят другой программой."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• Брандмауэр и антивирус. Правило для исполняемого файла игры должно разрешать входящие и исходящие соединения. Сторонний антивирус иногда блокирует игру молча."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• Целостность файлов. Нажмите «Обновить» на этой странице: лаунчер сверит файлы с сервером и докачает повреждённые."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• Незавершённое обновление. Если сверху написано «Обновление не завершено» — сначала доведите обновление до конца, по сети такая сборка работать не будет."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• VPN и прокси. Отключите их на время проверки: они часто ломают обнаружение серверов в локальной сети."/>
              <TextBlock Style="{StaticResource Style.NetStep}" Text="• Логи. Кнопка «Открыть логи» — оттуда удобно приложить файл к сообщению в обратной связи."/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА: changelog (новости игры) -->
        <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="16" VerticalAlignment="Stretch">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="История изменений" Style="{StaticResource Style.SectionHeader}" Margin="0"/>
                <TextBlock Text="Новости и списки изменений этой игры" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
              </StackPanel>
              <Button Grid.Column="1" Name="RefreshChangelogBtn" Width="32" Height="32"
                      Style="{StaticResource Style.Button.GameGhost}" Padding="0"
                      ToolTip="Обновить историю изменений" Click="RefreshChangelog_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </Grid>
            <Grid Grid.Row="1" MinHeight="240">
              <TextBlock Name="ChangelogEmptyText" Text="Записей пока нет" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                         TextAlignment="Center"/>
              <ListBox Name="ChangelogList" Background="Transparent" BorderThickness="0"
                       SelectionChanged="ChangelogList_SelectionChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListBoxItem.ChangelogCard}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch"
                            BorderThickness="0" Background="Transparent">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,2,0,6"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                                   FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="51"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
