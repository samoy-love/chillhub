<Page x:Class="ChillHub.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Игра"
      Background="{DynamicResource Brush.Background}">
  <Page.Resources>
    <!-- Цвета берём из темы, а не из локальных копий. Здесь лежал собственный набор
         старой палитры — розово-фиолетовый градиент кнопки и толстая полоса прогресса,
         из-за которых страница игры выглядела приложением из другого проекта. -->
    <SolidColorBrush x:Key="Brush.ProgressBorder" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="{DynamicResource Color.Track}"/>
    <SolidColorBrush x:Key="Brush.GameAccentGradient" Color="{DynamicResource Color.Accent}"/>

    <Style x:Key="Style.ProgressBar.Game" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track" CornerRadius="2" BorderThickness="0"
                      Background="{DynamicResource Brush.ProgressTrack}"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource Brush.Accent}"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Основная кнопка действия (Установить/Обновить/Отмена) -->
    <Style x:Key="Style.Button.GamePrimary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <!-- Тёмный текст на акценте — как у кнопки действия на витрине. Светло-розовый
           на градиенте давал контраст ниже читаемого. -->
      <Setter Property="Foreground" Value="#0C0C10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Подпись поля в карточке сведений -->
    <Style x:Key="Style.FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Style.FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,16,12"/>
    </Style>
    <Style x:Key="Style.SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Title}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <!-- Карточка в списке changelog. Свой стиль, а не общий из HomePage:
         Style.ListBoxItem.SelectableCard объявлен в ресурсах HomePage и снаружи недоступен. -->
    <Style x:Key="Style.ListBoxItem.ChangelogCard" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
                
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Page.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Шапка: назад + обложка + название + состояние -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <!-- Всё в шапке центрируется по вертикали относительно обложки: раньше «Назад»
           висел по верху, а заголовок с чипом — по центру, и шапка выглядела рыхлой. -->
      <Button Grid.Column="0" Name="BackBtn" Style="{DynamicResource Style.Button.Back}"
              Click="BackBtn_Click" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Width="64" Height="64" Margin="16,0,0,0" CornerRadius="8"
              Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
        <Grid>
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;" FontSize="26"
                     Foreground="{DynamicResource Brush.TextSecondary}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Name="GameIcon" Stretch="UniformToFill"
                 Loaded="CoverImg_Loaded" ImageFailed="CoverImg_ImageFailed"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Name="TitleText" Text="Игра" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Title}" TextTrimming="CharacterEllipsis"/>
        <Border Name="StateBadge" CornerRadius="6" Padding="8,3" Margin="0,6,0,0"
                HorizontalAlignment="Left"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
          <TextBlock Name="StateText" Text="Состояние неизвестно" FontSize="12"
                     Foreground="{DynamicResource Brush.Text}"/>
        </Border>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: сведения, действия, версии -->
        <StackPanel Grid.Column="0">

          <!-- Сведения об установке -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Сведения" Style="{StaticResource Style.SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="Установленная версия" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="InstalledVersionText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                  <TextBlock Text="Доступная версия" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="LatestVersionText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0">
                  <TextBlock Text="Размер на диске" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="SizeOnDiskText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                  <TextBlock Text="Свободно на диске" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="FreeSpaceText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                  <TextBlock Text="Место установки" Style="{StaticResource Style.FieldLabel}"/>
                  <!-- Путь — моноширинный, в одну строку с многоточием; полный путь во
                       всплывающей подсказке. На два ряда он ложился и ломал сетку карточки. -->
                  <TextBlock Name="InstallPathText" Text="—" Style="{StaticResource Style.FieldValue}"
                             FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" Margin="0"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Действия и прогресс -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Действия" Style="{StaticResource Style.SectionHeader}"/>
              <!-- Кнопки «Играть» здесь нет намеренно: запуск игры остаётся на главной странице -->
              <!-- Основное действие — во всю ширину, вспомогательные — парой одинаковой ширины
                   под ним. WrapPanel с разными MinWidth раскладывал три кнопки как попало:
                   две в ряд и одна сиротой на второй строке. -->
              <Button Name="ActionBtn" Content="Установить" Height="40" Margin="0,0,0,8"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource Style.Button.GamePrimary}" Click="ActionBtn_Click"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="OpenFolderBtn" Content="Открыть папку игры" Height="36"
                        HorizontalAlignment="Stretch"
                        Style="{DynamicResource Style.Button.GhostNeutral}" Click="OpenFolderBtn_Click"/>
                <Button Grid.Column="2" Name="OpenLogsBtn" Content="Открыть логи" Height="36"
                        HorizontalAlignment="Stretch"
                        Style="{DynamicResource Style.Button.GhostNeutral}" Click="OpenLogsBtn_Click"/>
              </Grid>
              <!-- Строка статуса подписана: одинокое «Готов» под кнопками не читалось как
                   состояние операции. -->
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Статус" Style="{StaticResource Style.FieldLabel}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="StatusText" Text="Готов" FontWeight="SemiBold" FontSize="14"
                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
              </Grid>
              <!-- Полосу видно, только пока что-то идёт: в покое она стояла в нуле под
                   надписью «Готов» и читалась как остановившийся процесс — ровно та же
                   правка, что и в нижней панели главного экрана. -->
              <ProgressBar Name="SyncProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar" BasedOn="{StaticResource Style.ProgressBar.Game}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Value, RelativeSource={RelativeSource Self}}" Value="0"/>
                          <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource Self}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
              <TextBlock Name="SpeedEtaText" Text="" FontSize="12" Margin="0,6,0,0"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
              <TextBlock Name="FilesSizeText" Text="" FontSize="12"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
          </Border>

          <!-- Наигранное время -->
          <Border Style="{DynamicResource Style.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Наигранное время" Style="{StaticResource Style.SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Всего" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="TotalPlaytimeText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Последняя сессия" Style="{StaticResource Style.FieldLabel}"/>
                  <TextBlock Name="LastSessionText" Text="—" Style="{StaticResource Style.FieldValue}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА: changelog (новости игры) -->
        <!-- Карточка по высоте содержимого, а не растянута до низа: растянутая упиралась в
             край окна, пока левая колонка заканчивалась раньше, и низ страницы выглядел рваным. -->
        <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="16" VerticalAlignment="Top">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="История изменений" Style="{StaticResource Style.SectionHeader}" Margin="0"/>
                <TextBlock Text="Новости и списки изменений этой игры" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
              </StackPanel>
              <Button Grid.Column="1" Name="RefreshChangelogBtn" Width="28" Height="28"
                      VerticalAlignment="Top"
                      Style="{DynamicResource Style.Button.GhostNeutral}" Padding="0"
                      ToolTip="Обновить историю изменений" Click="RefreshChangelog_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </Grid>
            <Grid Grid.Row="1" MinHeight="240">
              <TextBlock Name="ChangelogEmptyText" Text="Записей пока нет" Visibility="Collapsed"
                         Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                         TextAlignment="Center"/>
              <ListBox Name="ChangelogList" Background="Transparent" BorderThickness="0"
                       SelectionChanged="ChangelogList_SelectionChanged"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.ListBoxItem.ChangelogCard}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="12" Margin="0,1,0,1" HorizontalAlignment="Stretch"
                            BorderThickness="0" Background="Transparent">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CreatedAt, Converter={StaticResource RuDateConv}}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,2,0,6"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                                   FontSize="12" LineStackingStrategy="BlockLineHeight" LineHeight="17" MaxHeight="51"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
