<Window x:Class="ChillHub.ShortcutLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chill Hub — игра не найдена" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="520" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}">
  <!-- Оформление — как у окна обновления: те же кисти и те же стили кнопок из темы.
       Системный MessageBox здесь выглядел бы чужим — это первое (а иногда и
       единственное) окно, которое человек видит, нажав на ярлык игры. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" Padding="12" CornerRadius="{DynamicResource Radius.S}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.TextSecondary}"/>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="LaunchBtn" Content="Запустить игру" MinWidth="160" Height="36" FontSize="13"
              FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" Click="LaunchBtn_Click"
              Style="{DynamicResource Style.Button.Primary}"/>
      <Button x:Name="CloseBtn" Content="Закрыть" Width="120" Height="36" FontSize="13"
              FontWeight="SemiBold" Padding="12,6" Click="CloseBtn_Click"
              Style="{DynamicResource Style.Button.GhostNeutral}"/>
    </StackPanel>
  </Grid>
</Window>
