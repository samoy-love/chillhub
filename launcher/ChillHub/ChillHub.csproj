<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RootNamespace>ChillHub</RootNamespace>
    <AssemblyName>ChillHub</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Манифест приложения: longPathAware (пути длиннее 260 символов) и asInvoker. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.31.0" />
    <PackageReference Include="Blake3" Version="2.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2420.47" />
    <!-- Roslyn analyzers (will trigger the SDK/newer analyzers warning as requested) -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100-rc.1.25451.107" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\updater\YourLauncher.Updater.csproj" />
  </ItemGroup>
  <Target Name="CopyUpdater" AfterTargets="Build">
    <PropertyGroup>
      <UpdaterExeSrc>$(MSBuildProjectDirectory)\..\..\updater\bin\$(Configuration)\net8.0\YourLauncher.Updater.exe</UpdaterExeSrc>
      <UpdaterExeDst>$(OutDir)YourLauncher.Updater.exe</UpdaterExeDst>
    </PropertyGroup>
    <Message Text="Copying YourLauncher.Updater.exe from '$(UpdaterExeSrc)' to '$(UpdaterExeDst)'" Importance="low" />
    <Copy SourceFiles="$(UpdaterExeSrc)" DestinationFiles="$(UpdaterExeDst)" SkipUnchangedFiles="true" Condition="Exists('$(UpdaterExeSrc)')" />
  </Target>
  <ItemGroup>
    <!-- Ensure WPF can load the icon via pack URI (Icon=\"Assets/app.ico\") -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ed25519Verifier намеренно internal: это деталь реализации проверки подписи.
         Но проверять её надо напрямую векторами RFC 8032, а не только через
         ManifestSignature, иначе самописная криптография остаётся непроверенной. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChillHub.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
