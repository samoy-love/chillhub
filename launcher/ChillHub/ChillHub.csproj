<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <RootNamespace>ChillHub</RootNamespace>
    <AssemblyName>ChillHub</AssemblyName>
    <!-- Имя сборки (и exe) остаётся без пробела: по нему ходят манифесты
         обновления и установщик. Пользователю же и в свойствах файла, и в
         диспетчере задач показывается название продукта — оно с пробелом. -->
    <Product>Chill Hub</Product>
    <AssemblyTitle>Chill Hub</AssemblyTitle>
    <Company>Chill Hub</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Манифест приложения: longPathAware (пути длиннее 260 символов) и asInvoker. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      ВЕРСИЯ, КОТОРУЮ ОБЪЯВЛЯЕТ ЭТОТ ИСХОДНИК. Держать на шаг ВПЕРЕДИ прода.

      Пока свойства здесь не было, обычный `dotnet build` без -p:Version давал
      дефолт .NET SDK — 1.0.0. Такой бинарь считает себя древнее всего, что
      опубликовано, и при запуске сразу уходит в окно самообновления: собрал
      локально, запустил — а лаунчер требует обновиться. Сборку установщика от
      1.0.0 спасает Resolve-AppVersion в scripts/build-installer.ps1, обычную
      сборку не спасало ничто.

      Значение — СЛЕДУЮЩАЯ версия, а не выложенная: репозиторий всегда впереди
      прода, и dev-сборка не должна считать себя устаревшей относительно latest.
      Релиз по-прежнему штампует версию явно (-p:Version), а расхождение с этим
      числом валит сборку установщика — тихо протухнуть оно не может.
    -->
    <Version>1.6.10</Version>

    <!--
      ЯЗЫКИ РЕСУРСНЫХ СБОРОК РАНТАЙМА. Self-contained публикация WPF без этого
      свойства кладёт в установку ресурсные сборки PresentationFramework,
      WinForms и прочих на тринадцать языков — cs, de, ja, zh-Hant… — то есть
      около двадцати мегабайт, которые каждый пользователь скачивает, а NSIS
      сначала полторы минуты жмёт. Своих локализованных ресурсов у лаунчера нет:
      интерфейс русский в разметке. Оставлены ru (системные диалоги WPF/WinForms
      на языке интерфейса) и en (нейтральный запас, куда рантайм откатывается).
    -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Blake3" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- Roslyn analyzers (will trigger the SDK/newer analyzers warning as requested) -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\updater\ChillHub.Updater.csproj" />
  </ItemGroup>
  <Target Name="CopyUpdater" AfterTargets="Build">
    <PropertyGroup>
      <UpdaterExeSrc>$(MSBuildProjectDirectory)\..\..\updater\bin\$(Configuration)\net8.0\ChillHub.Updater.exe</UpdaterExeSrc>
      <UpdaterExeDst>$(OutDir)ChillHub.Updater.exe</UpdaterExeDst>
    </PropertyGroup>
    <Message Text="Copying ChillHub.Updater.exe from '$(UpdaterExeSrc)' to '$(UpdaterExeDst)'" Importance="low" />
    <Copy SourceFiles="$(UpdaterExeSrc)" DestinationFiles="$(UpdaterExeDst)" SkipUnchangedFiles="true" Condition="Exists('$(UpdaterExeSrc)')" />
  </Target>
  <ItemGroup>
    <!-- Ensure WPF can load the icon via pack URI (Icon=\"Assets/app.ico\") -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ed25519Verifier намеренно internal: это деталь реализации проверки подписи.
         Но проверять её надо напрямую векторами RFC 8032, а не только через
         ManifestSignature, иначе самописная криптография остаётся непроверенной. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChillHub.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
