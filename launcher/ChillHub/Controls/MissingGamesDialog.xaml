<UserControl x:Class="ChillHub.Controls.MissingGamesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#C0000000" Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             PreviewKeyDown="Dialog_PreviewKeyDown">
  <Grid Margin="24,40">
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderHover}"
            BorderThickness="1" CornerRadius="10" MaxWidth="720" MaxHeight="620"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="20,20,20,12">
          <StackPanel Margin="0,0,36,0">
            <TextBlock x:Name="TitleText" Style="{DynamicResource Style.PageTitle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
          </StackPanel>
          <Button x:Name="CloseButton" Content="✕" Width="28" Height="28" Margin="0" Padding="0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Style="{DynamicResource Style.Button.GhostNeutral}" Click="Close_Click"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="20,0,20,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="FolderList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="8"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Padding="14" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,12,0"
                              AutomationProperties.Name="{Binding Folder.Name}"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Folder.Name}" FontSize="14" FontWeight="SemiBold"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Brush.Title}"/>
                      <TextBlock Text="{Binding Folder.Path}" FontSize="12.5" Margin="0,4,0,0"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/>
                      <TextBlock Text="{Binding Result}" FontSize="12.5" Margin="0,4,0,0"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="20,12,20,20">
          <TextBlock x:Name="WarningText" FontSize="12.5" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextSecondary}"/>
          <TextBlock x:Name="ProgressText" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text}" Visibility="Collapsed"/>
          <ProgressBar x:Name="DeletionProgress" Height="4" Margin="0,10,0,0" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterButton" MinWidth="110" Margin="0,0,8,0"
                    Style="{DynamicResource Style.Button.GhostNeutral}" Click="Close_Click"/>
            <Button x:Name="DeleteButton" MinWidth="180" Margin="0"
                    Style="{DynamicResource Style.Button.Danger}" Click="Delete_Click"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
