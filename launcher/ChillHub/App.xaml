<Application x:Class="ChillHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ChillHub.Core.UI"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Provide a safe default theme so resources like Style.Card exist at parse-time -->
                <ResourceDictionary Source="/ChillHub;component/Themes/Theme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:RuDateConverter x:Key="RuDateConv" />
            <ui:QueueItemPercentConverter x:Key="QueueItemPercentConv" />
            <ui:QueueItemIndeterminateConverter x:Key="QueueItemIndeterminateConv" />
            <ui:QueueItemStateVisibilityConverter x:Key="QueueItemStateVisibilityConv" />
            <ui:QueueItemDetailConverter x:Key="QueueItemDetailConv" />
            <ui:AspectHeightConverter x:Key="AspectHeightConv" />
            <ui:HeightShareConverter x:Key="HeightShareConv" />
            <ui:QueueItemStatusConverter x:Key="QueueItemStatusConv" />
            <ui:QueueItemPercentTextConverter x:Key="QueueItemPercentTextConv" />
            <ui:GameStatusTextConverter x:Key="GameStatusTextConv" />
            <ui:GameStatusBrushConverter x:Key="GameStatusBrushConv" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
