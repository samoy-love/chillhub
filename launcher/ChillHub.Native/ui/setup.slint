import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AuxiliaryButton } from "auxiliary.slint";
import { LocalizedTextInput } from "localized_text_input.slint";

component SetupField inherits Rectangle {
    in-out property <string> value;
    in property <string> label;
    in property <string> browse-label;
    in property <bool> enabled: true;
    callback browse();
    height: 64px;
    Text { x: 0px; y: 0px; width: parent.width; text: root.label; color: Theme.dim; font-size: 13px; height: 20px; }
    Rectangle { x: 0px; y: 24px; width: parent.width - 100px; height: 40px; background: #25242d; border-radius: 8px; border-width: 1px; border-color: Theme.border;
        LocalizedTextInput { x: 12px; y: 0px; width: parent.width - 24px; height: parent.height; text <=> root.value; enabled: root.enabled; color: Theme.ink; font-size: 14px; vertical-alignment: center; single-line: true; accessible-label: root.label; selection-background-color: Theme.accent; selection-foreground-color: Theme.bg; }
    }
    AuxiliaryButton {
        x: parent.width - 90px; y: 24px; width: 90px; height: 40px;
        text: "Обзор"; accessible-label: root.browse-label; enabled: root.enabled;
        clicked => { root.browse(); }
    }
}

component SetupToggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    height: max(34px, toggle-copy.preferred-height + 12px);
    accessible-role: checkbox; accessible-label: text; accessible-checked: checked; accessible-enabled: enabled;
    accessible-action-default => { if enabled { checked = !checked; } }
    Rectangle {
        x: 0px; y: (parent.height - 18px) / 2; width: 18px; height: 18px;
        border-radius: 4px; border-width: 1px; border-color: root.checked ? Theme.accent : #625a70;
        background: root.checked ? Theme.accent : #282530;
        if root.checked: Image { x: 2px; y: 2px; width: 14px; height: 14px; source: @image-url("assets/check.svg"); colorize: #292332; }
    }
    toggle-copy := Text { x: 30px; width: parent.width - 30px; height: parent.height; text: root.text; color: Theme.ink; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
    toggle-key := FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => { if root.enabled && (event.text == " " || event.text == Key.Return) { root.checked = !root.checked; return accept; } reject }
        TouchArea { width: parent.width; height: parent.height; enabled: root.enabled; mouse-cursor: pointer; clicked => { toggle-key.focus(); root.checked = !root.checked; } }
    }
}

export component SetupWindow inherits Window {
    init => { Palette.color-scheme = dark; window-keys.focus(); }
    forward-focus: window-keys;
    title: root.removing ? "Удаление · Chill Hub" : "Установка · Chill Hub";
    icon: @image-url("assets/brand.png");
    preferred-width: 680px; preferred-height: 560px; min-width: 560px; min-height: 480px;
    background: Theme.bg; default-font-family: "Segoe UI"; default-font-size: 14px;
    in property <bool> removing;
    in property <string> version;
    in-out property <string> install-path;
    in-out property <string> games-path;
    in-out property <bool> desktop-shortcut: true;
    in-out property <bool> delete-games: false;
    in property <string> downgrade-from;
    in-out property <bool> allow-downgrade: false;
    in property <bool> busy;
    in property <bool> picking;
    in property <bool> done;
    in property <string> message;
    in property <bool> error;
    property <bool> working: root.busy && !root.picking;
    callback submit();
    callback cancel();
    callback browse(bool);
    callback security();
    window-keys := FocusScope { width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape && !root.busy { root.cancel(); return accept; } reject }
        Image { x: 28px; y: 24px; width: 44px; height: 44px; source: @image-url("assets/brand.png"); image-fit: contain; }
        Text { x: 84px; y: 24px; height: 28px; text: "Chill Hub"; font-size: 23px; font-weight: 700; color: Theme.ink; }
        Text { x: 85px; y: 53px; height: 18px; text: "Версия " + root.version; font-size: 12px; color: Theme.dim; }
        Rectangle {
            x: 28px; y: 90px; width: parent.width - 56px;
            height: min(status-copy.y - self.y - 12px, body.preferred-height + 36px);
            background: Theme.surface; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            body-scroll := ScrollView {
                x: 20px; y: 18px; width: parent.width - 40px; height: parent.height - 36px;
                content-width: self.visible-width; content-height: body.preferred-height;
                body := VerticalLayout {
                    width: body-scroll.visible-width - 10px; spacing: 10px; alignment: start;
                    Text {
                        text: root.done ? (root.removing ? "Удаление завершено" : "Установка завершена") :
                            root.working ? (root.removing ? "Удаляем Chill Hub" : "Устанавливаем Chill Hub") :
                            root.removing ? "Удаление Chill Hub" : "Установка Chill Hub";
                        color: Theme.ink; font-size: 25px; font-weight: 650; wrap: word-wrap;
                    }
                    if (root.done || root.working) && !root.error && root.message != "": Text {
                        text: root.message;
                        color: Theme.dim; font-size: 13px; wrap: word-wrap;
                    }
                    if !root.done && !root.working: Text {
                        text: root.removing ? "Игры останутся в выбранной папке, если вы не отметите их удаление." :
                            root.downgrade-from != "" ? "Установлена более новая версия " + root.downgrade-from + ". Подтвердите её замену, чтобы продолжить." :
                            "Папки можно оставить или изменить.";
                        color: Theme.dim; font-size: 13px; wrap: word-wrap;
                    }
                    if !root.removing && !root.done && !root.working: SetupField {
                        label: "Папка лаунчера"; browse-label: "Выбрать папку лаунчера";
                        value <=> root.install-path; enabled: !root.busy; browse => { root.browse(false); }
                    }
                    if !root.removing && !root.done && !root.working: SetupField {
                        label: "Папка для игр"; browse-label: "Выбрать папку для игр";
                        value <=> root.games-path; enabled: !root.busy; browse => { root.browse(true); }
                    }
                    if root.removing && !root.done && !root.busy: Text { text: "Лаунчер\n" + root.install-path + "\n\nИгры\n" + root.games-path; color: Theme.ink; font-size: 13px; wrap: word-wrap; }
                    if !root.removing && !root.done && !root.working: SetupToggle { text: "Создать ярлык на рабочем столе"; checked <=> root.desktop-shortcut; enabled: !root.busy; }
                    if !root.removing && !root.done && !root.working && root.downgrade-from != "": SetupToggle { text: "Заменить более новую версию " + root.downgrade-from + " на " + root.version; checked <=> root.allow-downgrade; enabled: !root.busy; }
                    if root.removing && !root.done && !root.busy: SetupToggle { text: "Также удалить игры без возможности восстановления"; checked <=> root.delete-games; enabled: !root.busy; }
                    if root.removing && !root.done && !root.busy: AuxiliaryButton { text: "Управление исключениями антивируса"; enabled: !root.busy; clicked => { root.security(); } }
                    if root.working: setup-progress := Rectangle { height: 4px; background: #343039; border-radius: 2px; clip: true;
                        accessible-role: progress-indicator; accessible-label: root.removing ? "Идёт удаление" : "Идёт установка";
                        Rectangle { width: parent.width / 3; height: parent.height; background: Theme.accent; x: (animation-tick() / 1600ms - floor(animation-tick() / 1600ms)) * (parent.width + self.width) - self.width; }
                    }
                }
            }
        }
        status-copy := Text {
            x: 28px; y: parent.height - 86px - self.height; width: parent.width - 56px;
            height: self.text == "" ? 0px : min(108px, self.preferred-height);
            text: root.error ? root.message : "";
            color: #f0aaa9; font-size: 13px; wrap: word-wrap; overflow: elide; accessible-label: self.text;
        }
        if !root.done || !root.removing: AuxiliaryButton { x: 28px; y: parent.height - 66px; width: 144px; text: root.done ? "Закрыть" : "Отмена"; enabled: !root.busy; clicked => { root.cancel(); } }
        AuxiliaryButton { x: parent.width - 248px; y: parent.height - 66px; width: 220px; text: root.done ? (root.removing ? "Закрыть" : "Открыть Chill Hub") : root.busy ? "Подождите…" : root.removing ? "Удалить" : "Установить"; primary: true; enabled: !root.busy && (root.done || root.removing || root.downgrade-from == "" || root.allow-downgrade); clicked => { root.submit(); } }
    }
}
