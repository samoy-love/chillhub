// Shared by the main launcher and the small standalone helper windows.
export global Theme {
    out property <color> bg: #121215;
    out property <color> surface: #1c1c21;
    out property <color> border: #323238;
    out property <color> ink: #f6f4f7;
    out property <color> dim: #a6a3af;
    out property <color> accent: #c9bbfa;
}
