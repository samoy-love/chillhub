import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Keep keyboard selection and popup navigation without a focus-only outline.
component AuxiliaryChoice inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    property <bool> popup-open;
    property <length> choice-offset: 0px;
    property <length> menu-height: min(256px, root.model.length * 36px + 12px);
    callback selected(int);
    forward-focus: key;
    border-radius: 8px; border-width: 1px; border-color: Theme.border;
    background: touch.has-hover && root.enabled ? #302d38 : #25242d;
    accessible-role: combobox; accessible-label: "Выберите антивирус";
    accessible-value: root.model[root.current-index]; accessible-enabled: root.enabled; accessible-expanded: root.popup-open;
    accessible-action-default => { root.open(); }
    function ensure-visible() {
        let top = root.current-index * 36px;
        if top + root.choice-offset < 0px { root.choice-offset = -top; }
        else if top + 36px + root.choice-offset > root.menu-height - 12px { root.choice-offset = root.menu-height - 48px - top; }
    }
    function choose(index: int) {
        if root.enabled && root.model.length > 0 {
            root.current-index = clamp(index, 0, root.model.length - 1);
            root.ensure-visible(); root.selected(root.current-index);
        }
    }
    function open() { if root.enabled && root.model.length > 0 { popup.show(); root.popup-open = true; root.ensure-visible(); } }
    function close() { popup.close(); root.popup-open = false; key.focus(); }
    Text { x: 12px; y: 0px; width: parent.width - 42px; height: parent.height; text: root.model[root.current-index]; color: root.enabled ? Theme.ink : Theme.dim; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Path { x: parent.width - 25px; y: (parent.height - 6px) / 2; width: 11px; height: 6px; viewbox-width: 11; viewbox-height: 6; commands: "M1 1 L5.5 5 L10 1"; fill: transparent; stroke: Theme.dim; stroke-width: 1.5px; }
    key := FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.open(); return accept; }
            if event.text == Key.UpArrow { root.choose(root.current-index - 1); return accept; }
            if event.text == Key.DownArrow { root.choose(root.current-index + 1); return accept; }
            if event.text == Key.Home { root.choose(0); return accept; }
            if event.text == Key.End { root.choose(root.model.length - 1); return accept; }
            reject
        }
        touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled; mouse-cursor: pointer; clicked => { key.focus(); root.open(); } }
    }
    popup := PopupWindow { x: 0px; y: root.height + 4px; width: root.width; height: root.menu-height; close-policy: close-on-click-outside; forward-focus: popup-key;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #25222b; border-radius: 8px; border-width: 1px; border-color: #47404f; }
        popup-key := FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height;
            focus-changed-event => { root.popup-open = self.has-focus; }
            capture-key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Return { root.close(); return accept; }
                if event.text == Key.Tab { root.close(); return reject; }
                if event.text == Key.UpArrow { root.choose(root.current-index - 1); return accept; }
                if event.text == Key.DownArrow { root.choose(root.current-index + 1); return accept; }
                if event.text == Key.Home { root.choose(0); return accept; }
                if event.text == Key.End { root.choose(root.model.length - 1); return accept; }
                reject
            }
            choices := ScrollView { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px; content-width: self.width - 14px; content-height: root.model.length * 36px; content-y <=> root.choice-offset;
                for value[i] in root.model: Rectangle { x: 0px; y: i * 36px; width: choices.content-width; height: 34px; border-radius: 5px; background: root.current-index == i ? #3f374c : item-touch.has-hover ? #34303b : transparent;
                    Text { x: 10px; y: 0px; width: parent.width - 20px; height: parent.height; text: value; color: Theme.ink; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    accessible-role: button; accessible-label: value; accessible-enabled: root.enabled;
                    accessible-action-default => { root.choose(i); root.close(); }
                    item-touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.choose(i); root.close(); } }
                }
            }
        }
    }
}

component AuxiliaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 42px;
    border-radius: 10px;
    background: !enabled ? #29282e : primary ? (touch.has-hover ? #d8cdfc : Theme.accent) : touch.has-hover ? #343139 : #27252d;
    border-width: 1px;
    border-color: primary ? transparent : Theme.border;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    Text { x: 12px; y: 0px; width: parent.width - 24px; height: parent.height; text: parent.text; color: !parent.enabled ? Theme.dim : parent.primary ? #25202e : Theme.ink; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    key := FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } reject }
        touch := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled; mouse-cursor: pointer; clicked => { key.focus(); root.clicked(); } }
    }
}

export component AuxiliaryWindow inherits Window {
    init => { Palette.color-scheme = dark; }
    in property <string> window-title: "Chill Hub";
    title: root.window-title;
    icon: @image-url("assets/brand.png");
    preferred-width: 640px;
    preferred-height: 620px;
    min-width: 480px;
    min-height: 420px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    in property <string> heading: "Chill Hub";
    in property <string> subtitle;
    in property <string> status;
    in property <string> details;
    in property <string> primary-text: "Продолжить";
    in property <string> secondary-text: "Справка";
    in property <bool> primary-enabled: true;
    in property <bool> secondary-enabled: true;
    in property <bool> busy: false;
    in property <bool> progress-visible: false;
    in property <bool> can-close: true;
    in property <float> progress: 0;
    in property <[string]> provider-names;
    in-out property <int> selected-provider;
    in property <bool> provider-visible;
    callback provider-changed(int);
    callback copy-paths();
    property <length> status-height: clamp(status-text.preferred-height, 40px, 112px);
    callback primary();
    callback secondary();
    callback close-requested();
    FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height;
        key-pressed(event) => { if event.text == Key.Escape && root.can-close && !root.busy { root.close-requested(); return accept; } reject }
        Text { x: 28px; y: 25px; width: parent.width - 56px; height: 32px; text: root.heading; color: Theme.ink; font-size: 24px; font-weight: 600; overflow: elide; }
        Text { x: 28px; y: 66px; width: parent.width - 56px; height: 49px; text: root.subtitle; color: Theme.dim; font-size: 13px; wrap: word-wrap; }
        if root.provider-visible: Rectangle { x: 28px; y: 117px; width: parent.width - 56px; height: 38px;
            AuxiliaryChoice { x: 0px; y: 0px; width: parent.width - 174px; height: 36px; model: root.provider-names; current-index <=> root.selected-provider; enabled: !root.busy; selected(value) => { root.provider-changed(value); } }
            AuxiliaryButton { x: parent.width - 162px; y: 0px; width: 162px; height: 36px; text: "Копировать пути"; enabled: !root.busy; clicked => { root.copy-paths(); } }
        }
        Rectangle { x: 28px; y: root.provider-visible ? 169px : 129px; width: parent.width - 56px; height: parent.height - 218px - root.status-height - (root.provider-visible ? 40px : 0px); background: Theme.surface; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            ScrollView { x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px; content-width: self.visible-width - 16px; content-height: max(self.height, body.preferred-height);
                body := Text { x: 0px; y: 0px; width: parent.width - 16px; text: root.details; color: #ddd7e4; font-size: 14px; wrap: word-wrap; }
            }
        }
        ScrollView { x: 28px; y: parent.height - 76px - root.status-height; width: parent.width - 56px; height: root.status-height; content-width: self.visible-width - 16px; content-height: max(self.height, status-text.preferred-height);
            status-text := Text { x: 0px; y: 0px; width: parent.width - 16px; text: root.status; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
        }
        if root.progress-visible: Rectangle { x: 28px; y: parent.height - 75px; width: parent.width - 56px; height: 3px; background: #343039;
            Rectangle { x: 0px; y: 0px; width: parent.width * clamp(root.progress, 0, 1); height: parent.height; background: Theme.accent; }
        }
        AuxiliaryButton { x: 28px; y: parent.height - 60px; width: (parent.width - 68px) / 2; text: root.secondary-text; visible: root.secondary-text != ""; enabled: root.secondary-enabled && !root.busy; clicked => { root.secondary(); } }
        AuxiliaryButton { x: parent.width / 2 + 6px; y: parent.height - 60px; width: (parent.width - 68px) / 2; text: root.primary-text; primary: true; enabled: root.primary-enabled && !root.busy; clicked => { root.primary(); } }
    }
}
