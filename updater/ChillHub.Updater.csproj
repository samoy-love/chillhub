<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChillHub.Updater</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- tests/ — отдельный проект (ManifestPreserveCheck), в апдейтер не компилируется -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Хелперы Program (разбор аргументов, проверка списков, strip-prefix, уборка
         артефактов) намеренно internal: это детали реализации апдейтера. Но именно
         они решают, куда лягут файлы обновления, поэтому проверяются напрямую —
         Main и RunAsync запускают процессы и в тестах непригодны. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChillHub.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
